---
layout: layouts/base.njk
pageTitle: "Reset Password - EnglishVidya"
permalink: /reset-password/
---

<div class="auth-container" style="max-width: 500px; margin: 60px auto; padding: 35px; background: var(--bg-raised); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); border: 1px solid var(--border-color);">
  <h1 style="font-family: var(--font-heading); margin-bottom: 10px; font-size: 1.8rem; background: var(--gradient-accent); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block;">🔒 Reset Password</h1>
  
  <div id="alert-msg" class="alert-msg" style="display: none; padding: 12px; border-radius: 8px; margin-bottom: 18px; font-size: 0.9rem; font-weight: 500; text-align: left;"></div>

  <!-- Step 1: OTP Code Entry (Shown if no token in URL) -->
  <div id="otp-entry-section" style="display: flex; flex-direction: column; gap: 16px; text-align: left;">
    <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.5; margin-top: 0;">
      कृपया अपने ईमेल पर भेजा गया ६-अंकीय पासवर्ड रीसेट कोड (OTP) नीचे दर्ज करें:
    </p>
    <form id="otp-verify-form" style="display: flex; flex-direction: column; gap: 16px;">
      <div class="form-group" style="margin-bottom: 0;">
        <label style="display: block; margin-bottom: 8px; font-weight: 600; font-size: 0.9rem; color: var(--text-secondary);">Enter 6-digit OTP (६-अंकीय ओटीपी)</label>
        <input type="text" id="input-otp-code" placeholder="e.g. 123456" required maxlength="6" pattern="[0-9]{6}" style="width: 100%; padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-base); color: var(--text-main); font-size: 1.1rem; letter-spacing: 4px; text-align: center; font-weight: bold;">
      </div>
      <button type="submit" class="btn-primary" id="btn-verify-otp" style="padding: 12px; border-radius: var(--radius-sm); font-weight: bold; font-size: 1rem; cursor: pointer; background: var(--accent); color: white; border: none;">Verify Code (ओटीपी सत्यापित करें)</button>
    </form>
  </div>

  <!-- Loading State -->
  <div id="loading-section" style="display: none; text-align: center; padding: 20px 0;">
    <div style="font-size: 1.2rem; color: var(--text-secondary);">🔄 Loading security questions...</div>
  </div>

  <!-- Step 2: Security Questions & New Password Form -->
  <div id="reset-form-section" style="display: none; flex-direction: column; gap: 20px; text-align: left;">
    <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.5; margin-top: 0; padding-bottom: 10px; border-bottom: 1px solid var(--border-color);">
      ⚠️ <strong>सुरक्षा सत्यापन:</strong> कृपया नीचे दिए गए ३ प्रश्नों में से **कोई भी २ प्रश्न** चुनें और उनके सही उत्तर दें। अक्षरों के छोटे/बड़े (Case) होने और खाली स्थान (Spaces) का कोई अंतर नहीं पड़ेगा।
    </p>

    <form id="password-reset-form" style="display: flex; flex-direction: column; gap: 20px;">
      
      <!-- Questions Container -->
      <div id="questions-list-container" style="display: flex; flex-direction: column; gap: 16px;">
        <!-- Question 1 -->
        <div class="form-group question-group" id="q-group-0" style="display: none; margin-bottom: 0;">
          <label class="q-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 0.95rem; color: var(--text-main);"></label>
          <input type="text" class="q-answer-input" id="q-answer-0" placeholder="उत्तर दर्ज करें" style="width: 100%; padding: 10px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-base); color: var(--text-main); font-size: 0.95rem;">
        </div>

        <!-- Question 2 -->
        <div class="form-group question-group" id="q-group-1" style="display: none; margin-bottom: 0;">
          <label class="q-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 0.95rem; color: var(--text-main);"></label>
          <input type="text" class="q-answer-input" id="q-answer-1" placeholder="उत्तर दर्ज करें" style="width: 100%; padding: 10px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-base); color: var(--text-main); font-size: 0.95rem;">
        </div>

        <!-- Question 3 -->
        <div class="form-group question-group" id="q-group-2" style="display: none; margin-bottom: 0;">
          <label class="q-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 0.95rem; color: var(--text-main);"></label>
          <input type="text" class="q-answer-input" id="q-answer-2" placeholder="उत्तर दर्ज करें" style="width: 100%; padding: 10px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-base); color: var(--text-main); font-size: 0.95rem;">
        </div>
      </div>

      <!-- New Password -->
      <div class="form-group" style="margin-top: 10px; padding-top: 15px; border-top: 1px solid var(--border-color); margin-bottom: 0;">
        <label style="display: block; margin-bottom: 8px; font-weight: 600; font-size: 0.95rem; color: var(--text-main);">New Password (नया पासवर्ड - min 6 chars)</label>
        <input type="password" id="input-new-password" placeholder="Enter new password" required minlength="6" style="width: 100%; padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-base); color: var(--text-main); font-size: 0.95rem;">
      </div>

      <button type="submit" class="btn-primary" id="btn-save-new-password" style="padding: 12px; border-radius: var(--radius-sm); font-weight: bold; font-size: 1rem; cursor: pointer; background: var(--accent); color: white; border: none;">Reset Password (पासवर्ड अपडेट करें)</button>
    </form>

    <!-- Admin Hold Request Section -->
    <div style="margin-top: 20px; padding-top: 15px; border-top: 1px dashed var(--border-color); text-align: center;">
      <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.4; margin-top: 0;">
        क्या आप अपने सुरक्षा प्रश्नों के उत्तर भूल गए हैं? आप सीधे एडमिन को पासवर्ड रीसेट के लिए अनुरोध भेज सकते हैं।
      </p>
      <button id="btn-request-admin" style="background: none; border: 1px solid var(--error); color: var(--error); padding: 8px 14px; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 0.85rem; transition: background 0.2s;">
        Request Admin Reset (एडमिन रीसेट अनुरोध करें)
      </button>
    </div>
  </div>

  <!-- Success State -->
  <div id="success-state" style="display: none; text-align: center;">
    <div style="font-size: 3rem; margin-bottom: 15px;">🎉</div>
    <h3 style="color: var(--success); margin-bottom: 10px;">Password Reset Done!</h3>
    <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.5; margin-bottom: 24px;">
      आपका पासवर्ड सफलतापूर्वक बदल दिया गया है। अब आप नए पासवर्ड के साथ लॉगिन कर सकते हैं।
    </p>
    <a href="/login/" class="btn-primary" style="display: inline-block; padding: 10px 20px; border-radius: var(--radius-sm); font-weight: bold; text-decoration: none; background: var(--accent); color: white; border: none;">Go to Login (लॉगिन करें)</a>
  </div>

  <div style="margin-top: 30px; border-top: 1px solid var(--border-color); padding-top: 15px; font-size: 0.9rem;">
    <a href="/login/" style="color: var(--text-secondary); text-decoration: none; font-weight: 500;">← Back to Login</a>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const alertBox = document.getElementById('alert-msg');
  
  const otpEntrySection = document.getElementById('otp-entry-section');
  const loadingSection = document.getElementById('loading-section');
  const resetFormSection = document.getElementById('reset-form-section');
  const successState = document.getElementById('success-state');

  const otpVerifyForm = document.getElementById('otp-verify-form');
  const passwordResetForm = document.getElementById('password-reset-form');
  const btnRequestAdmin = document.getElementById('btn-request-admin');

  let verifiedOtpCode = '';
  let loadedQuestions = [];

  function showAlert(msg, isError = true) {
    alertBox.style.display = 'block';
    if (isError) {
      alertBox.style.backgroundColor = 'rgba(220, 38, 38, 0.1)';
      alertBox.style.borderColor = 'var(--error)';
      alertBox.style.color = 'var(--error)';
    } else {
      alertBox.style.backgroundColor = 'rgba(34, 197, 94, 0.1)';
      alertBox.style.borderColor = 'var(--success)';
      alertBox.style.color = 'var(--success)';
    }
    alertBox.textContent = msg;
  }

  // Helper to fetch security questions
  async function fetchSecurityQuestions(code) {
    otpEntrySection.style.display = 'none';
    loadingSection.style.display = 'block';
    alertBox.style.display = 'none';

    try {
      const res = await fetch(`/api/auth-reset-verify?code=${code}`);
      const data = await res.json();

      loadingSection.style.display = 'none';
      if (res.ok && data.success) {
        verifiedOtpCode = code;
        
        if (data.noSecurityQuestions) {
          // User has no security questions set, show prompt for admin reset
          showAlert(data.message || 'आपने सुरक्षा प्रश्न सेट नहीं किए हैं। कृपया नीचे दिए गए एडमिन रीसेट बटन से अनुरोध करें।');
          resetFormSection.style.display = 'flex';
          document.getElementById('password-reset-form').style.display = 'none'; // hide normal password form
        } else {
          // Render questions
          loadedQuestions = data.questions;
          loadedQuestions.forEach((q, index) => {
            const group = document.getElementById(`q-group-${index}`);
            if (group) {
              group.style.display = 'block';
              group.querySelector('.q-label').textContent = `प्रश्न ${index + 1}: ${q.question}`;
            }
          });
          resetFormSection.style.display = 'flex';
        }
      } else {
        // Show OTP screen again on failure
        otpEntrySection.style.display = 'flex';
        showAlert(data.error || 'कोड सत्यापन विफल रहा।');
      }
    } catch (e) {
      loadingSection.style.display = 'none';
      otpEntrySection.style.display = 'flex';
      showAlert('सर्वर से संपर्क करने में समस्या हुई। कृपया पुनः प्रयास करें।');
    }
  }

  // Check URL query parameters for ?code=123456
  const urlParams = new URLSearchParams(window.location.search);
  const codeParam = urlParams.get('code');
  if (codeParam && codeParam.trim().length === 6 && /^\d+$/.test(codeParam.trim())) {
    fetchSecurityQuestions(codeParam.trim());
  }

  // Handle Manual OTP verification submit
  otpVerifyForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const code = document.getElementById('input-otp-code').value.trim();
    if (code.length === 6 && /^\d+$/.test(code)) {
      fetchSecurityQuestions(code);
    } else {
      showAlert('कृपया सही ६-अंकीय कोड दर्ज करें।');
    }
  });

  // Handle Password Reset form submit
  passwordResetForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    alertBox.style.display = 'none';

    const newPassword = document.getElementById('input-new-password').value;
    if (newPassword.length < 6) return;

    // Gather answers
    const answers = [];
    loadedQuestions.forEach((q, index) => {
      const answerVal = document.getElementById(`q-answer-${index}`).value.trim();
      if (answerVal) {
        answers.push({
          question: q.question,
          answer: answerVal
        });
      }
    });

    if (answers.length < 2) {
      showAlert('कृपया कम से कम २ सुरक्षा प्रश्नों के उत्तर अवश्य दर्ज करें।');
      return;
    }

    const btn = document.getElementById('btn-save-new-password');
    btn.disabled = true;
    btn.textContent = 'Updating...';

    try {
      const res = await fetch('/api/auth-reset-verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code: verifiedOtpCode,
          answers,
          newPassword
        })
      });
      const data = await res.json();

      if (res.ok && data.success) {
        resetFormSection.style.display = 'none';
        successState.style.display = 'block';
      } else {
        showAlert(data.error || 'पासवर्ड रीसेट करने में त्रुटि हुई।');
      }
    } catch (err) {
      showAlert('नेटवर्क त्रुटि। कृपया पुनः प्रयास करें।');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Reset Password (पासवर्ड अपडेट करें)';
    }
  });

  // Handle Request Admin Reset button
  btnRequestAdmin.addEventListener('click', async () => {
    if (!confirm('क्या आप सुरक्षा प्रश्नों के उत्तर भूल गए हैं और एडमिन से रीसेट अनुरोध करना चाहते हैं?')) return;
    
    btnRequestAdmin.disabled = true;
    btnRequestAdmin.textContent = 'Submitting Request...';
    alertBox.style.display = 'none';

    try {
      const res = await fetch('/api/admin-reset-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: verifiedOtpCode })
      });
      const data = await res.json();

      if (res.ok && data.success) {
        resetFormSection.style.display = 'none';
        showAlert(data.message || 'एडमिन रीसेट अनुरोध दर्ज कर लिया गया है। ४८ घंटे की सुरक्षा अवधि के बाद ही एडमिन पासवर्ड बदल सकते हैं।', false);
      } else {
        showAlert(data.error || 'एडमिन अनुरोध दर्ज करने में त्रुटि हुई।');
        btnRequestAdmin.disabled = false;
        btnRequestAdmin.textContent = 'Request Admin Reset (एडमिन रीसेट अनुरोध करें)';
      }
    } catch (err) {
      showAlert('नेटवर्क त्रुटि। कृपया पुनः प्रयास करें।');
      btnRequestAdmin.disabled = false;
      btnRequestAdmin.textContent = 'Request Admin Reset (एडमिन रीसेट अनुरोध करें)';
    }
  });
});
</script>
