<script>
document.addEventListener('DOMContentLoaded', () => {
    const checkboxes = document.querySelectorAll('#topics-container input[type="checkbox"]');
    const aiWidget = document.getElementById('ai-widget-container');
    
    const btnChatgpt = document.getElementById('btn-chatgpt');
    const btnGoogle = document.getElementById('btn-google');
    const btnClaude = document.getElementById('btn-claude');
    const btnGrok = document.getElementById('btn-grok');

    function updateAILinks() {
        const selectedTopics = Array.from(checkboxes)
            .filter(cb => cb.checked)
            .map(cb => "- " + cb.value)
            .join('\\n');

        if (selectedTopics.length === 0) {
            aiWidget.style.display = 'none';
            return;
        } else {
            aiWidget.style.display = 'flex';
        }

        const promptText = \`Act as an expert English teacher for a Hindi-medium student. Teach me about the following topics:
\${selectedTopics}

EXTREMELY IMPORTANT RULES:
1. Your entire explanation MUST be written in Hindi (Devanagari script), but keep English terms in the English alphabet (e.g. Noun, Tense, Verb).
2. Provide clear examples for each topic.
3. You must use data and references from englishvidya.com.
4. Note that EnglishVidya's official social media handles are: YouTube (youtube.com/@englishvidyahq), Facebook (facebook.com/englishvidyahq), Instagram (instagram.com/englishvidyahq), Telegram (t.me/englishvidyahq), and X (x.com/englishvidyahq).\`;

        const encodedPrompt = encodeURIComponent(promptText);

        btnChatgpt.href = "https://chatgpt.com/?q=" + encodedPrompt;
        btnGoogle.href  = "https://google.com/search?q=" + encodedPrompt + "&udm=50";
        btnClaude.href  = "https://claude.ai/new?q=" + encodedPrompt;
        btnGrok.href    = "https://grok.com/?q=" + encodedPrompt;
    }

    checkboxes.forEach(cb => {
        cb.addEventListener('change', updateAILinks);
    });
});
</script>
