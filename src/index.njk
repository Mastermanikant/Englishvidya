<style>
/* ── HERO SECTION ── */
.hero {
    text-align: center;
    padding: 60px 20px;
    background: var(--bg-raised);
    color: var(--text-primary);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    margin-bottom: 40px;
    box-shadow: var(--shadow-md);
}

.hero h1 {
    font-size: 2.25rem;
    margin-bottom: 20px;
    line-height: 1.3;
    font-weight: 800;
}

.hero h1 span.highlight {
    color: var(--accent);
    text-shadow: 0 0 10px rgba(37, 99, 235, 0.2);
}

.hero p {
    font-size: 1.15rem;
    line-height: 1.75;
    max-width: 700px;
    margin: 0 auto 30px auto;
    color: var(--text-secondary);
}

/* ── PORTAL EXPANDABLE CARDS ── */
.portal-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin: 30px 0 40px 0;
}

@media(min-width: 768px) {
    .portal-container {
        grid-template-columns: 1fr 1fr;
    }
}

.portal-card {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    transition: all var(--duration-normal) cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
}

.portal-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent);
}

/* Header Styling (Always Visible) */
.portal-header {
    padding: var(--sp-5) var(--sp-6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    background: var(--bg-hover);
    user-select: none;
}

.portal-title-area {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.portal-badge {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--accent);
    letter-spacing: 1.5px;
}

.portal-header h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
}

.portal-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.toggle-arrow {
    font-size: 0.8rem;
    color: var(--text-secondary);
    transition: transform var(--duration-normal);
}

/* Direct Navigation Links */
.direct-link-top {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    display: none; /* Hidden by default (shown when expanded) */
    padding: 6px 12px;
    background: var(--bg-hover);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    transition: all var(--duration-fast);
}

.direct-link-top:hover {
    background: var(--accent);
    color: #000 !important;
    border-color: var(--accent);
}

.direct-link-bottom {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px var(--sp-6);
    border-top: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.01);
    transition: background var(--duration-fast);
}

.direct-link-bottom:hover {
    background: var(--bg-hover);
}

.direct-link-bottom span {
    transition: transform var(--duration-fast);
}

.direct-link-bottom:hover span {
    transform: translateX(3px);
}

/* Expanded Card Content */
.portal-content {
    padding: 0 var(--sp-6) var(--sp-6) var(--sp-6);
    display: none; /* Hidden by default */
    border-top: 1px solid var(--border);
    animation: slideDown 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.portal-content p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: var(--sp-4) 0;
}

.quick-links {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
}

@media(min-width: 480px) {
    .quick-links {
        grid-template-columns: 1fr 1fr;
    }
}

.quick-links li a {
    display: block;
    padding: 12px;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-primary);
    font-size: 0.9rem;
    font-weight: 600;
    transition: all var(--duration-fast);
}

.quick-links li a:hover {
    border-color: var(--accent);
    background: rgba(251, 191, 36, 0.04);
    transform: translateX(2px);
}

/* ── EXPANDED STATE CLASSES ── */
.portal-card.is-expanded {
    border-color: var(--accent);
    box-shadow: 0 0 15px rgba(251, 191, 36, 0.1);
}

.portal-card.is-expanded .portal-header {
    background: transparent;
}

