    transform: rotate(180deg);
    color: var(--accent);
}

.portal-card.is-expanded .direct-link-top {
    display: inline-block;
}

.portal-card.is-expanded .portal-content {
    display: block;
}

.portal-card.is-expanded .direct-link-bottom {
    display: none; /* Hide bottom link when expanded */
