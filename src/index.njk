<!-- Expand/Collapse Controller Script -->
<script>
function toggleCard(cardId, event) {
    if (event.target.tagName.toLowerCase() === 'a' || event.target.closest('a')) {
        return;
    }
    const card = document.getElementById(cardId);
    const header = card.querySelector('.portal-header');
    const wasExpanded = card.classList.contains('is-expanded');
    
    // Collapse all cards first for a clean accordion style
    document.querySelectorAll('.portal-card').forEach(c => {
        c.classList.remove('is-expanded');
        const h = c.querySelector('.portal-header');
        if (h) h.setAttribute('aria-expanded', 'false');
    });

    // Toggle the clicked card
    if (!wasExpanded) {
        card.classList.add('is-expanded');
        if (header) header.setAttribute('aria-expanded', 'true');
    }
}

// ── Word of the Day (WOTD) Deterministic Loader ──
document.addEventListener('DOMContentLoaded', async () => {
    const container = document.getElementById('wotd-container');
    if (!container) return;

    try {
        const res = await fetch('/search-index.json');
        const words = await res.json();

        if (words && words.length > 0) {
            const now = new Date();
            const seed = now.getFullYear() * 10000 + (now.getMonth() + 1) * 100 + now.getDate();
            const index = seed % words.length;
            const w = words[index];

            container.innerHTML = `
                <h3 style="margin: 0 0 6px 0; font-size: 1.4rem; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
                    ${w.word}
                    ${w.pron ? `<span style="font-size: 0.9rem; color: var(--text-secondary); font-weight: normal;">/ ${w.pron} /</span>` : ''}
                </h3>
                <p style="font-size: 1.15rem; font-weight: bold; color: var(--accent); margin: 6px 0;">
                    हिन्दी अर्थ: ${w.meaning}
                </p>
                <div style="margin-top: 14px;">
                    <a href="/dictionary/${w.slug}/" style="font-size: 0.9rem; font-weight: bold; color: var(--accent); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">
                        पूरा विवरण देखें (View Details) →
                    </a>
                </div>
            `;
        } else {
            container.innerHTML = '<p style="color: var(--text-secondary);">No words available today.</p>';
        }
    } catch (e) {
        console.error('Failed to load Word of the Day:', e);
        container.innerHTML = '<p style="color: var(--text-secondary);">Failed to load today\'s word.</p>';
    }
});
</script>
