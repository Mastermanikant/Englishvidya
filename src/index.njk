---
layout: layouts/base.njk
pageTitle: "EnglishVidya - Master Spoken English from Hindi"
metaDescription: "India's premier English learning ecosystem for Hindi-medium students. Learn grammar, spoken English, vocabulary, and interactive phonics."
permalink: /
fullWidth: true
disableBreadcrumbs: true
rawContent: true
schemaJson: |
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "English Vidya",
    "url": "https://englishvidya.com",
    "logo": "https://englishvidya.com/assets/icons/icon-192.png",
    "sameAs": [
      "{{ site.youtubeChannel }}",
      "{{ site.facebookPage }}",
      "{{ site.instagramPage }}",
      "{{ site.twitterPage }}",
      "{{ site.whatsappChannel | default('https://wa.me/917070133396') }}"
    ]
  }
---

<div class="space-y-16 sm:space-y-24 py-6 sm:py-10">

  <!-- HERO SECTION -->
  <section id="hero" class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- Left Hero Text & CTAs -->
    <div class="lg:col-span-7 space-y-6 sm:space-y-8 text-left">
      <!-- Announcement Pill -->
      <div class="inline-flex items-center gap-2 bg-gradient-to-r from-brand-500/10 via-violet-500/10 to-transparent border border-brand-500/30 px-3.5 py-1.5 rounded-full text-xs sm:text-sm text-brand-300 font-medium hover:border-brand-400/50 transition-colors cursor-pointer group">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
        </span>
        <span>NEW: AI Voice Pronunciation & Daily Quiz</span>
        <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </div>

      <!-- Main Heading -->
      <h1 class="font-heading font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.15] tracking-tight">
        Master Spoken English <br class="hidden sm:inline"/>
        <span class="text-gradient">Naturally from Hindi</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-zinc-300 max-w-2xl font-normal leading-relaxed">
        हिन्दी माध्यम के छात्रों के लिए भारत का सबसे आधुनिक इंग्लिश लर्निंग प्लेटफॉर्म। Interactive lessons, AI pronunciation helper, और daily practice modules के साथ अपनी Fluency 10x तेज बढ़ाएं।
      </p>

      <!-- Hero Action Buttons -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
        <a href="#quiz" class="bg-gradient-to-r from-brand-600 via-brand-500 to-violet-600 hover:from-brand-500 hover:to-violet-500 text-white font-semibold px-8 py-3.5 rounded-2xl text-base transition-all shadow-xl shadow-brand-500/25 hover:shadow-brand-500/40 active:scale-95 flex items-center justify-center gap-3 group">
          <span>Start Free Practice</span>
          <span class="material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform">bolt</span>
        </a>

        <a href="/grammar/" class="glass-panel hover:bg-white/5 text-zinc-200 hover:text-white font-medium px-8 py-3.5 rounded-2xl text-base transition-all border border-white/10 hover:border-white/20 flex items-center justify-center gap-2">
          <span>Explore Syllabus</span>
          <span class="material-symbols-outlined text-[20px]">menu_book</span>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="pt-4 flex items-center gap-6 border-t border-white/5 text-xs sm:text-sm text-zinc-400">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-emerald-400 text-[20px]">verified</span>
          <span>100% Free Daily Lessons</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-brand-400 text-[20px]">record_voice_over</span>
          <span>Native Accent Audio</span>
        </div>
      </div>
    </div>

    <!-- Right Hero Dynamic Interactive Flashcard Preview -->
    <div class="lg:col-span-5 relative">
      <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-brand-500 to-violet-600 opacity-30 blur-xl"></div>
      
      <div class="relative glass-panel rounded-3xl p-6 sm:p-8 border border-white/15 shadow-2xl space-y-6">
        <div class="flex items-center justify-between border-b border-white/10 pb-4">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-amber-400">lightbulb</span>
            <span class="font-heading font-semibold text-sm text-white">Daily Sentence Card</span>
          </div>
          <span class="text-xs bg-brand-500/20 text-brand-300 border border-brand-500/30 px-2.5 py-1 rounded-full font-medium">Spoken English</span>
        </div>

        <div class="bg-zinc-900/90 border border-white/10 rounded-2xl p-4 space-y-1">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400">Hindi Phrase (हिन्दी वाक्य)</span>
          <p class="text-lg font-medium text-white">"मुझे आपसे मिलकर बहुत खुशी हुई।"</p>
        </div>

        <div class="bg-gradient-to-br from-brand-950/80 to-zinc-900 border border-brand-500/30 rounded-2xl p-4 space-y-2">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-brand-400">English Translation & Phonetic</span>
          <p class="text-xl font-bold text-white tracking-wide">"I am delighted to meet you!"</p>
          <p class="text-xs text-zinc-400 font-mono">[ ahy am dih-lahy-tid too meet yoo ]</p>
        </div>

        <div class="flex items-center justify-between bg-zinc-900/80 border border-white/10 rounded-2xl px-4 py-3">
          <div class="flex items-center gap-3">
            <button id="heroPlayAudioBtn" onclick="speakText('I am delighted to meet you!')" class="w-11 h-11 rounded-xl bg-brand-600 hover:bg-brand-500 text-white flex items-center justify-center transition-transform active:scale-90 shadow-md shadow-brand-600/40">
              <span class="material-symbols-outlined text-[24px]" id="heroPlayIcon">volume_up</span>
            </button>
            <div>
              <span class="text-xs font-semibold text-white block">Listen Pronunciation</span>
              <span class="text-[11px] text-zinc-400" id="audioStatusText">Click to hear clear audio</span>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between text-xs text-zinc-400 pt-2 border-t border-white/5">
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px] text-emerald-400">check_circle</span>
            <span>Level: Beginner to Intermediate</span>
          </span>
          <span class="text-brand-400 font-semibold">1,420 Likes</span>
        </div>
      </div>
    </div>
  </section>

  <!-- WORD OF THE DAY & LATEST LESSONS DYNAMIC GRID -->
  <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Word of the Day -->
    <div class="glass-panel glass-panel-hover p-6 sm:p-8 rounded-3xl border border-white/10 space-y-4">
      <div class="flex items-center justify-between">
        <span class="font-heading font-bold text-lg text-white flex items-center gap-2">
          <span class="material-symbols-outlined text-amber-400">star</span> आज का शब्द (Word of the Day)
        </span>
        <span class="text-xs bg-amber-500/20 text-amber-300 border border-amber-500/30 px-2.5 py-0.5 rounded-full">Daily Vocab</span>
      </div>
      <div id="wotd-container" class="bg-zinc-900/80 border border-white/10 p-4 rounded-2xl">
        <p class="text-xs text-zinc-400">Loading today's word... 🔄</p>
      </div>
    </div>

    <!-- Latest Grammar Lessons (Eleventy Dynamic Collection) -->
    <div class="glass-panel glass-panel-hover p-6 sm:p-8 rounded-3xl border border-white/10 space-y-4">
      <div class="flex items-center justify-between">
        <span class="font-heading font-bold text-lg text-white flex items-center gap-2">
          <span class="material-symbols-outlined text-brand-400">new_releases</span> नवीनतम पाठ (Latest Lessons)
        </span>
        <a href="/grammar/" class="text-xs text-brand-400 hover:text-brand-300 font-medium">All Lessons →</a>
      </div>
      
      <div class="space-y-2.5">
        {% set latestLessons = collections.grammar | reverse %}
        {% set count = 0 %}
        {% for lesson in latestLessons %}
          {% if count < 3 %}
            <a href="{{ lesson.url }}" class="block p-3 rounded-2xl bg-zinc-900/80 hover:bg-white/5 border border-white/5 transition-colors">
              <div class="flex items-center justify-between text-xs font-semibold text-white">
                <span>{{ lesson.data.title or lesson.data.pageTitle or lesson.fileSlug }}</span>
                <span class="material-symbols-outlined text-[16px] text-zinc-500">arrow_forward</span>
              </div>
              <p class="text-[11px] text-zinc-400 mt-1 line-clamp-1">{{ lesson.data.metaDescription | truncate(70) }}</p>
            </a>
            {% set count = count + 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- STATS COUNTERS -->
  <section class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
    <div class="glass-panel glass-panel-hover p-6 sm:p-8 rounded-3xl text-center flex flex-col items-center justify-center border border-white/10">
      <span class="material-symbols-outlined text-brand-400 text-3xl mb-2">groups</span>
      <span class="font-heading font-extrabold text-3xl sm:text-4xl text-white mb-1 counter" data-target="1000000">0</span>
      <span class="text-xs sm:text-sm text-zinc-400 font-medium">Active Learners</span>
    </div>

    <div class="glass-panel glass-panel-hover p-6 sm:p-8 rounded-3xl text-center flex flex-col items-center justify-center border border-white/10">
      <span class="material-symbols-outlined text-violet-400 text-3xl mb-2">menu_book</span>
      <span class="font-heading font-extrabold text-3xl sm:text-4xl text-white mb-1 counter" data-target="550">0</span>
      <span class="text-xs sm:text-sm text-zinc-400 font-medium">Interactive Lessons</span>
    </div>

    <div class="glass-panel glass-panel-hover p-6 sm:p-8 rounded-3xl text-center flex flex-col items-center justify-center border border-white/10">
      <span class="material-symbols-outlined text-emerald-400 text-3xl mb-2">workspace_premium</span>
      <span class="font-heading font-extrabold text-3xl sm:text-4xl text-white mb-1 counter" data-target="98">0</span>
      <span class="text-xs sm:text-sm text-zinc-400 font-medium">Fluency Rate (%)</span>
    </div>

    <div class="glass-panel glass-panel-hover p-6 sm:p-8 rounded-3xl text-center flex flex-col items-center justify-center border border-white/10">
      <span class="material-symbols-outlined text-cyan-400 text-3xl mb-2">smart_toy</span>
      <span class="font-heading font-extrabold text-3xl sm:text-4xl text-white mb-1 counter" data-target="24">0</span>
      <span class="text-xs sm:text-sm text-zinc-400 font-medium">24/7 AI Tutor Support</span>
    </div>
  </section>

  <!-- FEATURES BENTO GRID -->
  <section id="features" class="space-y-8 sm:space-y-12">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="text-xs font-semibold uppercase tracking-wider bg-brand-500/20 text-brand-400 border border-brand-500/30 px-3 py-1 rounded-full">
        Designed for Fast Learning
      </span>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl text-white">
        Powerful Learning Features for <span class="text-gradient">Hindi Speakers</span>
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base">
        No complicated grammar rules. Learn English naturally through real-world Hindi context, visual cards, and instant speaking practice.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
      
      <!-- Tense Engine (Span 2) -->
      <div class="md:col-span-2 glass-panel glass-panel-hover p-6 sm:p-8 rounded-3xl border border-white/10 flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-brand-500/20 border border-brand-500/30 flex items-center justify-center text-brand-400">
            <span class="material-symbols-outlined text-[28px]">translate</span>
          </div>
          <h3 class="font-heading font-bold text-xl sm:text-2xl text-white">Hindi-to-English Tense Engine</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Understand English sentence structures by comparing directly with Hindi sentence patterns (Subject + Object + Verb vs Subject + Verb + Object).
          </p>
        </div>

        <div class="bg-zinc-950/80 border border-white/10 rounded-2xl p-4 space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between text-zinc-400 border-b border-white/10 pb-2">
            <span>Structure Comparison</span>
            <span class="text-brand-400 font-semibold">Present Continuous</span>
          </div>
          <div class="space-y-1 text-zinc-300">
            <p><span class="text-amber-400">Hindi:</span> वह स्कूल जा रहा है। (Subject + Object + Verb)</p>
            <p><span class="text-emerald-400">English:</span> He is going to school. (Subject + Verb + Object)</p>
          </div>
        </div>
      </div>

      <!-- AI Voice Assessment -->
      <div class="glass-panel glass-panel-hover p-6 sm:p-8 rounded-3xl border border-white/10 flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-violet-500/20 border border-violet-500/30 flex items-center justify-center text-violet-400">
            <span class="material-symbols-outlined text-[28px]">mic</span>
          </div>
          <h3 class="font-heading font-bold text-xl text-white">AI Voice Assessment</h3>
          <p class="text-zinc-400 text-sm">
            Speak into your phone mic and get instant AI scoring on accent, clarity, and pronunciation accuracy.
          </p>
        </div>

        <div class="bg-zinc-900 border border-violet-500/30 rounded-2xl p-4 text-center space-y-2">
          <div class="inline-flex items-center gap-2 bg-emerald-500/20 text-emerald-400 px-3 py-1 rounded-full text-xs font-semibold">
            <span class="material-symbols-outlined text-[16px]">check_circle</span> 96% Match
          </div>
          <p class="text-xs text-zinc-400">"Excellent accent & clarity!"</p>
        </div>
      </div>

      <!-- Habit Streak Tracker -->
      <div class="glass-panel glass-panel-hover p-6 sm:p-8 rounded-3xl border border-white/10 flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-amber-400">
            <span class="material-symbols-outlined text-[28px]">local_fire_department</span>
          </div>
          <h3 class="font-heading font-bold text-xl text-white">Habit & Streak Tracker</h3>
          <p class="text-zinc-400 text-sm">
            Build consistency with daily 10-minute micro-learning routines.
          </p>
        </div>

        <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-semibold text-zinc-400">
          <div class="bg-amber-500/20 text-amber-400 border border-amber-500/40 p-2 rounded-lg">M</div>
          <div class="bg-amber-500/20 text-amber-400 border border-amber-500/40 p-2 rounded-lg">T</div>
          <div class="bg-amber-500/20 text-amber-400 border border-amber-500/40 p-2 rounded-lg">W</div>
          <div class="bg-amber-500/20 text-amber-400 border border-amber-500/40 p-2 rounded-lg">T</div>
          <div class="bg-amber-500/20 text-amber-400 border border-amber-500/40 p-2 rounded-lg">F</div>
          <div class="bg-amber-500/20 text-amber-400 border border-amber-500/40 p-2 rounded-lg">S</div>
          <div class="bg-zinc-800 text-zinc-500 p-2 rounded-lg">S</div>
        </div>
      </div>

      <!-- Kids Track (Span 2) -->
      <div class="md:col-span-2 glass-panel glass-panel-hover p-6 sm:p-8 rounded-3xl border border-white/10 flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-cyan-500/20 border border-cyan-500/30 flex items-center justify-center text-cyan-400">
            <span class="material-symbols-outlined text-[28px]">child_care</span>
          </div>
          <h3 class="font-heading font-bold text-xl sm:text-2xl text-white">Kids Basic to Advance Track</h3>
          <p class="text-zinc-400 text-sm">
            Fun, interactive stories, audio phonics, and picture dictionary designed specifically for school kids and young learners.
          </p>
        </div>

        <div class="flex items-center gap-4 bg-zinc-900/80 border border-white/10 p-3.5 rounded-2xl">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center">
            <span class="material-symbols-outlined">auto_stories</span>
          </div>
          <div class="flex-1">
            <span class="text-xs font-semibold text-white block">Interactive Story: The Brave Lion</span>
            <span class="text-[11px] text-zinc-400">Phonics + Vocabulary + Quiz</span>
          </div>
          <a href="/flashcards/" class="bg-cyan-500 hover:bg-cyan-400 text-zinc-950 text-xs font-semibold px-3 py-1.5 rounded-xl transition-colors">
            Play
          </a>
        </div>
      </div>

      <!-- Live Leaderboard (Span 2) -->
      <div class="md:col-span-2 glass-panel glass-panel-hover p-6 sm:p-8 rounded-3xl border border-white/10 flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-pink-500/20 border border-pink-500/30 flex items-center justify-center text-pink-400">
            <span class="material-symbols-outlined text-[28px]">leaderboard</span>
          </div>
          <h3 class="font-heading font-bold text-xl text-white">Live Student Leaderboard</h3>
          <p class="text-zinc-400 text-sm">
            Compete with 1M+ learners across Bihar, UP, and all India. Earn badges and rewards every week.
          </p>
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between bg-zinc-900 px-3.5 py-2 rounded-xl text-xs border border-white/5">
            <div class="flex items-center gap-2">
              <span class="font-bold text-amber-400">#1</span>
              <span class="text-white font-medium">Aarav Sharma</span>
            </div>
            <span class="text-brand-400 font-semibold">1,240 XP</span>
          </div>
          <div class="flex items-center justify-between bg-zinc-900 px-3.5 py-2 rounded-xl text-xs border border-white/5">
            <div class="flex items-center gap-2">
              <span class="font-bold text-zinc-300">#2</span>
              <span class="text-white font-medium">Priya Kumari</span>
            </div>
            <span class="text-brand-400 font-semibold">1,180 XP</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- INTERACTIVE PRACTICE QUIZ SECTION -->
  <section id="quiz" class="glass-panel rounded-3xl p-8 sm:p-12 border border-brand-500/30 relative overflow-hidden space-y-8">
    <div class="max-w-2xl space-y-3">
      <span class="text-xs font-semibold uppercase tracking-wider bg-brand-500/20 text-brand-300 border border-brand-500/30 px-3 py-1 rounded-full">
        Live Interactive Quiz Widget
      </span>
      <h2 class="font-heading font-bold text-3xl text-white">Test Your Translation Skills Right Now</h2>
      <p class="text-zinc-400 text-sm">
        Select the correct English translation for the Hindi phrase below:
      </p>
    </div>

    <!-- Quiz Card -->
    <div class="bg-zinc-900/90 border border-white/10 rounded-2xl p-6 sm:p-8 space-y-6">
      <div class="space-y-1">
        <span class="text-xs text-brand-400 font-semibold uppercase">Question 1 of 1</span>
        <h3 class="text-xl sm:text-2xl font-bold text-white">"क्या तुम कल मेरे घर आ रहे हो?"</h3>
      </div>

      <div class="grid grid-cols-1 gap-3.5" id="quizOptionsContainer">
        <button onclick="checkAnswer(this, false)" class="quiz-btn w-full text-left p-4 rounded-xl border border-white/10 hover:border-brand-500/50 bg-zinc-800/60 text-zinc-200 text-sm font-medium transition-all flex items-center justify-between">
          <span>A) Are you come to my house tomorrow?</span>
          <span class="material-symbols-outlined opacity-0 check-icon">check_circle</span>
        </button>

        <button onclick="checkAnswer(this, true)" class="quiz-btn w-full text-left p-4 rounded-xl border border-white/10 hover:border-brand-500/50 bg-zinc-800/60 text-zinc-200 text-sm font-medium transition-all flex items-center justify-between">
          <span>B) Are you coming to my house tomorrow?</span>
          <span class="material-symbols-outlined opacity-0 check-icon">check_circle</span>
        </button>

        <button onclick="checkAnswer(this, false)" class="quiz-btn w-full text-left p-4 rounded-xl border border-white/10 hover:border-brand-500/50 bg-zinc-800/60 text-zinc-200 text-sm font-medium transition-all flex items-center justify-between">
          <span>C) Will you came to my house tomorrow?</span>
          <span class="material-symbols-outlined opacity-0 check-icon">check_circle</span>
        </button>
      </div>

      <div id="quizFeedback" class="hidden p-4 rounded-xl text-sm font-medium"></div>
    </div>
  </section>

  <!-- COURSE TRACKS -->
  <section id="curriculum" class="space-y-8 sm:space-y-12">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="text-xs font-semibold uppercase tracking-wider bg-violet-500/20 text-violet-300 border border-violet-500/30 px-3 py-1 rounded-full">
        Structured Learning Roadmaps
      </span>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl text-white">Comprehensive Course Modules</h2>
      <p class="text-zinc-400 text-sm sm:text-base">Explore complete step-by-step courses tailored for beginners, kids, and advanced speakers.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <div class="glass-panel glass-panel-hover p-6 rounded-3xl border border-white/10 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-brand-500/20 border border-brand-500/30 flex items-center justify-center text-brand-400">
            <span class="material-symbols-outlined text-[28px]">child_care</span>
          </div>
          <h3 class="font-heading font-bold text-lg text-white">Kids Basic to Advance</h3>
          <p class="text-zinc-400 text-xs leading-relaxed">
            Alphabet sounds, phonics, 500+ basic words, fruit/animal names, and story reading for kids.
          </p>
        </div>
        <div class="space-y-2 pt-4 border-t border-white/5">
          <div class="flex items-center justify-between text-xs text-zinc-400">
            <span>45 Lessons</span>
            <span class="text-brand-400 font-semibold">Free</span>
          </div>
          <a href="/grammar/" class="block text-center bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-medium py-2.5 rounded-xl transition-colors">Start Track</a>
