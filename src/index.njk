<!-- Expand/Collapse Controller Script -->
<script>
function toggleCard(cardId, event) {
    // If the click was on a link inside the header, do not toggle
    if (event.target.tagName.toLowerCase() === 'a') {
        return;
    }
    
    const card = document.getElementById(cardId);
    const wasExpanded = card.classList.contains('is-expanded');
    
    // Collapse all cards first for a clean accordion style
    document.querySelectorAll('.portal-card').forEach(c => {
        c.classList.remove('is-expanded');
    });
    
    // Toggle the clicked card
    if (!wasExpanded) {
        card.classList.add('is-expanded');
    }
}
</script>
