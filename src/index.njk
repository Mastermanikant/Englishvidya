<script>
const logicExamples = [
  {
    hindi: "हम रोज़ अंग्रेज़ी सीखते हैं।",
    formula: "Subject + Verb(s/es) + Object",
    sub: "We",
    verb: "learn",
    obj: "English every day",
    english: "We learn English every day."
  },
  {
    hindi: "गांधीजी ने सत्य और अहिंसा का मार्ग दिखाया।",
    formula: "Subject + Verb2 (Past Simple) + Object",
    sub: "Gandhiji",
    verb: "showed",
    obj: "the path of truth and non-violence",
    english: "Gandhiji showed the path of truth and non-violence."
  },
  {
    hindi: "परीक्षा की तैयारी पूरी की जा चुकी है।",
    formula: "Subject + has/have been + Verb3 (Passive)",
    sub: "The exam prep",
    verb: "has been",
    obj: "completed successfully",
    english: "The exam preparation has been completed."
  }
];

let currentExampleIndex = 0;

function setLogicExample(idx) {
  currentExampleIndex = idx;
  const ex = logicExamples[idx];
  
  // Update Tab active classes
  [0, 1, 2].forEach(i => {
    const tabEl = document.getElementById(`logic-tab-${i}`);
    if (tabEl) {
      if (i === idx) {
        tabEl.className = 'px-3.5 py-1.5 rounded-lg bg-accent text-white transition-all shadow-xs';
      } else {
        tabEl.className = 'px-3.5 py-1.5 rounded-lg text-secondary hover:text-primary transition-all';
      }
    }
  });

  // Update dynamic content
  const hindiEl = document.getElementById('logic-hindi-text');
  const formulaEl = document.getElementById('logic-formula-badge');
  const subEl = document.getElementById('block-subject');
  const verbEl = document.getElementById('block-verb');
  const objEl = document.getElementById('block-object');
  const englishEl = document.getElementById('logic-english-text');

  if (hindiEl) hindiEl.textContent = `"${ex.hindi}"`;
  if (formulaEl) formulaEl.textContent = ex.formula;
  if (subEl) subEl.textContent = ex.sub;
  if (verbEl) verbEl.textContent = ex.verb;
  if (objEl) objEl.textContent = ex.obj;
  if (englishEl) englishEl.textContent = `"${ex.english}"`;
}

function playLogicAudio() {
  const ex = logicExamples[currentExampleIndex];
  if (window.speakText) {
    window.speakText(ex.english);
  } else if ('speechSynthesis' in window) {
    const utter = new SpeechSynthesisUtterance(ex.english);
    utter.lang = 'en-US';
    window.speechSynthesis.speak(utter);
  }
}

function triggerSearchOverlay() {
  const triggerBtn = document.getElementById('search-trigger-btn');
  if (triggerBtn) {
    triggerBtn.click();
  }
}

document.addEventListener('DOMContentLoaded', () => {
  const heroSearchInput = document.getElementById('hero-interactive-search');
  if (heroSearchInput) {
    heroSearchInput.addEventListener('focus', () => {
      triggerSearchOverlay();
      const overlayInput = document.getElementById('search-input');
      if (overlayInput && heroSearchInput.value) {
        overlayInput.value = heroSearchInput.value;
      }
    });

    heroSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        triggerSearchOverlay();
      }
    });
  }
});
</script>
