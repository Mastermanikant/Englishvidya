<!-- Scripts -->
<script>
// ── Word of the Day (WOTD) Deterministic Loader ──
document.addEventListener('DOMContentLoaded', async () => {
    const container = document.getElementById('wotd-container');
    if (!container) return;

    try {
        const res = await fetch('/search-index.json');
        const words = await res.json();

        if (words && words.length > 0) {
            const now = new Date();
            const seed = now.getFullYear() * 10000 + (now.getMonth() + 1) * 100 + now.getDate();
            const index = seed % words.length;
            const w = words[index];

            container.innerHTML = `
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
                    ${window.escapeHTML(w.word)}
                    ${w.pron ? `<span class="text-lg font-normal text-gray-500 dark:text-gray-400 ml-2">/ ${window.escapeHTML(w.pron)} /</span>` : ''}
                </h3>
                <p class="text-gray-700 dark:text-gray-300 text-lg mb-6">
                    हिन्दी अर्थ: ${window.escapeHTML(w.meaning)}
                </p>
                <div class="mt-auto">
                    <a href="/dictionary/${window.escapeHTML(w.slug)}/" class="inline-block font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 transition-colors">
                        पूरा विवरण देखें (View Details) →
                    </a>
                </div>
            `;
        } else {
            container.innerHTML = '<p class="text-red-500">No words available today.</p>';
        }
    } catch (e) {
        console.error('Failed to load Word of the Day:', e);
        container.innerHTML = '<p class="text-red-500">Failed to load today\\'s word.</p>';
    }
});
</script>
