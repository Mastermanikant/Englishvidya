<style>
  .legal-container {
    max-width: 900px;
    margin: 40px auto;
    padding: 0 20px;
  }
  
  .legal-hero {
    text-align: center;
    margin-bottom: 40px;
  }
  
  .legal-hero h1 {
    font-size: 2.5rem;
    font-family: var(--font-heading);
    color: var(--accent);
    margin-bottom: 10px;
  }
  
  .legal-hero p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Language Toggle */
  .lang-controls {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 30px;
  }

  .lang-toggle {
    display: flex;
    background: var(--bg-raised);
    border-radius: var(--radius-md);
    padding: 4px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }

  .lang-btn {
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.2s;
  }

  .lang-btn.active {
    background: var(--bg-card);
    color: var(--accent);
    box-shadow: var(--shadow-sm);
    cursor: default;
  }

  .lang-btn:not(.active):hover {
    color: var(--text-primary);
  }

  /* Accordion UI */
  .legal-accordion {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
  }

  .legal-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .legal-card:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-hover);
  }

  .legal-card-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    background: var(--bg-raised);
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background 0.3s ease;
  }

  .legal-card-header:hover {
    background: rgba(var(--accent-rgb), 0.04);
  }

  .legal-card-title {
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--text-main);
    font-family: var(--font-heading);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .legal-card-icon {
    font-size: 1.1rem;
    color: var(--accent);
    transition: transform 0.3s ease;
  }

  .legal-card.active .legal-card-icon {
    transform: rotate(180deg);
  }

  .legal-card-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
  }

  .legal-card.active .legal-card-content {
    border-top: 1px solid var(--border);
  }

  .legal-card-inner {
    padding: 24px;
  }

  .rule-card {
    background: var(--bg-raised);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin-bottom: 20px;
    border: 1px solid var(--border);
  }
  
  .rule-card:last-child {
    margin-bottom: 0;
  }

  .rule-icon {
    font-size: 2rem;
    margin-bottom: 12px;
    display: inline-block;
    padding: 8px;
    background: var(--bg-base);
    border-radius: 50%;
  }

  .rule-title {
    font-size: 1.3rem;
    color: var(--text-main);
    margin-top: 0;
    margin-bottom: 10px;
    font-family: var(--font-heading);
  }

  .rule-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .rule-list li {
    position: relative;
    padding-left: 28px;
    margin-bottom: 12px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .rule-list li:last-child {
    margin-bottom: 0;
  }

  .rule-list li::before {
    content: "✅";
    position: absolute;
    left: 0;
    top: 2px;
    font-size: 0.9rem;
  }
  
  .rule-list.danger li::before {
    content: "🚫";
  }

  .rule-list.heart li::before {
    content: "❤️";
  }

  .highlight-box {
    background: rgba(var(--accent-rgb), 0.05);
    border-left: 4px solid var(--accent);
    padding: 20px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin-bottom: 24px;
  }
</style>

<div class="legal-container">
  
  <div class="lang-controls">
