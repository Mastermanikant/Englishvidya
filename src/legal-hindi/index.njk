            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- TERMS OF SERVICE CARD -->
    <div class="legal-card">
      <button class="legal-card-header" aria-expanded="false">
        <span class="legal-card-title">⚖️ कम्युनिटी के नियम</span>
        <span class="legal-card-icon">▼</span>
      </button>
      <div class="legal-card-content">
        <div class="legal-card-inner">
          <div class="highlight-box" style="border-left-color: #ff4757; background: rgba(255, 71, 87, 0.05);">
            <h3 style="margin-top:0; color: #ff4757;">कम्युनिटी के नियम</h3>
            <p style="margin:0; color: var(--text-secondary);">English Vidya एक एजुकेशनल प्लेटफार्म है। इसे साफ-सुथरा रखने के लिए कुछ सख्त नियम बनाए गए हैं।</p>
