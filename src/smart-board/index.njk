---
layout: layouts/base.njk
pageTitle: "Smart Board - EnglishVidya"
metaDescription: "Interactive digital whiteboard for teaching and learning English."
permalink: /smart-board/
---

<link rel="stylesheet" href="/css/smart-board.css">

<!-- Hide default header and footer dynamically when board launches -->
<style>
  /* Splash screen styling */
  #sb-splash {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 80vh;
    text-align: center;
  }
  #sb-splash h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
  }
  #sb-splash p {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-bottom: 30px;
  }
  #sb-start-btn {
    padding: 15px 30px;
    font-size: 1.5rem;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    transition: transform 0.2s, background 0.2s;
  }
  #sb-start-btn:hover {
    transform: scale(1.05);
    background: var(--accent-hover);
  }
  /* The main app container is hidden initially */
  #sb-app {
    display: none;
  }

  /* Fullscreen layout utilities active when board runs */
  body.board-active { margin: 0; padding: 0; overflow: hidden; height: 100vh; width: 100vw; }
  body.board-active .app-header,
  body.board-active .top-utility-bar,
  body.board-active .site-footer,
  body.board-active .bottom-nav,
  body.board-active .breadcrumb,
  body.board-active #floating-pen-fab { 
    display: none !important; 
  }
  body.board-active .app-main { padding: 0 !important; max-width: 100% !important; height: 100vh; display: flex; flex-direction: column; }
</style>

<div id="sb-splash">
  <h1>EnglishVidya Smart Board</h1>
  <p>Your interactive digital teaching canvas.</p>
  <button id="sb-start-btn">🚀 Start Smart Board</button>
</div>

<div id="sb-app">
  <!-- Top Toolbar -->
  <header id="sb-toolbar">
    <div class="sb-tool-group">
      <button class="sb-btn" id="sb-home" title="Go Home">🏠</button>
      <div class="sb-divider"></div>
      <button class="sb-btn active" id="sb-tool-select" title="Select (V)">🖱️</button>
      <button class="sb-btn" id="sb-tool-pen" title="Draw (P)">✏️</button>
      <button class="sb-btn" id="sb-tool-text" title="Text (T)">T</button>
      <label class="sb-btn sb-upload-btn" title="Insert Image">
        🖼️ <input type="file" id="sb-image-upload" accept="image/*" style="display:none;">
      </label>
      <button class="sb-btn" id="sb-tool-eraser" title="Delete Selected (Del)">🗑️</button>
    </div>
    
    <div class="sb-tool-group" id="sb-prop-panel">
      <!-- Brush Color & Size -->
      <input type="color" id="sb-color-picker" value="#ffffff" title="Color">
      <input type="range" id="sb-size-slider" min="1" max="50" value="5" title="Brush/Text Size">
    </div>

    <div class="sb-tool-group">
      <button class="sb-btn" id="sb-undo" title="Undo (Ctrl+Z)">↩️</button>
      <button class="sb-btn" id="sb-redo" title="Redo (Ctrl+Y)">↪️</button>
      <div class="sb-divider"></div>
      <button class="sb-btn" id="sb-clear" title="Clear Board">💣 Clear</button>
      <button class="sb-btn" id="sb-export-pdf" title="Export as PDF">📄 PDF</button>
      <button class="sb-btn" id="sb-fullscreen" title="Fullscreen">🔲</button>
    </div>
  </header>

  <div id="sb-workspace">
    <!-- Canvas Area -->
    <div id="sb-canvas-container">
      <canvas id="sb-canvas"></canvas>
    </div>

    <!-- Right Pages Panel -->
    <aside id="sb-pages-panel">
      <div class="sb-pages-header">
        <h3>Boards</h3>
        <button id="sb-add-page" title="New Board">➕</button>
      </div>
      <ul id="sb-pages-list">
        <!-- Pages injected by JS -->
      </ul>
    </aside>
  </div>

  <!-- Bottom Zoom Panel -->
  <footer id="sb-statusbar">
    <div class="sb-zoom-controls">
      <button class="sb-icon-btn" id="sb-zoom-out">➖</button>
      <input type="range" id="sb-zoom-slider" min="10" max="300" value="100">
      <button class="sb-icon-btn" id="sb-zoom-in">➕</button>
      <span id="sb-zoom-label">100%</span>
      <button class="sb-btn-text" id="sb-zoom-reset">Reset</button>
    </div>
    <div class="sb-status-text" id="sb-status-msg">Ready.</div>
  </footer>
</div>

<script>
  document.getElementById('sb-start-btn').addEventListener('click', () => {
    // Hide splash, show app, activate full screen body styling
    document.getElementById('sb-splash').style.display = 'none';
    document.getElementById('sb-app').style.display = 'flex';
    document.body.classList.add('board-active');

    // Attempt to go fullscreen automatically for better experience
    if (document.documentElement.requestFullscreen) {
      document.documentElement.requestFullscreen().catch(err => console.log('Fullscreen rejected.'));
    }

    // Lazy load libraries sequentially
    const scriptsToLoad = [
      '/assets/js/fabric.min.js',
      '/assets/js/jspdf.umd.min.js',
      '/assets/js/localforage.min.js',
      '/js/smart-board.js'
    ];

    function loadScript(idx) {
      if (idx >= scriptsToLoad.length) return; // All loaded
      const script = document.createElement('script');
      script.src = scriptsToLoad[idx];
      script.onload = () => loadScript(idx + 1);
      document.body.appendChild(script);
    }
    
    // Start loading
    loadScript(0);
  });
</script>
