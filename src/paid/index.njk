<style>
.paid-container {
  max-width: 650px;
  margin: 0 auto;
  padding: var(--sp-4) var(--sp-4) var(--sp-12);
}

.premium-panel {
  background: linear-gradient(135deg, rgba(22, 32, 50, 0.7), rgba(15, 23, 42, 0.8));
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(56, 189, 248, 0.2);
  border-radius: 24px;
  padding: var(--sp-6) var(--sp-8);
  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  margin-top: var(--sp-6);
  color: var(--text-primary);
}

[data-theme="light"] .premium-panel {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(248, 250, 252, 0.9));
  border: 1px solid rgba(2, 132, 199, 0.15);
  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

.premium-title {
  font-family: var(--font-heading);
  font-weight: 800;
  font-size: 2rem;
  background: linear-gradient(135deg, var(--accent, #38bdf8), #0284c7);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-align: center;
  margin-bottom: var(--sp-2);
}

.premium-subtitle {
  text-align: center;
  color: var(--text-secondary);
  font-size: 1rem;
  margin-bottom: var(--sp-6);
  line-height: 1.5;
}

.plan-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--sp-4);
  margin-bottom: var(--sp-6);
}

@media (min-width: 480px) {
  .plan-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.plan-card {
  background: rgba(30, 41, 59, 0.5);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: var(--sp-4);
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

[data-theme="light"] .plan-card {
  background: rgba(241, 245, 249, 0.6);
}

.plan-card:hover {
  transform: translateY(-2px);
  border-color: var(--accent);
  box-shadow: 0 8px 20px rgba(56, 189, 248, 0.1);
}

.plan-card.selected {
  border-color: var(--accent);
  background: rgba(56, 189, 248, 0.08);
  box-shadow: 0 8px 25px rgba(56, 189, 248, 0.15);
}

.plan-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  background: var(--accent);
  color: white;
  font-size: 0.65rem;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 10px;
  text-transform: uppercase;
}

.plan-name {
  font-weight: 700;
  font-size: 1.1rem;
  margin-bottom: var(--sp-1);
  color: var(--text-primary);
}

.plan-desc {
  font-size: 0.8rem;
  color: var(--text-tertiary);
  margin-bottom: var(--sp-3);
}

.plan-price {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--accent);
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(30, 41, 59, 0.3);
  padding: var(--sp-3) var(--sp-4);
  border-radius: 12px;
  border: 1px solid var(--border);
  margin-bottom: var(--sp-6);
}

[data-theme="light"] .setting-row {
  background: rgba(241, 245, 249, 0.4);
}

.setting-label {
  font-weight: 600;
  font-size: 0.95rem;
}

.setting-desc {
  font-size: 0.75rem;
  color: var(--text-tertiary);
  margin-top: 2px;
}

.switch {
  position: relative;
  display: inline-block;
  width: 46px;
  height: 24px;
}

.switch input { 
  opacity: 0;
  width: 0;
  height: 0;
}

.slider-round {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--border);
  transition: .3s;
  border-radius: 24px;
}

.slider-round:before {
  position: absolute;
  content: "";
  height: 18px;
  width: 18px;
  left: 3px;
  bottom: 3px;
  background-color: white;
  transition: .3s;
  border-radius: 50%;
}

input:checked + .slider-round {
  background-color: var(--accent);
}

input:checked + .slider-round:before {
  transform: translateX(22px);
}

.btn-container {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.action-submit {
  width: 100%;
  padding: var(--sp-3) var(--sp-4);
  border-radius: 12px;
  font-weight: 700;
  font-size: 1rem;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.25s ease;
}

.btn-primary-glow {
  background: linear-gradient(135deg, var(--accent, #38bdf8), #0284c7);
  color: white;
  box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);
}

.btn-primary-glow:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(56, 189, 248, 0.4);
}

.btn-secondary-glow {
  background: rgba(30, 41, 59, 0.6);
  color: var(--text-primary);
  border: 1px solid var(--border);
}

.btn-secondary-glow:hover {
  background: var(--bg-hover);
}

.active-pass-box {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(16, 185, 129, 0.05));
  border: 1px solid rgba(16, 185, 129, 0.3);
  border-radius: 16px;
  padding: var(--sp-4) var(--sp-5);
  margin-bottom: var(--sp-6);
  text-align: center;
}

.active-pass-status {
  font-weight: 700;
  color: #10b981;
  font-size: 1.1rem;
  margin-bottom: var(--sp-1);
}

.active-pass-details {
  font-size: 0.85rem;
  color: var(--text-secondary);
}
</style>

<div class="paid-container">
  <div class="premium-panel">
    <h1 class="premium-title">Ad-Free Premium Pass</h1>
    <p class="premium-subtitle">
      टीचर्स और गंभीर विद्यार्थियों के लिए विज्ञापन-मुक्त अनुभव। बिना किसी ध्यान भटकाए (distraction) फुल-स्क्रीन मोड में पढ़ें।
    </p>

    <!-- Active Pass Status -->
    <div id="active-pass-container" class="active-pass-box" style="display: none;">
      <div class="active-pass-status">✓ Premium Ad-Free Pass Active</div>
      <div id="active-pass-text" class="active-pass-details">Loading status...</div>
      <button onclick="deactivatePass()" class="action-submit btn-secondary-glow" style="margin-top: var(--sp-3); padding: var(--sp-2) var(--sp-4); font-size: 0.85rem; width: auto; margin-left: auto; margin-right: auto; height: auto;">
        Deactivate Pass (For Testing)
      </button>
    </div>

    <!-- Duration Selection -->
    <div style="font-weight: 700; font-size: 1.05rem; margin-bottom: var(--sp-3);">Choose duration:</div>
    <div class="plan-grid">
      <div class="plan-card selected" onclick="selectPlan(this, '1hr', 3600000)">
        <span class="plan-badge">Demo</span>
        <div>
          <div class="plan-name">1 Hour</div>
          <div class="plan-desc">Perfect for a study session</div>
        </div>
        <div class="plan-price">₹0 <small style="font-size:0.7rem;color:var(--text-tertiary);font-weight:normal;">(Demo)</small></div>
      </div>
      <div class="plan-card" onclick="selectPlan(this, '2hr', 7200000)">
        <span class="plan-badge">Demo</span>
        <div>
          <div class="plan-name">2 Hours</div>
          <div class="plan-desc">For longer teaching sessions</div>
        </div>
        <div class="plan-price">₹0 <small style="font-size:0.7rem;color:var(--text-tertiary);font-weight:normal;">(Demo)</small></div>
      </div>
      <div class="plan-card" onclick="selectPlan(this, '24hr', 86400000)">
        <div>
          <div class="plan-name">24 Hours</div>
          <div class="plan-desc">Full day distraction-free learning</div>
        </div>
        <div class="plan-price">₹10</div>
      </div>
      <div class="plan-card" onclick="selectPlan(this, 'monthly', 2592000000)">
        <span class="plan-badge" style="background:#f59e0b;">Best</span>
        <div>
          <div class="plan-name">Monthly Plan</div>
          <div class="plan-desc">Best value for daily educators</div>
        </div>
        <div class="plan-price">₹149/mo</div>
      </div>
    </div>

    <!-- Warning Timer Setting -->
    <div class="setting-row">
      <div>
        <div class="setting-label">1-Minute Warning Timer</div>
        <div class="setting-desc">पास समाप्त होने से 1 मिनट पहले लाल टाइमर दिखाना।</div>
      </div>
      <label class="switch">
        <input type="checkbox" id="warning-timer-toggle" checked onchange="saveWarningPreference()">
        <span class="slider-round"></span>
      </label>
    </div>

    <!-- Activation Buttons -->
    <div class="btn-container">
      <button onclick="activatePass('video')" class="action-submit btn-primary-glow">
        📺 Watch Video Ad to Activate (Demo)
      </button>
      <button onclick="activatePass('pay')" class="action-submit btn-primary-glow">
        💳 Pay & Unlock Instantly (Demo)
      </button>
    </div>
  </div>
</div>

<script>
let selectedPlanId = '1hr';
let selectedDurationMs = 3600000; // 1 hour default

function selectPlan(element, id, durationMs) {
  document.querySelectorAll('.plan-card').forEach(card => card.classList.remove('selected'));
  element.classList.add('selected');
  selectedPlanId = id;
  selectedDurationMs = durationMs;
}

function saveWarningPreference() {
  const checkbox = document.getElementById('warning-timer-toggle');
  localStorage.setItem('ev-show-warning-timer', checkbox.checked ? 'true' : 'false');
}

function updateUI() {
  const activePassContainer = document.getElementById('active-pass-container');
  const activePassText = document.getElementById('active-pass-text');
  
  const noAdsUntilStr = localStorage.getItem('ev-no-ads-until');
  const showWarningPref = localStorage.getItem('ev-show-warning-timer') !== 'false';
  
  // Set warning checkbox value
  document.getElementById('warning-timer-toggle').checked = showWarningPref;
  
  if (noAdsUntilStr) {
    const expirationTime = parseInt(noAdsUntilStr, 10);
    const now = Date.now();
    const remainingMs = expirationTime - now;
    
    if (remainingMs > 0) {
      activePassContainer.style.display = 'block';
      
      // Format remaining time readable
      let remainingStr = '';
      if (remainingMs > 3600000 * 24) {
        remainingStr = Math.ceil(remainingMs / (3600000 * 24)) + ' days';
      } else {
        const remainingHours = Math.floor(remainingMs / 3600000);
        const remainingMins = Math.round((remainingMs % 3600000) / 60000);
        remainingStr = `${remainingHours} hours, ${remainingMins} minutes`;
      }
      
      const activePlanType = localStorage.getItem('ev-active-plan-type') || '1 Hour';
      activePassText.innerHTML = `Active Plan: <strong>${activePlanType}</strong><br>Time Remaining: <strong>${remainingStr}</strong>`;
      return;
    }
  }
  
  activePassContainer.style.display = 'none';
}

function activatePass(method) {
  const now = Date.now();
  const expiresAt = now + selectedDurationMs;
  
  let planLabel = '1 Hour Pass';
  if (selectedPlanId === '2hr') planLabel = '2 Hour Pass';
  if (selectedPlanId === '24hr') planLabel = '24 Hour Pass';
  if (selectedPlanId === 'monthly') planLabel = 'Monthly Pass';
  
  localStorage.setItem('ev-no-ads-until', expiresAt.toString());
  localStorage.setItem('ev-active-plan-type', planLabel);
  
  saveWarningPreference(); // ensure preference is saved
  
  if (method === 'video') {
    if (window.showTemporaryToast) {
      window.showTemporaryToast('📺 विज्ञापन लोड हो रहा है... (Demo Video Simulation)');
      setTimeout(() => {
        window.showTemporaryToast('✨ विज्ञापन पूरा हुआ! Ad-Free Pass सक्रिय कर दिया गया है। 🚀');
        updateUI();
      }, 1500);
    } else {
      alert('Video watched! Ad-free pass activated.');
      updateUI();
    }
  } else {
    if (window.showTemporaryToast) {
      window.showTemporaryToast('💳 सुरक्षित भुगतान गेटवे खोला जा रहा है... (Demo)');
      setTimeout(() => {
        window.showTemporaryToast('✨ भुगतान सफल! Premium Ad-Free Pass सक्रिय है। 🌟');
        updateUI();
      }, 1500);
    } else {
      alert('Mock payment successful! Ad-free pass activated.');
      updateUI();
    }
  }
}

function deactivatePass() {
  localStorage.removeItem('ev-no-ads-until');
  localStorage.removeItem('ev-active-plan-type');
  if (window.showTemporaryToast) {
    window.showTemporaryToast('❌ Ad-Free Pass निष्क्रिय (deactivated) कर दिया गया है।');
  }
  updateUI();
}

// Initial UI check
document.addEventListener('DOMContentLoaded', () => {
  updateUI();
  // Keep active pass remaining time updated every 10 seconds
  setInterval(updateUI, 10000);
});
</script>
