---
layout: layouts/base.njk
pageTitle: "Student Profile & Learning Dashboard — EnglishVidya"
metaDescription: "Manage your EnglishVidya profile, review saved chapter bookmarks, track daily learning streaks, and access your vocabulary notes."
permalink: /profile/
schemaJson: |
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "name": "Student Profile",
    "description": "Personalized learning dashboard for EnglishVidya students."
  }
---

<div class="max-w-4xl mx-auto py-6 sm:py-10 px-4 sm:px-6">
  
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 1. GUEST / LOGGED-OUT PROMPT (VISIBLE WHEN NOT LOGGED IN) -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <div id="guest-banner" class="p-5 sm:p-6 rounded-2xl bg-gradient-to-r from-accent/15 via-raised to-base border border-accent/30 mb-8 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
    <div class="flex items-center gap-3.5 text-center sm:text-left">
      <div class="w-12 h-12 rounded-xl bg-accent/20 text-accent flex items-center justify-center text-2xl shrink-0">
        🎓
      </div>
      <div>
        <h2 class="text-base sm:text-lg font-bold font-heading text-primary">
          आप गेस्ट मोड (Guest Mode) में पढ़ रहे हैं
        </h2>
        <p class="text-xs text-secondary mt-0.5">
          Google से 1-क्लिक में लॉगिन करें ताकि आपके सारे नोट्स, डायरी और बुकमार्क्स क्लाउड पर सुरक्षित रहें।
        </p>
      </div>
    </div>
    <a href="/login/?redirect=/profile/" class="px-5 py-2.5 rounded-xl bg-accent text-white font-bold text-xs sm:text-sm hover:bg-accent/90 transition-all whitespace-nowrap shadow-sm hover:shadow-md inline-flex items-center gap-2">
      <span>Google से लॉगिन करें</span>
      <span>→</span>
    </a>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 2. STUDENT PROFILE HEADER CARD -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <div class="p-6 sm:p-8 rounded-3xl bg-raised border border-border mb-8 flex flex-col sm:flex-row items-center sm:items-start gap-6 shadow-xs">
    
    <!-- User Avatar -->
    <div class="relative shrink-0">
      <img src="https://ui-avatars.com/api/?name=Student&background=2563eb&color=fff&size=128" id="user-avatar" alt="Avatar" class="w-24 h-24 rounded-full border-4 border-base shadow-md object-cover">
      <span class="absolute bottom-0 right-0 w-6 h-6 bg-emerald-500 border-2 border-base rounded-full flex items-center justify-center text-white text-[10px] font-bold" title="Active">✓</span>
    </div>

    <!-- User Information -->
    <div class="flex-1 text-center sm:text-left">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1.5">
        <h1 class="text-2xl sm:text-3xl font-extrabold font-heading text-primary" id="user-name">Student Learner</h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-accent/10 text-accent border border-accent/20" id="user-role-badge">Guest Mode</span>
      </div>
      <p class="text-xs sm:text-sm text-secondary mb-4" id="user-email">guest@englishvidya.com</p>
      
      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3">
        <a href="/my-diary/" class="px-4 py-2 rounded-xl bg-base border border-border hover:border-accent text-xs font-semibold text-primary hover:text-accent transition-all flex items-center gap-1.5">
          <span>📓 माय डायरी खोलें</span>
          <span>→</span>
        </a>
        <a href="/login/?redirect=/profile/" id="profile-action-btn" class="px-4 py-2 rounded-xl bg-base border border-border hover:border-accent text-xs font-semibold text-primary hover:text-accent transition-all">
          Google लॉगिन
        </a>
      </div>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 3. LEARNING METRICS STATS GRID -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
    <div class="p-4 rounded-2xl bg-raised border border-border text-center">
      <div class="text-2xl sm:text-3xl font-extrabold font-heading text-primary" id="stat-chapters">0</div>
      <div class="text-xs text-secondary mt-1">सेव किए गए पाठ</div>
    </div>
    <div class="p-4 rounded-2xl bg-raised border border-border text-center">
      <div class="text-2xl sm:text-3xl font-extrabold font-heading text-accent" id="stat-words">0</div>
      <div class="text-xs text-secondary mt-1">डायरी शब्द नोट्स</div>
    </div>
    <div class="p-4 rounded-2xl bg-raised border border-border text-center">
      <div class="text-2xl sm:text-3xl font-extrabold font-heading text-emerald-500" id="stat-streak">1 🔥</div>
      <div class="text-xs text-secondary mt-1">डेली स्ट्रीक (Days)</div>
    </div>
    <div class="p-4 rounded-2xl bg-raised border border-border text-center">
      <div class="text-2xl sm:text-3xl font-extrabold font-heading text-primary" id="stat-class">12th / 10th</div>
      <div class="text-xs text-secondary mt-1">लर्निंग ट्रैक</div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 4. QUICK STUDY SHORTCUTS -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <div class="p-6 sm:p-8 rounded-3xl bg-raised border border-border mb-8">
    <h2 class="text-lg font-bold font-heading text-primary mb-4 flex items-center gap-2">
      <span>⚡</span> त्वरित अध्ययन शॉर्टकट्स
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a href="/class-12/" class="p-4 rounded-xl bg-base border border-border hover:border-accent group transition-all">
        <div class="font-bold text-sm text-primary group-hover:text-accent transition-colors">12वीं Rainbow 2</div>
        <div class="text-xs text-secondary mt-1">30 चैप्टर्स, उच्चारण व प्रश्न-उत्तर</div>
      </a>
      <a href="/class-10/" class="p-4 rounded-xl bg-base border border-border hover:border-accent group transition-all">
        <div class="font-bold text-sm text-primary group-hover:text-accent transition-colors">10वीं Panorama 2</div>
        <div class="text-xs text-secondary mt-1">23 चैप्टर्स, नोट्स व गाइड्स</div>
      </a>
      <a href="/grammar/" class="p-4 rounded-xl bg-base border border-border hover:border-accent group transition-all">
        <div class="font-bold text-sm text-primary group-hover:text-accent transition-colors">ग्रामर मास्टर लैडर</div>
        <div class="text-xs text-secondary mt-1">10 लेवल्स और 17 सेक्शंस</div>
      </a>
    </div>
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', async () => {
  const guestBanner = document.getElementById('guest-banner');
  const actionBtn = document.getElementById('profile-action-btn');
  const nameEl = document.getElementById('user-name');
  const emailEl = document.getElementById('user-email');
  const roleEl = document.getElementById('user-role-badge');
  const avatarEl = document.getElementById('user-avatar');

  // Load saved local stats
  try {
    const savedWords = JSON.parse(localStorage.getItem('ev_diary_words') || '[]');
    const statWords = document.getElementById('stat-words');
    if (statWords) statWords.textContent = savedWords.length;

    const savedBookmarks = JSON.parse(localStorage.getItem('ev_bookmarks') || '[]');
    const statChapters = document.getElementById('stat-chapters');
    if (statChapters) statChapters.textContent = savedBookmarks.length;
  } catch (e) {}

  // Check login state via API
  try {
    const res = await fetch('/api/auth-me?_t=' + Date.now(), { cache: 'no-store' });
    if (res.ok) {
      const data = await res.json();
      if (data.loggedIn && data.user) {
        const u = data.user;
        if (nameEl) nameEl.textContent = u.name || 'Student';
        if (emailEl) emailEl.textContent = u.email || '';
        if (roleEl) roleEl.textContent = (u.role || 'Learner').toUpperCase();
        if (avatarEl && u.avatar_url) avatarEl.src = u.avatar_url;
        
        if (guestBanner) guestBanner.style.display = 'none';
        if (actionBtn) {
          actionBtn.textContent = 'लॉगआउट';
          actionBtn.href = '/api/auth-logout';
          actionBtn.className = 'px-4 py-2 rounded-xl bg-base border border-border hover:border-rose-500/40 text-xs font-semibold text-rose-500 hover:bg-rose-500/10 transition-all';
        }
      }
    }
  } catch (err) {
    console.warn('Auth status check offline/guest:', err);
  }
});
</script>
