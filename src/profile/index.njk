  </div>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 3. LEARNING METRICS STATS GRID -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
    <div class="p-4 rounded-2xl bg-raised border border-border text-center">
      <div class="text-2xl sm:text-3xl font-extrabold font-heading text-primary" id="stat-chapters">0</div>
      <div class="text-xs text-secondary mt-1">फेवरिट शब्द (Bookmarks)</div>
    </div>
    <div class="p-4 rounded-2xl bg-raised border border-border text-center">
      <div class="text-2xl sm:text-3xl font-extrabold font-heading text-accent" id="stat-words">0</div>
      <div class="text-xs text-secondary mt-1">डायरी नोट्स (Notes)</div>
    </div>
    <div class="p-4 rounded-2xl bg-raised border border-border text-center">
      <div class="text-2xl sm:text-3xl font-extrabold font-heading text-emerald-500" id="stat-tests">0</div>
      <div class="text-xs text-secondary mt-1">दिए गए टेस्ट्स (Tests)</div>
    </div>
    <div class="p-4 rounded-2xl bg-raised border border-border text-center">
      <div class="text-2xl sm:text-3xl font-extrabold font-heading text-amber-500" id="stat-streak">1 🔥</div>
      <div class="text-xs text-secondary mt-1">डेली स्ट्रीक (Days)</div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 4. RECENT QUIZ & TEST ATTEMPTS HISTORY CARD -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <div class="p-6 sm:p-8 rounded-3xl bg-raised border border-border mb-8 shadow-xs">
    <div class="flex items-center justify-between mb-4 border-b border-border pb-3">
      <h2 class="text-lg font-bold font-heading text-primary flex items-center gap-2">
        <span>📝</span> हालिया टेस्ट एवं क्विज़ इतिहास (Test History)
      </h2>
      <a href="/test/" class="text-xs text-accent hover:underline font-semibold flex items-center gap-1">
        <span>सभी टेस्ट्स देखें</span>
        <span>→</span>
      </a>
    </div>

    <div id="profile-test-history" class="space-y-3">
      <div class="text-center py-6 text-xs text-secondary" id="test-history-empty">
        आपने अभी तक कोई टेस्ट नहीं दिया है। <a href="/test/" class="text-accent underline font-semibold">यहाँ क्लिक करके पहला टेस्ट दें!</a>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 5. QUICK STUDY SHORTCUTS -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <div class="p-6 sm:p-8 rounded-3xl bg-raised border border-border mb-8 shadow-xs">
    <h2 class="text-lg font-bold font-heading text-primary mb-4 flex items-center gap-2">
      <span>⚡</span> त्वरित अध्ययन शॉर्टकट्स (Quick Study)
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a href="/class-12/" class="p-4 rounded-2xl bg-base border border-border hover:border-accent group transition-all">
        <div class="font-bold text-sm text-primary group-hover:text-accent transition-colors">12वीं Rainbow 2</div>
        <div class="text-xs text-secondary mt-1">30 चैप्टर्स, उच्चारण व प्रश्न-उत्तर</div>
      </a>
      <a href="/class-10/" class="p-4 rounded-2xl bg-base border border-border hover:border-accent group transition-all">
        <div class="font-bold text-sm text-primary group-hover:text-accent transition-colors">10वीं Panorama 2</div>
        <div class="text-xs text-secondary mt-1">23 चैप्टर्स, नोट्स व गाइड्स</div>
      </a>
      <a href="/grammar/" class="p-4 rounded-2xl bg-base border border-border hover:border-accent group transition-all">
        <div class="font-bold text-sm text-primary group-hover:text-accent transition-colors">ग्रामर मास्टर लैडर</div>
