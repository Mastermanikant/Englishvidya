---
layout: layouts/base.njk
title: My Profile & Learning Dashboard
permalink: /profile/
---

<style>
/* Use var(--bg-raised), var(--accent), etc. */
.profile-container {
  max-width: 800px;
  margin: 2rem auto;
  padding: 1rem;
  font-family: sans-serif;
}
.glass-card {
  background: var(--bg-raised, #ffffff);
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 1rem;
  padding: 2rem;
  box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  backdrop-filter: blur(10px);
  margin-bottom: 2rem;
  text-align: center;
}
.avatar-container {
  width: 120px;
  height: 120px;
  margin: 0 auto 1rem;
  border-radius: 50%;
  padding: 4px;
  background: linear-gradient(45deg, var(--accent, #3b82f6), #8b5cf6);
}
.avatar-container img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  border: 4px solid var(--bg-raised, #ffffff);
}
.role-badge {
  display: inline-block;
  background: var(--accent, #3b82f6);
  color: #fff;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.875rem;
  font-weight: bold;
  margin-top: 0.5rem;
}
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 1rem;
  margin-top: 2rem;
}
.stat-card {
  background: var(--bg-raised, #ffffff);
  border: 1px solid var(--border, #e2e8f0);
  padding: 1rem;
  border-radius: 0.75rem;
}
.stat-value {
  font-size: 1.5rem;
  font-weight: bold;
  color: var(--accent, #3b82f6);
}
.streak-grid {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-top: 1rem;
}
.streak-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  background: var(--bg-raised, #f1f5f9);
  border: 1px solid var(--border, #e2e8f0);
  color: var(--text, #333);
}
.streak-circle.active {
  background: #10b981;
  color: white;
  border-color: #10b981;
}
.bookmark-list, .quiz-list {
  text-align: left;
  list-style: none;
  padding: 0;
}
.bookmark-item {
  display: flex;
  justify-content: space-between;
  padding: 1rem;
  border-bottom: 1px solid var(--border, #e2e8f0);
}
.bookmark-item:last-child {
  border-bottom: none;
}
.btn {
  background: var(--accent, #3b82f6);
  color: #fff;
  border: none;
  padding: 0.5rem 1rem;
  border-radius: 0.5rem;
  cursor: pointer;
}
.btn-outline {
  background: transparent;
  color: var(--accent, #3b82f6);
  border: 1px solid var(--accent, #3b82f6);
}
</style>

<div class="profile-container" id="profile-content" style="display: none;">
  <div class="glass-card">
    <div class="avatar-container">
      <img src="https://ui-avatars.com/api/?name=User&background=random" id="user-avatar" alt="User Avatar">
    </div>
    <h2 id="user-name" style="margin: 0; color: var(--text, #333);">Student Name</h2>
    <p id="user-email" style="color: var(--text-muted, #666); margin: 0.5rem 0;">student@example.com</p>
    <div class="role-badge">Student</div>
    <br>
    <button class="btn btn-outline" style="margin-top: 1rem;" onclick="window.location.href='/settings/'">Edit Profile</button>
  </div>

  <div class="glass-card" style="display: flex; flex-direction: column; align-items: center;">
    <h3 style="margin-top: 0;">Learning Progress</h3>
    <svg class="progress-ring" width="120" height="120">
      <circle class="progress-ring-bg" cx="60" cy="60" r="50" fill="none" stroke="var(--border, #e2e8f0)" stroke-width="10"/>
      <circle id="progress-ring-fill" cx="60" cy="60" r="50" fill="none" stroke="var(--accent, #3b82f6)" stroke-width="10" stroke-dasharray="314" stroke-dashoffset="220" stroke-linecap="round" style="transform: rotate(-90deg); transform-origin: center; transition: stroke-dashoffset 1s ease;"/>
    </svg>
    <div class="stats-grid" style="width: 100%;">
      <div class="stat-card">
        <div class="stat-value" id="stat-lessons">0</div>
        <div>Lessons</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="stat-streak">0</div>
        <div>Day Streak</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="stat-quiz">0</div>
        <div>Avg Score</div>
      </div>
    </div>
  </div>

  <div class="glass-card">
    <h3 style="margin-top: 0;">7-Day Streak</h3>
    <div class="streak-grid" id="streak-container">
      <!-- Generated by JS -->
    </div>
  </div>

  <div class="glass-card">
    <h3 style="margin-top: 0;">Bookmarked Lessons</h3>
    <ul class="bookmark-list" id="bookmark-list">
      <li>No bookmarks yet. Start reading to bookmark lessons!</li>
    </ul>
  </div>

  <div class="glass-card">
    <h3 style="margin-top: 0;">Recent Quiz Scores</h3>
    <ul class="quiz-list" id="quiz-list">
      <li>No quizzes taken yet.</li>
    </ul>
  </div>
</div>

<div class="profile-container" id="login-prompt" style="display: none; text-align: center;">
  <div class="glass-card">
    <h2>Please login to see your full profile</h2>
    <p>Track your progress, bookmarks, and quiz scores.</p>
    <button class="btn" onclick="window.location.href='/login/'">Login Now</button>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const userDataStr = localStorage.getItem('ev-user-data');
  if (!userDataStr) {
    document.getElementById('login-prompt').style.display = 'block';
    return;
  }
  
  const userData = JSON.parse(userDataStr);
  document.getElementById('profile-content').style.display = 'block';
  
  // Populate User Info
  document.getElementById('user-name').textContent = userData.name || 'Student';
  document.getElementById('user-email').textContent = userData.email || '';
  if (userData.name) {
    document.getElementById('user-avatar').src = 'https://ui-avatars.com/api/?name=' + encodeURIComponent(userData.name) + '&background=random';
  }

  // Populate Bookmarks
  const bookmarksStr = localStorage.getItem('ev-bookmarks');
  const bookmarkList = document.getElementById('bookmark-list');
  if (bookmarksStr) {
    const bookmarks = JSON.parse(bookmarksStr);
    if (bookmarks.length > 0) {
      bookmarkList.innerHTML = '';
      bookmarks.forEach((b, index) => {
        const li = document.createElement('li');
        li.className = 'bookmark-item';
        li.innerHTML = \`
          <a href="\${b.link}" style="color: var(--accent); text-decoration: none; font-weight: bold;">\${b.title}</a>
          <button class="btn btn-outline" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;" onclick="removeBookmark(\${index})">Remove</button>
        \`;
        bookmarkList.appendChild(li);
      });
      document.getElementById('stat-lessons').textContent = bookmarks.length;
    }
  }

  // Populate Quiz History
  const quizStr = localStorage.getItem('ev-quiz-history');
  const quizList = document.getElementById('quiz-list');
  if (quizStr) {
    const quizzes = JSON.parse(quizStr).slice(0, 5);
    if (quizzes.length > 0) {
      quizList.innerHTML = '';
      let totalScore = 0;
      quizzes.forEach(q => {
        totalScore += q.score;
        const li = document.createElement('li');
        li.className = 'bookmark-item';
        li.innerHTML = \`
          <span>\${q.title}</span>
          <strong>\${q.score}%</strong>
        \`;
        quizList.appendChild(li);
      });
      const avg = Math.round(totalScore / quizzes.length);
      document.getElementById('stat-quiz').textContent = avg;
      
      // Update progress ring (offset based on avg)
      const ring = document.getElementById('progress-ring-fill');
      const offset = 314 - (314 * avg / 100);
      ring.style.strokeDashoffset = offset;
    }
  }

  // Populate Streak
  const streakStr = localStorage.getItem('ev-streak-data');
  const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  let activeDays = [];
  if (streakStr) {
    activeDays = JSON.parse(streakStr);
  }
  const streakContainer = document.getElementById('streak-container');
  let currentStreak = 0;
  days.forEach((day, i) => {
    const div = document.createElement('div');
    div.className = 'streak-circle ' + (activeDays.includes(i) ? 'active' : '');
    div.textContent = day;
    streakContainer.appendChild(div);
    if (activeDays.includes(i)) currentStreak++;
  });
  document.getElementById('stat-streak').textContent = currentStreak;
});

function removeBookmark(index) {
  const bookmarksStr = localStorage.getItem('ev-bookmarks');
  if (bookmarksStr) {
    const bookmarks = JSON.parse(bookmarksStr);
    bookmarks.splice(index, 1);
    localStorage.setItem('ev-bookmarks', JSON.stringify(bookmarks));
    if (window.showToast) window.showToast('Bookmark removed');
    location.reload();
  }
}
</script>
