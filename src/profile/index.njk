---
layout: layouts/base.njk
title: My Profile & Analytics
permalink: /profile/
---

<div class="profile-container">
  
  {# 1. Profile Header Card #}
  <div class="card profile-header-card">
    <div class="profile-user-info">
      <picture>
        <source srcset="/assets/icons/icon-192.webp" type="image/webp">
        <img id="profile-avatar" src="/assets/icons/icon-192.png" alt="User profile avatar" class="profile-avatar" width="80" height="80">
      </picture>
      <div>
        <h1 id="profile-name" class="profile-name">Loading...</h1>
        <p id="profile-email" class="profile-email">...</p>
        <span id="profile-role-badge" class="profile-role-badge">User</span>
      </div>
    </div>
    
    <div class="profile-stats-group">
      <div class="profile-stat-box">
        <div class="profile-stat-val" id="profile-trust">--</div>
        <div class="profile-stat-label">Trust Score</div>
      </div>
      <div class="profile-stat-box">
        <div class="profile-stat-val" id="tests-taken-count">0</div>
        <div class="profile-stat-label">Tests Taken</div>
      </div>
    </div>
  </div>

  {# Quick Links Row #}
  <div class="profile-quick-links">
    <a href="/my-diary/" class="btn-secondary profile-quick-link">
      📓 My Diary & Saved Words
    </a>
    <a href="/settings/" class="btn-secondary profile-quick-link">
      ⚙️ Edit Profile & Settings
    </a>
    <a href="/api/auth-logout" class="btn-secondary profile-quick-link profile-logout-link">
      🚪 Logout
    </a>
  </div>

  {# 2. Student test history #}
  <div class="card profile-history-card">
    <h2 class="profile-history-title">
      📈 My Test Attempts (मेरा टेस्ट इतिहास)
    </h2>
    <div class="profile-table-container">
      <table class="profile-table">
        <thead>
          <tr>
            <th>पाठ (Lesson)</th>
            <th>स्कोर (Score)</th>
            <th>प्रतिशत (Percentage)</th>
            <th>तारीख (Date)</th>
          </tr>
        </thead>
        <tbody id="student-attempts-body">
          <tr>
            <td colspan="4" class="profile-empty-td">कोई टेस्ट प्रयास नहीं मिला।</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  {# 3. Owner Analytics Dashboard (Hidden for regular users) #}
  <div id="owner-dashboard-container" class="card owner-dashboard-card" style="display: none;">
    <h2 class="owner-dashboard-title">
      👑 Owner Analytics Dashboard
    </h2>
    
    <div class="owner-tab-controls" role="tablist" aria-label="Analytics Tabs">
      <button onclick="switchTab('owner-summary')" class="btn-primary owner-tab-btn" role="tab" aria-selected="true" id="tab-summary-btn">Summary Stats</button>
      <button onclick="switchTab('owner-attempts')" class="btn-secondary owner-tab-btn" role="tab" aria-selected="false" id="tab-attempts-btn">Student Attempts</button>
    </div>

    {# 3a. Summary Stats Tab #}
    <div id="owner-summary-tab" class="profile-table-container">
      <h3 class="owner-tab-title">क्लास टेस्ट परफॉर्मेंस (Class Performance)</h3>
      <table class="profile-table">
        <thead>
          <tr>
            <th>Test Slug</th>
            <th>Attempts</th>
            <th>Avg Score (%)</th>
            <th>Max Score</th>
            <th>Min Score</th>
          </tr>
        </thead>
        <tbody id="owner-summary-body">
          <tr>
            <td colspan="5" class="profile-empty-td">डाटा लोड हो रहा है...</td>
          </tr>
        </tbody>
      </table>
    </div>

    {# 3b. Student Attempts Tab #}
    <div id="owner-attempts-tab" class="profile-table-container" style="display: none;">
      <h3 class="owner-tab-title">सभी छात्रों के टेस्ट प्रयास (Student History)</h3>
      <table class="profile-table">
        <thead>
          <tr>
            <th>Student</th>
            <th>Email</th>
            <th>Test Slug</th>
            <th>Score</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody id="owner-attempts-body">
          <tr>
            <td colspan="5" class="profile-empty-td">डाटा लोड हो रहा है...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script>
  window.escapeHTML = function(str) {
    if (typeof str !== 'string') return str;
    return str.replace(/[&<>'"]/g, 
      tag => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;'
      }[tag] || tag)
    );
  };

  document.addEventListener('DOMContentLoaded', async () => {
    try {
      // 1. Fetch user authentication info
      const res = await fetch('/api/auth-me');
      const authData = await res.json();
      if (!authData.loggedIn) {
        window.location.href = '/';
        return;
      }
      
      const user = authData.user;
      document.getElementById('profile-name').textContent = user.name;
      document.getElementById('profile-email').textContent = user.email;
      document.getElementById('profile-trust').textContent = user.trust_score;
      if (user.avatar_url) {
        document.getElementById('profile-avatar').src = user.avatar_url;
      }

      // Update role badge
      const roleBadge = document.getElementById('profile-role-badge');
      roleBadge.textContent = user.role;
      if (user.role === 'owner') {
        roleBadge.style.background = 'var(--accent)';
        roleBadge.style.color = '#000';
      } else if (user.role === 'admin') {
        roleBadge.style.background = 'rgba(99, 102, 241, 0.2)';
        roleBadge.style.color = 'var(--accent)';
      }

      // 2. Load personal attempts history
      const attemptsRes = await fetch('/api/tests');
      if (attemptsRes.ok) {
        const attempts = await attemptsRes.json();
        document.getElementById('tests-taken-count').textContent = attempts.length;

        const studentBody = document.getElementById('student-attempts-body');
        if (attempts.length > 0) {
          studentBody.innerHTML = '';
          attempts.forEach(att => {
            const tr = document.createElement('tr');
            tr.style.borderBottom = '1px solid var(--border)';
            
            const pct = Math.round((att.score / att.total_questions) * 100);
            const dateStr = new Date(att.created_at).toLocaleDateString('en-IN', {
              day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
            });

            tr.innerHTML = `
              <td class="profile-td" style="font-weight: 600;">${window.escapeHTML(att.lesson_slug)}</td>
              <td class="profile-td">${window.escapeHTML(att.score.toString())}/${window.escapeHTML(att.total_questions.toString())}</td>
              <td class="profile-td" style="color: ${pct >= 80 ? '#10b981' : pct >= 50 ? 'var(--accent)' : '#ef4444'}; font-weight: bold;">${pct}%</td>
              <td class="profile-td" style="color: var(--text-secondary); font-size: 0.85rem;">${window.escapeHTML(dateStr)}</td>
            `;
            studentBody.appendChild(tr);
          });
        }
      }

      // 3. Load owner dashboard if role is admin/owner
      if (user.role === 'owner' || user.role === 'admin') {
        document.getElementById('owner-dashboard-container').style.display = 'flex';
        loadOwnerAnalytics();
      }
    } catch (e) {
      console.error(e);
      window.location.href = '/';
    }
  });

  async function loadOwnerAnalytics() {
    try {
      const res = await fetch('/api/owner-analytics');
      if (!res.ok) return;

      const data = await res.json();
      
      // Render Summary Tab
      const summaryBody = document.getElementById('owner-summary-body');
      if (data.summary.length > 0) {
        summaryBody.innerHTML = '';
        data.summary.forEach(sum => {
          const tr = document.createElement('tr');
          tr.style.borderBottom = '1px solid var(--border)';
          const avgPct = Math.round(sum.avg_percent);

          tr.innerHTML = `
            <td class="profile-td" style="font-weight: 600;">${window.escapeHTML(sum.lesson_slug)}</td>
            <td class="profile-td">${window.escapeHTML(sum.total_attempts.toString())}</td>
            <td class="profile-td" style="color: ${avgPct >= 80 ? '#10b981' : avgPct >= 50 ? 'var(--accent)' : '#ef4444'}; font-weight: bold;">${avgPct}%</td>
            <td class="profile-td" style="color: #10b981; font-weight: bold;">${window.escapeHTML(sum.max_score.toString())}/${window.escapeHTML(sum.total_questions.toString())}</td>
            <td class="profile-td" style="color: #ef4444; font-weight: bold;">${window.escapeHTML(sum.min_score.toString())}/${window.escapeHTML(sum.total_questions.toString())}</td>
          `;
          summaryBody.appendChild(tr);
        });
      } else {
        summaryBody.innerHTML = '<tr><td colspan="5" class="profile-empty-td">कोई डेटा उपलब्ध नहीं है।</td></tr>';
      }

      // Render Attempts Tab
      const attemptsBody = document.getElementById('owner-attempts-body');
      if (data.attempts.length > 0) {
        attemptsBody.innerHTML = '';
        data.attempts.forEach(att => {
          const tr = document.createElement('tr');
          tr.style.borderBottom = '1px solid var(--border)';
          const dateStr = new Date(att.created_at).toLocaleDateString('en-IN', {
            day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit'
          });

          tr.innerHTML = `
            <td class="profile-td" style="font-weight: 600;">${window.escapeHTML(att.name || 'Student')}</td>
            <td class="profile-td" style="color: var(--text-secondary);">${window.escapeHTML(att.email)}</td>
            <td class="profile-td">${window.escapeHTML(att.lesson_slug)}</td>
            <td class="profile-td" style="font-weight: bold;">${window.escapeHTML(att.score.toString())}/${window.escapeHTML(att.total_questions.toString())}</td>
            <td class="profile-td" style="color: var(--text-secondary); font-size: 0.85rem;">${window.escapeHTML(dateStr)}</td>
          `;
          attemptsBody.appendChild(tr);
        });
      } else {
        attemptsBody.innerHTML = '<tr><td colspan="5" class="profile-empty-td">कोई डेटा उपलब्ध नहीं है।</td></tr>';
      }
    } catch (e) {
      console.warn('[EV] Failed to load owner analytics data:', e);
    }
  }

  function switchTab(tabId) {
    const summaryTab = document.getElementById('owner-summary-tab');
    const attemptsTab = document.getElementById('owner-attempts-tab');
    const summaryBtn = document.getElementById('tab-summary-btn');
    const attemptsBtn = document.getElementById('tab-attempts-btn');

    if (tabId === 'owner-summary') {
      summaryTab.style.display = 'block';
      attemptsTab.style.display = 'none';
      summaryBtn.className = 'btn-primary';
      attemptsBtn.className = 'btn-secondary';
    } else {
      summaryTab.style.display = 'none';
      attemptsTab.style.display = 'block';
      summaryBtn.className = 'btn-secondary';
      attemptsBtn.className = 'btn-primary';
    }
  }
</script>
