    <!-- User Information -->
    <div class="flex-1 text-center sm:text-left">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1.5">
        <h1 class="text-2xl sm:text-3xl font-extrabold font-heading text-primary" id="user-name">Student Learner</h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-accent/10 text-accent border border-accent/20" id="user-role-badge">Guest Mode</span>
      </div>
      <p class="text-xs sm:text-sm text-secondary mb-4" id="user-email">guest@englishvidya.com</p>
      
      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3">
        <a href="/my-diary/" class="px-4 py-2 rounded-xl bg-base border border-border hover:border-accent text-xs font-semibold text-primary hover:text-accent transition-all flex items-center gap-1.5">
          <span>📓 माय डायरी</span>
          <span>→</span>
        </a>
        <a href="/referral/" class="px-4 py-2 rounded-xl bg-base border border-border hover:border-amber-500 text-xs font-semibold text-primary hover:text-amber-500 transition-all flex items-center gap-1.5">
          <span>🪙 रिवार्ड्स व कॉइन्स</span>
          <span>→</span>
        </a>
        <button onclick="toggleProfileEditModal()" id="edit-profile-btn" class="hidden px-4 py-2 rounded-xl bg-base border border-border hover:border-accent text-xs font-semibold text-primary hover:text-accent transition-all flex items-center gap-1.5">
          <span>⚙️ प्रोफाइल एडिट</span>
        </button>
        <a href="/login/?redirect=/profile/" id="profile-action-btn" class="px-4 py-2 rounded-xl bg-base border border-border hover:border-accent text-xs font-semibold text-primary hover:text-accent transition-all">
          Google लॉगिन
        </a>
      </div>
