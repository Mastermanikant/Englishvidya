---
layout: layouts/base.njk
pageTitle: "Student Profile & Learning Dashboard — EnglishVidya"
metaDescription: "Manage your EnglishVidya profile, review saved chapter bookmarks, track daily learning streaks, and access your vocabulary notes."
permalink: /profile/
schemaJson: |
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "name": "Student Profile",
    "description": "Personalized learning dashboard for EnglishVidya students."
  }
---

<div class="max-w-4xl mx-auto py-8 px-4 sm:px-6">
  
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 1. AUTHENTICATED DASHBOARD (SHOWN WHEN LOGGED IN OR LOCAL) -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <div id="profile-content">
    
    <!-- Profile Card Header -->
    <div class="p-6 sm:p-8 rounded-3xl bg-raised border border-border/80 mb-8 relative overflow-hidden flex flex-col sm:flex-row items-center sm:items-start gap-6 shadow-xs">
      
      <!-- Avatar -->
      <div class="relative shrink-0">
        <img src="https://ui-avatars.com/api/?name=Student&background=2563eb&color=fff&size=128" id="user-avatar" alt="Avatar" class="w-24 h-24 rounded-full border-4 border-base shadow-md object-cover">
        <span class="absolute bottom-0 right-0 w-6 h-6 bg-emerald-500 border-2 border-base rounded-full flex items-center justify-center text-white text-[10px]" title="Active">✓</span>
      </div>

      <!-- User Details -->
      <div class="flex-1 text-center sm:text-left">
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1">
          <h1 class="text-2xl sm:text-3xl font-extrabold font-heading text-primary" id="user-name">Student</h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-accent/10 text-accent border border-accent/20" id="user-role-badge">Learner</span>
        </div>
        <p class="text-xs sm:text-sm text-secondary mb-4" id="user-email">student@englishvidya.com</p>
        
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3">
          <a href="/my-diary/" class="px-4 py-2 rounded-xl bg-base border border-border hover:border-accent text-xs font-semibold text-primary hover:text-accent transition-all flex items-center gap-1.5">
            <span>📓 माय डायरी खोलें</span>
            <span>→</span>
          </a>
          <button id="logout-profile-btn" class="px-4 py-2 rounded-xl bg-base border border-border hover:border-rose-500/40 text-xs font-semibold text-rose-500 hover:bg-rose-500/10 transition-all">
            लॉगआउट
          </button>
        </div>
      </div>

    </div>

    <!-- Learning Metrics Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      <div class="p-4 rounded-2xl bg-raised border border-border/70 text-center">
        <div class="text-2xl sm:text-3xl font-extrabold font-heading text-primary" id="stat-chapters">0</div>
        <div class="text-xs text-secondary mt-1">सेव किए गए पाठ</div>
      </div>
      <div class="p-4 rounded-2xl bg-raised border border-border/70 text-center">
        <div class="text-2xl sm:text-3xl font-extrabold font-heading text-accent" id="stat-words">0</div>
        <div class="text-xs text-secondary mt-1">डायरी शब्द नोट्स</div>
      </div>
      <div class="p-4 rounded-2xl bg-raised border border-border/70 text-center">
        <div class="text-2xl sm:text-3xl font-extrabold font-heading text-emerald-500" id="stat-streak">1 🔥</div>
        <div class="text-xs text-secondary mt-1">डेली स्ट्रीक (Days)</div>
      </div>
      <div class="p-4 rounded-2xl bg-raised border border-border/70 text-center">
        <div class="text-2xl sm:text-3xl font-extrabold font-heading text-primary" id="stat-class">12th / 10th</div>
        <div class="text-xs text-secondary mt-1">लर्निंग ट्रैक</div>
      </div>
    </div>

    <!-- Quick Navigation Hub -->
    <div class="p-6 sm:p-8 rounded-3xl bg-raised border border-border/80 mb-8">
      <h2 class="text-lg font-bold font-heading text-primary mb-4 flex items-center gap-2">
        <span>⚡</span> त्वरित अध्ययन शॉर्टकट्स
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href="/class-12/" class="p-4 rounded-xl bg-base border border-border/60 hover:border-accent group transition-all">
          <div class="font-bold text-sm text-primary group-hover:text-accent transition-colors">12वीं Rainbow 2</div>
          <div class="text-xs text-secondary mt-1">30 चैप्टर्स, उच्चारण व प्रश्न-उत्तर</div>
        </a>
        <a href="/class-10/" class="p-4 rounded-xl bg-base border border-border/60 hover:border-accent group transition-all">
          <div class="font-bold text-sm text-primary group-hover:text-accent transition-colors">10वीं Panorama 2</div>
          <div class="text-xs text-secondary mt-1">23 चैप्टर्स, नोट्स व गाइड्स</div>
        </a>
        <a href="/grammar/" class="p-4 rounded-xl bg-base border border-border/60 hover:border-accent group transition-all">
          <div class="font-bold text-sm text-primary group-hover:text-accent transition-colors">ग्रामर मास्टर लैडर</div>
          <div class="text-xs text-secondary mt-1">10 लेवल्स और 17 सेक्शंस</div>
        </a>
      </div>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 2. LOGGED OUT FALLBACK CARD (DISPLAYED WHEN GUEST) -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <div id="login-fallback" class="hidden text-center py-16 px-4">
    <div class="max-w-md mx-auto p-8 rounded-3xl bg-raised border border-border/80 shadow-md">
      <div class="w-16 h-16 rounded-2xl bg-accent/10 text-accent flex items-center justify-center text-3xl mx-auto mb-4">
        🔒
      </div>
      <h2 class="text-xl font-bold font-heading text-primary mb-2">लॉगिन आवश्यक है</h2>
      <p class="text-xs sm:text-sm text-secondary mb-6 leading-relaxed">
        अपना डैशबोर्ड, सेव किए गए चैप्टर्स और वोकैबुलरी डायरी देखने के लिए कृपया लॉगिन करें।
      </p>
      <a href="/login/?redirect=/profile/" class="w-full py-3 px-6 rounded-xl bg-accent text-white font-bold text-sm inline-flex items-center justify-center gap-2 hover:bg-accent/90 transition-all">
        <span>Google से लॉगिन करें</span>
        <span>→</span>
      </a>
    </div>
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', async () => {
  const profileContainer = document.getElementById('profile-content');
  const fallbackContainer = document.getElementById('login-fallback');
  const logoutBtn = document.getElementById('logout-profile-btn');

  try {
    const res = await fetch('/api/auth-me?_t=' + Date.now());
    const data = await res.json();

    if (data.loggedIn && data.user) {
      const u = data.user;
      document.getElementById('user-name').textContent = u.name || 'Student';
      document.getElementById('user-email').textContent = u.email || '';
      if (u.role && u.role !== 'user') {
        document.getElementById('user-role-badge').textContent = u.role.toUpperCase();
      }
      if (u.avatar_url) {
        document.getElementById('user-avatar').src = u.avatar_url;
      }
      profileContainer.classList.remove('hidden');
      if (fallbackContainer) fallbackContainer.classList.add('hidden');
    } else {
      // If guest and not on localhost, display fallback prompt
      if (window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1') {
        profileContainer.classList.add('hidden');
        if (fallbackContainer) fallbackContainer.classList.remove('hidden');
      }
    }
  } catch (e) {
    console.warn('Local profile preview fallback active:', e);
  }

  // Count saved diary words from localStorage
  try {
    const savedWords = JSON.parse(localStorage.getItem('ev_diary_words') || '[]');
    const statWords = document.getElementById('stat-words');
    if (statWords) statWords.textContent = savedWords.length;

    const savedBookmarks = JSON.parse(localStorage.getItem('ev_bookmarks') || '[]');
    const statChapters = document.getElementById('stat-chapters');
    if (statChapters) statChapters.textContent = savedBookmarks.length;
  } catch (e) {}

  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      window.location.href = '/api/auth-logout';
    });
  }
});
</script>
