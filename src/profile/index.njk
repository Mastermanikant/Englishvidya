</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- PROFILE EDIT MODAL -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div id="profile-edit-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
  <div class="bg-base border border-border rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative">
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-border">
      <h3 class="text-lg font-bold font-heading text-primary">प्रोफाइल विवरण संपादित करें</h3>
      <button onclick="toggleProfileEditModal()" class="text-secondary hover:text-primary text-xl font-bold">✕</button>
    </div>

    <form id="edit-profile-form" onsubmit="saveProfileDetails(event)" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-secondary mb-1">आपका नाम (Name)</label>
        <input type="text" id="edit-name" class="w-full px-3.5 py-2 rounded-xl bg-raised border border-border text-sm text-primary focus:outline-none focus:border-accent">
      </div>
      <div>
        <label class="block text-xs font-semibold text-secondary mb-1">यूज़रनेम (Username)</label>
        <input type="text" id="edit-username" placeholder="@username" class="w-full px-3.5 py-2 rounded-xl bg-raised border border-border text-sm text-primary focus:outline-none focus:border-accent">
      </div>
      <div>
        <label class="block text-xs font-semibold text-secondary mb-1">पता / जिला (Location / City)</label>
        <input type="text" id="edit-location" placeholder="उदा. पटना, बिहार" class="w-full px-3.5 py-2 rounded-xl bg-raised border border-border text-sm text-primary focus:outline-none focus:border-accent">
      </div>
      <div>
        <label class="block text-xs font-semibold text-secondary mb-1">इंस्टाग्राम हैंडल (Instagram)</label>
        <input type="text" id="edit-instagram" placeholder="https://instagram.com/..." class="w-full px-3.5 py-2 rounded-xl bg-raised border border-border text-sm text-primary focus:outline-none focus:border-accent">
      </div>

      <div class="flex justify-end gap-3 pt-2 border-t border-border">
        <button type="button" onclick="toggleProfileEditModal()" class="px-4 py-2 rounded-xl bg-raised border border-border text-xs font-semibold text-secondary hover:text-primary">रद्द करें</button>
        <button type="submit" id="save-profile-btn" class="px-5 py-2 rounded-xl bg-accent text-white font-bold text-xs hover:bg-accent/90 transition-all">सेव करें</button>
      </div>
    </form>
  </div>
</div>

<script>
(function() {
  const guestBanner = document.getElementById('guest-banner');
  const actionBtn = document.getElementById('profile-action-btn');
  const editBtn = document.getElementById('edit-profile-btn');
  const nameEl = document.getElementById('user-name');
  const emailEl = document.getElementById('user-email');
  const roleEl = document.getElementById('user-role-badge');
  const avatarEl = document.getElementById('user-avatar');

  let activeUser = null;

  function renderUserData(u) {
    if (!u) return;
    activeUser = u;
    if (nameEl) nameEl.textContent = u.name || 'Student';
    if (emailEl) emailEl.textContent = u.email || '';
    if (roleEl) roleEl.textContent = (u.role || 'Learner').toUpperCase();
    if (avatarEl && u.avatar_url) avatarEl.src = u.avatar_url;
    
    if (guestBanner) guestBanner.style.display = 'none';
    if (editBtn) editBtn.classList.remove('hidden');

    if (actionBtn) {
      actionBtn.textContent = 'लॉगआउट';
      actionBtn.href = '/api/auth-logout';
      actionBtn.className = 'px-4 py-2 rounded-xl bg-base border border-border hover:border-rose-500/40 text-xs font-semibold text-rose-500 hover:bg-rose-500/10 transition-all';
      actionBtn.onclick = () => {
        try { localStorage.removeItem('ev_cached_user'); } catch (err) {}
      };
    }
  }

  // 1. Instant rendering from cache
  try {
    const cached = localStorage.getItem('ev_cached_user');
    if (cached) renderUserData(JSON.parse(cached));
  } catch (e) {}

  // 2. Count local + standardized metrics
  function updateStats() {
    try {
      // Notes
      const notes = JSON.parse(localStorage.getItem('ev-diary-notes') || localStorage.getItem('ev_diary_words') || '[]');
      const statWords = document.getElementById('stat-words');
      if (statWords) statWords.textContent = notes.length;

      // Bookmarks
      const bookmarks = JSON.parse(localStorage.getItem('ev-bookmarks') || localStorage.getItem('ev_bookmarks') || '[]');
      const statChapters = document.getElementById('stat-chapters');
      if (statChapters) statChapters.textContent = bookmarks.length;
    } catch (e) {}
  }
  updateStats();

  // 3. Live server sync & fetch test attempts + diary stats
  async function refreshServerData() {
    try {
      const res = await fetch('/api/auth-me?_t=' + Date.now(), { cache: 'no-store' });
      if (res.ok) {
        const data = await res.json();
        if (data.loggedIn && data.user) {
          try { localStorage.setItem('ev_cached_user', JSON.stringify(data.user)); } catch (e) {}
          renderUserData(data.user);

          // Fetch cloud diary stats
          fetch('/api/diary')
            .then(r => r.json())
            .then(d => {
              if (d.success) {
                if (d.notes && d.notes.length) {
                  const statWords = document.getElementById('stat-words');
                  if (statWords) statWords.textContent = Math.max(d.notes.length, parseInt(statWords.textContent || '0'));
                }
                if (d.bookmarks && d.bookmarks.length) {
                  const statChapters = document.getElementById('stat-chapters');
                  if (statChapters) statChapters.textContent = Math.max(d.bookmarks.length, parseInt(statChapters.textContent || '0'));
                }
              }
            }).catch(() => {});

          // Fetch test history
          fetch('/api/tests')
            .then(r => r.json())
            .then(attempts => {
              if (Array.isArray(attempts) && attempts.length > 0) {
                const statTests = document.getElementById('stat-tests');
                if (statTests) statTests.textContent = attempts.length;

                const historyContainer = document.getElementById('profile-test-history');
                const emptyMsg = document.getElementById('test-history-empty');
                if (emptyMsg) emptyMsg.style.display = 'none';

                historyContainer.innerHTML = attempts.slice(0, 5).map(att => {
                  const percent = Math.round((att.score / att.total_questions) * 100);
                  const isPass = percent >= 50;
                  const dateStr = att.created_at ? new Date(att.created_at).toLocaleDateString('hi-IN') : '';
                  const cleanSlug = att.lesson_slug.replace('quiz-', '').replace(/-/g, ' ').toUpperCase();

                  return `
                    <div class="p-3.5 rounded-2xl bg-base border border-border flex items-center justify-between gap-3">
                      <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl ${isPass ? 'bg-emerald-500/10 text-emerald-500' : 'bg-rose-500/10 text-rose-500'} flex items-center justify-center font-bold text-sm">
                          ${percent}%
                        </div>
                        <div>
                          <div class="font-bold text-xs sm:text-sm text-primary">${cleanSlug}</div>
                          <div class="text-[11px] text-secondary">स्कोर: ${att.score}/${att.total_questions} • ${dateStr}</div>
                        </div>
                      </div>
                      <a href="/test/${att.lesson_slug.replace('quiz-', '')}/" class="px-3 py-1 rounded-lg bg-raised border border-border text-[11px] font-semibold text-primary hover:border-accent">
                        री-टेस्ट
                      </a>
                    </div>
                  `;
                }).join('');
              }
            }).catch(() => {});
        } else {
          try { localStorage.removeItem('ev_cached_user'); } catch (e) {}
        }
      }
    } catch (err) {}
  }

  // Profile Edit Modal Handler
  window.toggleProfileEditModal = function() {
    const modal = document.getElementById('profile-edit-modal');
    if (!modal) return;
    modal.classList.toggle('hidden');
    if (!modal.classList.contains('hidden') && activeUser) {
      document.getElementById('edit-name').value = activeUser.name || '';
      document.getElementById('edit-username').value = activeUser.username || '';
      document.getElementById('edit-location').value = activeUser.location_address || '';
      document.getElementById('edit-instagram').value = activeUser.social_instagram || '';
    }
  };

  window.saveProfileDetails = async function(e) {
    e.preventDefault();
    const btn = document.getElementById('save-profile-btn');
    btn.disabled = true;
    btn.textContent = 'सेव हो रहा है...';

    const payload = {
      name: document.getElementById('edit-name').value.trim(),
      username: document.getElementById('edit-username').value.trim(),
      location_address: document.getElementById('edit-location').value.trim(),
      social_instagram: document.getElementById('edit-instagram').value.trim()
    };

    try {
      const res = await fetch('/api/user-update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        if (activeUser) {
          Object.assign(activeUser, payload);
          localStorage.setItem('ev_cached_user', JSON.stringify(activeUser));
          renderUserData(activeUser);
        }
        toggleProfileEditModal();
        if (window.showToast) window.showToast('प्रोफाइल विवरण अपडेट हो गया! ✨');
      } else {
        alert(data.error || 'प्रोफाइल अपडेट करने में त्रुटि आई।');
      }
    } catch(err) {
      alert('नेटवर्क त्रुटि।');
    } finally {
      btn.disabled = false;
      btn.textContent = 'सेव करें';
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', refreshServerData);
  } else {
    refreshServerData();
  }
})();
</script>
