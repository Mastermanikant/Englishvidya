        🎓
      </div>
      <div>
        <h2 class="text-base sm:text-lg font-bold font-heading text-primary">
          आप गेस्ट मोड (Guest Mode) में पढ़ रहे हैं
        </h2>
        <p class="text-xs text-secondary mt-0.5">
          Google से 1-क्लिक में लॉगिन करें ताकि आपके सारे नोट्स, डायरी, टेस्ट रिजल्ट्स और बुकमार्क्स क्लाउड पर सुरक्षित रहें।
        </p>
      </div>
    </div>
    <a href="/login/?redirect=/profile/" class="px-5 py-2.5 rounded-xl bg-accent text-white font-bold text-xs sm:text-sm hover:bg-accent/90 transition-all whitespace-nowrap shadow-sm hover:shadow-md inline-flex items-center gap-2">
      <span>Google से लॉगिन करें</span>
      <span>→</span>
    </a>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 2. STUDENT PROFILE HEADER CARD -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <div class="p-6 sm:p-8 rounded-3xl bg-raised border border-border mb-8 flex flex-col sm:flex-row items-center sm:items-start gap-6 shadow-xs relative overflow-hidden">
    
    <!-- User Avatar -->
    <div class="relative shrink-0">
      <img src="https://ui-avatars.com/api/?name=Student&background=2563eb&color=fff&size=128" id="user-avatar" alt="Avatar" class="w-24 h-24 rounded-full border-4 border-base shadow-md object-cover">
