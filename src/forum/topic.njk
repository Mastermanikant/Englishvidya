---
layout: layouts/base.njk
title: Discussion Topic
permalink: /forum/topic/
---

<style>
  .forum-container {
    max-width: 900px;
    margin: 40px auto;
    padding: 0 20px;
  }
  .topic-card {
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border);
    padding: 30px;
    margin-bottom: 30px;
  }
  .reply-card {
    display: flex;
    gap: 16px;
    background: var(--bg-raised);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    padding: 20px;
    margin-bottom: 16px;
  }
  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }
  .meta {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }
  .content {
    font-size: 1rem;
    color: var(--text-main);
    line-height: 1.6;
    white-space: pre-wrap;
  }
</style>

<div class="forum-container">
  <div style="margin-bottom: 20px;">
    <a href="/forum/" style="color: var(--accent); text-decoration: none; font-weight: bold;">&larr; Back to Forum</a>
  </div>

  <div id="topic-container">
    <p>Loading topic...</p>
  </div>

  <h3 style="margin-top: 40px; border-bottom: 1px solid var(--border); padding-bottom: 10px;">Replies</h3>
  <div id="replies-container">
    <p style="color: var(--text-secondary);">Loading replies...</p>
  </div>

  <div id="reply-box" style="margin-top: 40px; display: none;">
    <h3>Leave a Reply</h3>
    <textarea id="reply-content" placeholder="Write your reply here... (Remember to follow community guidelines)" style="width: 100%; padding: 16px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg-base); color: var(--text-main); min-height: 120px; resize: vertical; margin-bottom: 16px;"></textarea>
    <button id="btn-submit-reply" class="btn-primary" style="padding: 12px 24px; font-weight: bold; border-radius: 8px;">Post Reply</button>
  </div>

  <div id="login-prompt" style="margin-top: 40px; padding: 20px; background: var(--bg-raised); border-radius: 8px; text-align: center; border: 1px solid var(--border); display: none;">
    <p>You must be logged in to reply to this discussion.</p>
    <a href="/login/?redirect=" id="login-redirect-btn" class="btn-primary" style="padding: 10px 20px; text-decoration: none; display: inline-block; border-radius: 8px;">Log In</a>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', async () => {
  const urlParams = new URLSearchParams(window.location.search);
  const topicId = urlParams.get('id');

  if (!topicId) {
    document.getElementById('topic-container').innerHTML = '<p style="color: red;">Invalid Topic ID.</p>';
    return;
  }

  // Update redirect link
  const loginBtn = document.getElementById('login-redirect-btn');
  if (loginBtn) loginBtn.href = '/login/?redirect=/forum/topic/?id=' + topicId;

  // Load Auth State
  let isLoggedIn = false;
  let hasAcceptedRules = 0;
  try {
    const authRes = await fetch('/api/auth-me');
    const authData = await authRes.json();
    isLoggedIn = authData.loggedIn;
    if (isLoggedIn) {
      hasAcceptedRules = authData.user.has_accepted_rules;
      document.getElementById('reply-box').style.display = 'block';
    } else {
      document.getElementById('login-prompt').style.display = 'block';
    }
  } catch (e) {}

  const topicContainer = document.getElementById('topic-container');
  const repliesContainer = document.getElementById('replies-container');

  async function loadData() {
    try {
      const res = await fetch(`/api/forum?id=${topicId}`);
      if (!res.ok) {
        topicContainer.innerHTML = '<p style="color: red;">Topic not found.</p>';
        repliesContainer.innerHTML = '';
        return;
      }
      
      const data = await res.json();
      const t = data.topic;
      const replies = data.replies;

      document.title = t.title + ' - EnglishVidya Forum';

      topicContainer.innerHTML = `
        <div class="topic-card">
          <h1 style="font-family: var(--font-heading); color: var(--accent); margin-top: 0; margin-bottom: 10px; font-size: 2rem;">${t.title}</h1>
          <div class="meta" style="margin-bottom: 20px; display: flex; gap: 10px; align-items: center;">
            <img src="${t.avatar_url || '/assets/icons/icon-192.png'}" class="avatar" style="width: 32px; height: 32px;">
            <span>By <strong>${t.name}</strong> • ${new Date(t.created_at).toLocaleString()}</span>
          </div>
          <div class="content" style="font-size: 1.1rem;">${t.content}</div>
        </div>
      `;

      if (replies.length === 0) {
        repliesContainer.innerHTML = '<p style="color: var(--text-secondary);">No replies yet. Be the first to answer!</p>';
      } else {
        repliesContainer.innerHTML = replies.map(r => `
          <div class="reply-card">
            <img src="${r.avatar_url || '/assets/icons/icon-192.png'}" class="avatar">
            <div style="flex: 1;">
              <div class="meta">
                <strong style="color: var(--text-main); font-size: 0.95rem;">${r.name}</strong> • ${new Date(r.created_at).toLocaleString()}
              </div>
              <div class="content">${r.reply_text}</div>
            </div>
          </div>
        `).join('');
      }

    } catch (e) {
      topicContainer.innerHTML = '<p style="color: red;">Network error loading topic.</p>';
    }
  }

  loadData();

  // Reply Handling
  const btnSubmit = document.getElementById('btn-submit-reply');
  if (btnSubmit) {
    btnSubmit.addEventListener('click', async () => {
      if (!hasAcceptedRules) {
        window.location.href = '/agreement/';
        return;
      }

      const text = document.getElementById('reply-content').value.trim();
      if (!text) return alert('Reply cannot be empty.');

      // Offline Keyword Check
      const blockedKeywords = ['bjp', 'congress', 'hindu', 'muslim', 'islam', 'christian', 'modi', 'rahul', 'politics', 'धर्म', 'राजनीति', 'गाली', 'chutiya', 'madarchod', 'bhenchod', 'scam'];
      const lowerText = text.toLowerCase();
      for (const kw of blockedKeywords) {
        if (lowerText.includes(kw)) {
          return alert('आपका मैसेज हमारी कम्युनिटी गाइडलाइन्स के खिलाफ है।');
        }
      }

      btnSubmit.disabled = true;
      btnSubmit.textContent = 'Posting...';

      try {
        const res = await fetch('/api/forum', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'reply', topic_id: topicId, reply_text: text })
        });
        const result = await res.json();
        
        if (res.ok && result.success) {
          document.getElementById('reply-content').value = '';
          loadData();
        } else {
          alert(result.error || 'Failed to post reply.');
        }
      } catch (e) {
        alert('Network error.');
      }
      btnSubmit.disabled = false;
      btnSubmit.textContent = 'Post Reply';
    });
  }
});
</script>