<script>
let refData = null;
const THRESHOLD_MINS = 180;
const RING_CIRCUMFERENCE = 364.4; // 2 * pi * 58

document.addEventListener('DOMContentLoaded', async () => {
  try {
    const authRes = await fetch('/api/auth-me');
    const authData = await authRes.json();
    if (!authData.loggedIn) {
      window.location.href = '/login/?redirect_to=/referral/';
      return;
    }
    await loadDashboard();
  } catch (e) {
    window.location.href = '/';
  }
});

async function loadDashboard() {
  try {
    const res = await fetch('/api/referral');
    if (!res.ok) throw new Error();
    refData = await res.json();

    document.getElementById('ref-loading').style.display = 'none';
    document.getElementById('ref-main').style.display = 'block';

    renderHero();
    renderReferralLink();
    renderFriends();
    renderLedger();
  } catch (e) {
    console.error('Failed to load referral dashboard', e);
  }
}

function renderHero() {
  const coins = refData.referral_coins || 0;
  document.getElementById('ref-balance-num').textContent = coins.toLocaleString('en-IN');
  document.getElementById('ref-balance-inr').textContent = `= ₹${(coins / 100).toFixed(2)}`;

  // Progress ring
  const activeMins = Math.floor((refData.active_seconds || 0) / 60);
  const percent = Math.min(100, (activeMins / THRESHOLD_MINS) * 100);
  const offset = RING_CIRCUMFERENCE - (percent / 100) * RING_CIRCUMFERENCE;
  document.getElementById('ring-fill').style.strokeDashoffset = offset;
  document.getElementById('ring-mins').textContent = activeMins;

  const remainMins = Math.max(0, THRESHOLD_MINS - activeMins);
  const msgEl = document.getElementById('ring-msg');
  if (remainMins > 0) {
    msgEl.innerHTML = `900 Coins के लिए <strong>${remainMins} मिनट</strong> और पढ़ें! 🎯`;
  } else {
    msgEl.innerHTML = `🎉 <strong>बधाई!</strong> 3 घंटे पूरे! 900 Coins मिल गए!`;
    document.getElementById('ring-fill').style.stroke = 'var(--coin-gold)';
  }
}

function renderReferralLink() {
  if (refData.username) {
    const link = `${window.location.origin}/${refData.username}`;
    document.getElementById('ref-link-val').value = link;
    document.getElementById('ref-link-active').style.display = 'block';
    document.getElementById('ref-link-no-username').style.display = 'none';
  } else {
    document.getElementById('ref-link-active').style.display = 'none';
    document.getElementById('ref-link-no-username').style.display = 'block';
  }
}

function renderFriends() {
  const container = document.getElementById('friends-list');
  const badge = document.getElementById('friend-count-badge');
  const referrals = refData.referrals || [];
  badge.textContent = referrals.length;

  if (referrals.length === 0) {
    container.innerHTML = '<div class="empty-state">अभी तक कोई रेफ़रल नहीं। पहले दोस्त को invite करें! 🚀</div>';
    return;
  }

  container.innerHTML = referrals.map(r => {
    const activeMins = Math.floor((r.active_seconds || 0) / 60);
    const progressPct = Math.min(100, (activeMins / THRESHOLD_MINS) * 100);
    const isDone = !!r.referrer_bonus_paid;
    const initials = (r.name || '?').charAt(0).toUpperCase();
    const joinDate = new Date(r.created_at).toLocaleDateString('hi-IN');

    return `
      <div class="friend-row">
        <div class="friend-avatar">${initials}</div>
        <div class="friend-info">
          <div class="friend-name">${escHtml(r.name || 'User')}</div>
          <div class="friend-meta">Joined: ${joinDate}</div>
          <div class="friend-progress-bar-track">
            <div class="friend-progress-bar-fill" style="width:${progressPct}%"></div>
          </div>
          <div class="friend-meta">${activeMins}/180 min पढ़ा</div>
        </div>
        <span class="friend-status-badge ${isDone ? 'done' : 'pending'}">
          ${isDone ? '✅ Done' : '⏳ Pending'}
        </span>
      </div>
    `;
  }).join('');
}

function renderLedger() {
  const container = document.getElementById('ledger-list');
  const txns = refData.transactions || [];

  if (txns.length === 0) {
    container.innerHTML = '<div class="empty-state">अभी कोई coin activity नहीं है।</div>';
    return;
  }

  container.innerHTML = txns.map(t => {
    const isEarned = t.amount > 0;
    const sign = isEarned ? `+${t.amount}` : `${t.amount}`;
    const icon = isEarned ? '💰' : '🛍️';
    const date = new Date(t.created_at).toLocaleString('hi-IN');
    return `
      <div class="ledger-item">
        <div class="ledger-icon ${isEarned ? 'earned' : 'spent'}">${icon}</div>
        <div class="ledger-desc">
          <div class="ledger-desc-title">${escHtml(t.description)}</div>
          <div class="ledger-desc-date">${date}</div>
        </div>
        <div class="ledger-amount ${isEarned ? 'earned' : 'spent'}">${sign}</div>
      </div>
    `;
  }).join('');
}

function escHtml(str) {
  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function copyRefLink() {
  const input = document.getElementById('ref-link-val');
  navigator.clipboard.writeText(input.value).then(() => {
    const btn = document.getElementById('ref-link-copy-btn');
    btn.textContent = 'Copied!';
    btn.style.background = 'var(--study-green)';
    setTimeout(() => { btn.textContent = 'Copy'; btn.style.background = ''; }, 2000);
  });
}

function shareRefLink() {
  const url = document.getElementById('ref-link-val').value;
  const text = `🎓 EnglishVidya पर English सीखें! मेरे लिंक से join करें और दोनों को Frankbase Coins मिलेंगे:\n${url}`;
  if (navigator.share) {
    navigator.share({ title: 'EnglishVidya — Refer & Earn', text, url }).catch(() => {});
  } else {
    const wa = `https://wa.me/?text=${encodeURIComponent(text)}`;
    window.open(wa, '_blank');
  }
}

async function redeemCoins() {
  const amountEl = document.getElementById('redeem-amount');
  const amount = parseInt(amountEl.value);

  if (!amount || amount < 100 || amount % 100 !== 0) {
    alert('कृपया 100 के गुणक में coins दर्ज करें (जैसे 100, 500, 1000)');
    return;
  }
  if (amount > (refData?.referral_coins || 0)) {
    alert('आपके पास पर्याप्त coins नहीं हैं!');
    return;
  }
  if (!confirm(`क्या आप ${amount} coins को ₹${amount/100} के coupon में बदलना चाहते हैं?`)) return;

  try {
    const res = await fetch('/api/redeem-coins', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ amount })
    });
    const result = await res.json();
    if (result.success) {
      document.getElementById('promo-code-val').textContent = result.promo_code;
      document.getElementById('promo-reveal').style.display = 'block';
      amountEl.value = '';
      loadDashboard(); // Refresh balance
    } else {
      alert('Error: ' + result.error);
    }
  } catch (e) {
    alert('Redemption failed. Please try again.');
  }
}

async function redeemPassWithCoins() {
  const cost = 1000;
  if ((refData?.referral_coins || 0) < cost) {
    alert('आपके पास पर्याप्त coins नहीं हैं! 24-घंटे का पास अनलॉक करने के लिए कम से कम 1,000 कॉइन्स होने चाहिए।');
    return;
  }

  if (!confirm('क्या आप 1,000 Coins खर्च करके 24-घंटे का Ad-Free Premium Pass अनलॉक करना चाहते हैं?')) return;

  const btn = document.getElementById('btn-redeem-pass');
  btn.disabled = true;
  btn.textContent = 'Processing...';

  try {
    const res = await fetch('/api/redeem-pass-coins', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'}
    });
    const result = await res.json();

    if (res.ok && result.success) {
      // Set localStorage values (same as /paid/ page logic)
      localStorage.setItem('ev-no-ads-until', result.expires_at.toString());
      localStorage.setItem('ev-active-plan-type', '24 Hour Pass');
      
      // Dispatch custom storage event to notify base layout timer immediately
      window.dispatchEvent(new Event('storage'));

      alert('🎉 24-Hour Premium Ad-Free Pass सक्रिय कर दिया गया है! अब आप बिना विज्ञापन के पढ़ सकते हैं।');
      loadDashboard(); // Refresh balance
    } else {
      alert('Error: ' + (result.error || 'Failed to unlock pass.'));
    }
  } catch (e) {
    alert('Failed to connect. Please try again.');
  } finally {
    btn.disabled = false;
    btn.textContent = '🪙 24h Premium Pass अनलॉक करें (1,000 Coins)';
  }
}
</script>
