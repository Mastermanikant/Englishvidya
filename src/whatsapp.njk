<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redirecting to WhatsApp...</title>
    <!-- Fallback redirect in case JS is disabled -->
    <meta http-equiv="refresh" content="2; url={{ site.whatsappChannel }}">
    
    <!-- Google Analytics to track this click -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VWJHVR3VBL"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VWJHVR3VBL');
      
      // Track the redirect event
      gtag('event', 'smart_link_click', {
        'event_category': 'Outbound Link',
        'event_label': 'WhatsApp Channel',
        'event_callback': function() {
          window.location.href = "{{ site.whatsappChannel }}";
        }
      });

      // Fallback redirect if GA fails to load within 1.5 seconds
      setTimeout(function() {
        window.location.href = "{{ site.whatsappChannel }}";
      }, 1500);
    </script>
    
</head>
<body>
    <div class="container">
        <div class="loader"></div>
        <h2>Redirecting to our WhatsApp Channel...</h2>
        <p>If you are not redirected automatically, <a href="{{ site.whatsappChannel }}">click here</a>.</p>
    </div>
</body>
</html>
