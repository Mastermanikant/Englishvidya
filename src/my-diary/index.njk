---
layout: layouts/base.njk
pageTitle: "My Personal English Diary — EnglishVidya"
metaDescription: "Access your personal vocabulary notebook, saved chapter highlights, and practice custom flashcards on EnglishVidya."
permalink: /my-diary/
schemaJson: |
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "My Personal English Diary",
    "description": "Student vocabulary diary and personalized chapter notebook."
  }
---

<div class="max-w-4xl mx-auto py-8 px-4 sm:px-6">
  
  <!-- Header Banner -->
  <div class="p-6 sm:p-8 rounded-3xl bg-raised border border-border/80 mb-6 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xs">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-bold uppercase tracking-wider mb-2">
        <span>📓</span> पर्सनल नोटबुक
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold font-heading text-primary tracking-tight">
        माय इंग्लिश डायरी (My Diary)
      </h1>
      <p class="text-xs sm:text-sm text-secondary mt-1 max-w-xl">
        आपके द्वारा सेव किए गए सभी कठिन शब्द, महत्वपूर्ण वाक्य और नोट्स यहाँ सुरक्षित रहते हैं।
      </p>
    </div>

    <!-- Quick Action -->
    <div class="flex items-center gap-2 shrink-0">
      <button id="add-custom-note-btn" class="px-4 py-2.5 rounded-xl bg-accent text-white font-semibold text-xs sm:text-sm hover:bg-accent/90 transition-all flex items-center gap-1.5 shadow-sm">
        <span>➕ नया शब्द/नोट जोड़ें</span>
      </button>
    </div>
  </div>

  <!-- Smart Sync Status Banner -->
  <div id="diary-sync-banner" class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/20 mb-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-2.5 text-amber-600 dark:text-amber-400">
      <span class="text-base">💡</span>
      <span><strong>गेस्ट मोड (Guest Mode):</strong> आपके नोट्स इस डिवाइस में सुरक्षित हैं। अपने मोबाइल और कंप्यूटर पर हमेशा के लिए सुरक्षित रखने हेतु 1-क्लिक में लॉगिन करें।</span>
    </div>
    <a href="/login/?redirect=/my-diary/" class="px-3.5 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-white font-bold whitespace-nowrap transition-colors">
      Google लॉगिन करें →
    </a>
  </div>

  <!-- Search & Filter Controls -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
    <div class="relative w-full sm:w-72">
      <input type="text" id="diary-search-input" placeholder="डायरी में खोजें..." class="w-full px-4 py-2.5 rounded-xl bg-raised border border-border text-sm text-primary placeholder-secondary focus:outline-none focus:border-accent">
      <span class="absolute right-3 top-2.5 text-secondary text-sm">🔍</span>
    </div>

    <!-- Filter Pills -->
    <div class="flex items-center gap-2 w-full sm:w-auto overflow-x-auto pb-1" id="diary-filter-group">
      <button class="diary-filter-pill active px-3 py-1.5 rounded-lg text-xs font-semibold bg-accent text-white" data-filter="all">सभी (<span id="count-all">0</span>)</button>
      <button class="diary-filter-pill px-3 py-1.5 rounded-lg text-xs font-semibold bg-raised border border-border text-secondary hover:text-primary" data-filter="word">शब्द (<span id="count-words">0</span>)</button>
      <button class="diary-filter-pill px-3 py-1.5 rounded-lg text-xs font-semibold bg-raised border border-border text-secondary hover:text-primary" data-filter="note">नोट्स (<span id="count-notes">0</span>)</button>
    </div>
  </div>

  <!-- Diary Entries Container -->
  <div id="diary-entries-list" class="space-y-3">
    <!-- Populated by JavaScript -->
  </div>

  <!-- Empty State (Shown when 0 entries) -->
  <div id="diary-empty-state" class="hidden text-center py-16 px-4 bg-raised rounded-3xl border border-border/80">
    <div class="w-16 h-16 rounded-2xl bg-accent/10 text-accent flex items-center justify-center text-3xl mx-auto mb-4">
      ✍️
    </div>
    <h3 class="text-lg font-bold font-heading text-primary mb-2">आपकी डायरी अभी खाली है</h3>
    <p class="text-xs sm:text-sm text-secondary max-w-md mx-auto mb-6 leading-relaxed">
      किसी भी चैप्टर या ग्रामर पाठ को पढ़ते समय किसी भी टेक्स्ट को सिलेक्ट करें और <strong>"✍️ Save to Diary"</strong> पर क्लिक करें, या ऊपर दिए गए <strong>"नया शब्द/नोट जोड़ें"</strong> बटन का उपयोग करें।
    </p>
    <a href="/dictionary/" class="px-5 py-2.5 rounded-xl bg-base border border-border hover:border-accent text-xs font-semibold text-primary hover:text-accent transition-all inline-flex items-center gap-1.5">
      <span>डिक्शनरी में शब्द खोजें</span>
      <span>→</span>
    </a>
  </div>

</div>

<!-- Modal: Add Custom Note -->
<div id="add-note-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
  <div class="bg-base border border-border rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative">
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-border">
      <h3 class="text-lg font-bold font-heading text-primary">डायरी में नया नोट जोड़ें</h3>
      <button id="close-modal-btn" class="text-secondary hover:text-primary text-xl font-bold">✕</button>
    </div>

    <div class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-secondary mb-1">अंग्रेज़ी शब्द / शीर्षक (Title / Word)</label>
        <input type="text" id="note-title-input" class="w-full px-3.5 py-2 rounded-xl bg-raised border border-border text-sm text-primary focus:outline-none focus:border-accent" placeholder="उदा. Persevere">
      </div>

      <div>
        <label class="block text-xs font-semibold text-secondary mb-1">हिन्दी अर्थ / विवरण (Meaning / Details)</label>
        <textarea id="note-desc-input" rows="3" class="w-full px-3.5 py-2 rounded-xl bg-raised border border-border text-sm text-primary focus:outline-none focus:border-accent" placeholder="उदा. कठिनाइयों के बावजूद लगातार प्रयास जारी रखना"></textarea>
      </div>

      <button id="save-note-submit-btn" class="w-full py-2.5 rounded-xl bg-accent text-white font-bold text-sm hover:bg-accent/90 transition-all">
        डायरी में सेव करें
      </button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const entriesList = document.getElementById('diary-entries-list');
  const emptyState = document.getElementById('diary-empty-state');
  const searchInput = document.getElementById('diary-search-input');
  const addModal = document.getElementById('add-note-modal');
  const addBtn = document.getElementById('add-custom-note-btn');
  const closeBtn = document.getElementById('close-modal-btn');
  const submitBtn = document.getElementById('save-note-submit-btn');

  let activeFilter = 'all';

  function getNotes() {
    try {
      const notes = JSON.parse(localStorage.getItem('ev-diary-notes') || '[]');
      const words = JSON.parse(localStorage.getItem('ev_diary_words') || '[]');
      
      const formattedWords = words.map(w => ({
        id: 'w_' + (w.slug || w.word),
        title: w.word,
        text: w.meaning || '',
        pron: w.pron || '',
        type: 'word',
        date: w.date || new Date().toISOString()
      }));

      const formattedNotes = notes.map(n => ({
        ...n,
        type: n.type || 'note'
      }));

      return [...formattedWords, ...formattedNotes];
    } catch (e) {
      return [];
    }
  }

  function renderDiary() {
    const allItems = getNotes();
    const query = (searchInput.value || '').toLowerCase().trim();

    const filtered = allItems.filter(item => {
      if (activeFilter === 'word' && item.type !== 'word') return false;
      if (activeFilter === 'note' && item.type === 'word') return false;
      if (query) {
        const t = (item.title || '').toLowerCase();
        const txt = (item.text || '').toLowerCase();
        return t.includes(query) || txt.includes(query);
      }
      return true;
    });

    // Update counts
    document.getElementById('count-all').textContent = allItems.length;
    document.getElementById('count-words').textContent = allItems.filter(i => i.type === 'word').length;
    document.getElementById('count-notes').textContent = allItems.filter(i => i.type !== 'word').length;

    if (filtered.length === 0) {
      entriesList.innerHTML = '';
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    entriesList.innerHTML = filtered.map(item => `
      <div class="p-4 sm:p-5 rounded-2xl bg-raised border border-border/70 hover:border-accent/40 transition-all flex items-start justify-between gap-4">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-base sm:text-lg font-bold font-heading text-primary">${escapeHtml(item.title)}</h3>
            ${item.pron ? `<span class="text-xs text-secondary italic">/${escapeHtml(item.pron)}/</span>` : ''}
            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold ${item.type === 'word' ? 'bg-emerald-500/10 text-emerald-500' : 'bg-blue-500/10 text-blue-500'}">
              ${item.type === 'word' ? 'शब्द' : 'नोट'}
            </span>
          </div>
          <p class="text-xs sm:text-sm text-secondary leading-relaxed">${escapeHtml(item.text)}</p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <button onclick="speakText('${escapeHtml(item.title)}')" class="p-2 rounded-lg bg-base border border-border text-secondary hover:text-accent hover:border-accent transition-all" title="उच्चारण सुनें">
            🔊
          </button>
          <button onclick="deleteDiaryItem('${item.id}')" class="p-2 rounded-lg bg-base border border-border text-secondary hover:text-rose-500 hover:border-rose-500/30 transition-all" title="हटाएं">
            🗑️
          </button>
        </div>
      </div>
    `).join('');
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  window.speakText = function(text) {
    if ('speechSynthesis' in window) {
      const u = new SpeechSynthesisUtterance(text);
      u.lang = 'en-US';
      window.speechSynthesis.speak(u);
    }
  };

  window.deleteDiaryItem = function(id) {
    if (!confirm('क्या आप इस नोट को डायरी से हटाना चाहते हैं?')) return;
    
    if (id.startsWith('w_')) {
      let words = JSON.parse(localStorage.getItem('ev_diary_words') || '[]');
      words = words.filter(w => 'w_' + (w.slug || w.word) !== id);
      localStorage.setItem('ev_diary_words', JSON.stringify(words));
    } else {
      let notes = JSON.parse(localStorage.getItem('ev-diary-notes') || '[]');
      notes = notes.filter(n => n.id !== id);
      localStorage.setItem('ev-diary-notes', JSON.stringify(notes));
    }
    renderDiary();
  };

  // Filter Buttons
  document.querySelectorAll('.diary-filter-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.diary-filter-pill').forEach(b => {
        b.classList.remove('active', 'bg-accent', 'text-white');
        b.classList.add('bg-raised', 'border', 'border-border', 'text-secondary');
      });
      btn.classList.add('active', 'bg-accent', 'text-white');
      btn.classList.remove('bg-raised', 'border', 'border-border', 'text-secondary');
      activeFilter = btn.dataset.filter;
      renderDiary();
    });
  });

  if (searchInput) searchInput.addEventListener('input', renderDiary);

  // Modal Actions
  if (addBtn && addModal) {
    addBtn.addEventListener('click', () => addModal.classList.remove('hidden'));
    closeBtn.addEventListener('click', () => addModal.classList.add('hidden'));
    
    submitBtn.addEventListener('click', () => {
      const title = document.getElementById('note-title-input').value.trim();
      const text = document.getElementById('note-desc-input').value.trim();
      if (!title) {
        alert('कृपया शीर्षक या शब्द दर्ज करें');
        return;
      }

      const notes = JSON.parse(localStorage.getItem('ev-diary-notes') || '[]');
      notes.unshift({
        id: 'n_' + Date.now(),
        title,
        text,
        type: 'note',
        date: new Date().toISOString()
      });
      localStorage.setItem('ev-diary-notes', JSON.stringify(notes));

      document.getElementById('note-title-input').value = '';
      document.getElementById('note-desc-input').value = '';
      addModal.classList.add('hidden');
    });
  }

  // Check login state and update sync banner
  function checkSyncState() {
    const banner = document.getElementById('diary-sync-banner');
    if (!banner) return;

    let user = null;
    try {
      user = JSON.parse(localStorage.getItem('ev_cached_user'));
    } catch(e) {}

    if (user && user.email) {
      banner.className = 'p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 mb-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs';
      banner.innerHTML = `
        <div class="flex items-center gap-2.5 text-emerald-600 dark:text-emerald-400">
          <span class="text-base">🟢</span>
          <span><strong>क्लाउड बैकअप सक्रिय (${window.escapeHTML(user.name || 'Student')}):</strong> आपके सभी शब्द और नोट्स सुरक्षित हैं।</span>
        </div>
        <button onclick="window.syncDiaryToServer && window.syncDiaryToServer().then(() => alert('क्लाउड पर नोट्स सिंक हो गए!'))" class="px-3.5 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white font-bold whitespace-nowrap transition-colors flex items-center gap-1.5">
          <span>🔄 अभी सिंक करें</span>
        </button>
      `;
      // Trigger background sync
      if (window.syncDiaryToServer) window.syncDiaryToServer().catch(() => {});
      if (window.pullDiaryFromServer) window.pullDiaryFromServer().then(renderDiary).catch(() => {});
    }
  }

  checkSyncState();
  renderDiary();
});
</script>
