---
layout: layouts/base.njk
title: My Learning Diary
permalink: /my-diary/
---

<style>
.diary-container {
  max-width: 800px;
  margin: 2rem auto;
  padding: 1rem;
  font-family: sans-serif;
}
.card {
  background: var(--bg-raised, #ffffff);
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 1rem;
  padding: 2rem;
  margin-bottom: 2rem;
  box-shadow: 0 4px 6px rgba(0,0,0,0.05);
}
.input-group {
  margin-bottom: 1rem;
}
.input-group input, .input-group textarea {
  width: 100%;
  padding: 0.75rem;
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 0.5rem;
  background: var(--bg-raised, #fff);
  color: var(--text, #333);
  font-family: inherit;
}
.pill-selector {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
}
.tag-pill {
  padding: 0.25rem 1rem;
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 9999px;
  background: var(--bg-raised, #fff);
  color: var(--text, #333);
  cursor: pointer;
  font-size: 0.875rem;
}
.tag-pill.active {
  background: var(--accent, #3b82f6);
  color: white;
  border-color: var(--accent, #3b82f6);
}
.btn-save {
  background: linear-gradient(90deg, #10b981, #059669);
  color: white;
  border: none;
  padding: 0.75rem 2rem;
  border-radius: 0.5rem;
  font-weight: bold;
  cursor: pointer;
  width: 100%;
  font-size: 1.1rem;
}
.search-bar {
  display: flex;
  gap: 1rem;
  margin-bottom: 2rem;
}
.search-bar input {
  flex: 1;
  padding: 0.75rem;
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 0.5rem;
}
.note-item {
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 0.75rem;
  padding: 1.5rem;
  margin-bottom: 1rem;
  background: var(--bg-raised, #fff);
}
.note-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}
.note-title {
  margin: 0;
  font-size: 1.25rem;
  color: var(--text, #333);
}
.note-tag {
  background: var(--accent, #3b82f6);
  color: white;
  padding: 0.2rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
}
.note-content {
  color: var(--text-muted, #666);
  white-space: pre-wrap;
}
.note-actions {
  margin-top: 1rem;
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
}
.btn-small {
  padding: 0.4rem 1rem;
  border-radius: 0.25rem;
  border: none;
  cursor: pointer;
  font-size: 0.875rem;
}
.btn-edit { background: var(--border, #e2e8f0); color: var(--text, #333); }
.btn-delete { background: #fee2e2; color: #ef4444; }
.empty-state {
  text-align: center;
  padding: 3rem;
  color: var(--text-muted, #666);
}
</style>

<div class="diary-container">
  <div class="card">
    <h2 style="margin-top:0;">📝 Add New Note</h2>
    <div class="pill-selector" id="tag-selector">
      <button class="tag-pill active" onclick="selectTag(this, 'Grammar')">Grammar</button>
      <button class="tag-pill" onclick="selectTag(this, 'Vocabulary')">Vocabulary</button>
      <button class="tag-pill" onclick="selectTag(this, 'Class 10')">Class 10</button>
      <button class="tag-pill" onclick="selectTag(this, 'Class 12')">Class 12</button>
      <button class="tag-pill" onclick="selectTag(this, 'General')">General</button>
    </div>
    <div class="input-group">
      <input type="text" id="note-title" placeholder="Note Title...">
    </div>
    <div class="input-group">
      <textarea id="note-content" rows="4" placeholder="अपने नोट्स यहाँ लिखें..."></textarea>
    </div>
    <button class="btn-save" onclick="saveNote()">Save Note</button>
  </div>

  <div class="search-bar">
    <input type="text" id="search-input" placeholder="Search notes..." onkeyup="renderNotes()">
    <button class="btn-edit" onclick="exportNotes()">Export</button>
  </div>

  <div id="notes-list">
    <!-- Rendered via JS -->
  </div>
</div>

<script>
let currentTag = 'Grammar';
let editingId = null;

function selectTag(btn, tag) {
  document.querySelectorAll('#tag-selector .tag-pill').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  currentTag = tag;
}

function getNotes() {
  const notes = localStorage.getItem('ev-diary-notes');
  return notes ? JSON.parse(notes) : [];
}

function saveNote() {
  const title = document.getElementById('note-title').value.trim();
  const content = document.getElementById('note-content').value.trim();
  if (!title || !content) {
    if (window.showToast) window.showToast('Please fill all fields');
    return;
  }

  const notes = getNotes();
  if (editingId) {
    const idx = notes.findIndex(n => n.id === editingId);
    if (idx > -1) {
      notes[idx].title = title;
      notes[idx].content = content;
      notes[idx].tag = currentTag;
      notes[idx].updatedAt = new Date().toISOString();
    }
    editingId = null;
  } else {
    notes.unshift({
      id: Date.now().toString(),
      title,
      content,
      tag: currentTag,
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString()
    });
  }

  localStorage.setItem('ev-diary-notes', JSON.stringify(notes));
  
  document.getElementById('note-title').value = '';
  document.getElementById('note-content').value = '';
  if (window.showToast) window.showToast('Note saved!');
  renderNotes();
}

function renderNotes() {
  const list = document.getElementById('notes-list');
  const query = document.getElementById('search-input').value.toLowerCase();
  const notes = getNotes().filter(n => 
    n.title.toLowerCase().includes(query) || 
    n.content.toLowerCase().includes(query)
  );

  if (notes.length === 0) {
    list.innerHTML = \`
      <div class="empty-state">
        <div style="font-size: 3rem; margin-bottom: 1rem;">📓</div>
        <h3>Start writing your first note!</h3>
      </div>
    \`;
    return;
  }

  list.innerHTML = notes.map(n => \`
    <div class="note-item">
      <div class="note-header">
        <h3 class="note-title">\${n.title}</h3>
        <span class="note-tag">\${n.tag}</span>
      </div>
      <div class="note-content">\${n.content}</div>
      <div style="font-size: 0.75rem; color: var(--border, #ccc); margin-top: 1rem;">
        \${new Date(n.createdAt).toLocaleString()}
      </div>
      <div class="note-actions">
        <button class="btn-small btn-edit" onclick="editNote('\${n.id}')">Edit</button>
        <button class="btn-small btn-delete" onclick="deleteNote('\${n.id}')">Delete</button>
      </div>
    </div>
  \`).join('');
}

function deleteNote(id) {
  if (confirm('Delete this note?')) {
    let notes = getNotes();
    notes = notes.filter(n => n.id !== id);
    localStorage.setItem('ev-diary-notes', JSON.stringify(notes));
    if (window.showToast) window.showToast('Note deleted');
    renderNotes();
  }
}

function editNote(id) {
  const notes = getNotes();
  const note = notes.find(n => n.id === id);
  if (note) {
    document.getElementById('note-title').value = note.title;
    document.getElementById('note-content').value = note.content;
    currentTag = note.tag;
    document.querySelectorAll('#tag-selector .tag-pill').forEach(p => {
      if(p.textContent === note.tag) p.classList.add('active');
      else p.classList.remove('active');
    });
    editingId = id;
    window.scrollTo({top: 0, behavior: 'smooth'});
  }
}

function exportNotes() {
  const data = localStorage.getItem('ev-diary-notes') || '[]';
  const blob = new Blob([data], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'my-notes.json';
  a.click();
  URL.revokeObjectURL(url);
}

document.addEventListener('DOMContentLoaded', renderNotes);
</script>
