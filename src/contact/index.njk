<script>
let currentUser = null;

document.addEventListener('DOMContentLoaded', async () => {
  try {
    const cached = localStorage.getItem('ev_cached_user');
    if (cached) currentUser = JSON.parse(cached);
  } catch(e) {}

  const guestNotice = document.getElementById('contact-guest-notice');
  const nameInput = document.getElementById('f-name');
  const emailInput = document.getElementById('f-email');

  if (currentUser && currentUser.email) {
    if (nameInput) nameInput.value = currentUser.name || '';
    if (emailInput) emailInput.value = currentUser.email || '';
    loadUserTickets();
  } else {
    // Check with live server
    try {
      const res = await fetch('/api/auth-me?_t=' + Date.now());
      if (res.ok) {
        const data = await res.json();
        if (data.loggedIn && data.user) {
          currentUser = data.user;
          if (nameInput) nameInput.value = currentUser.name || '';
          if (emailInput) emailInput.value = currentUser.email || '';
          loadUserTickets();
        } else {
          if (guestNotice) guestNotice.classList.remove('hidden');
        }
      } else {
        if (guestNotice) guestNotice.classList.remove('hidden');
      }
    } catch(err) {
      if (guestNotice) guestNotice.classList.remove('hidden');
    }
  }
});

async function submitTicket(e) {
  e.preventDefault();
  const btn = document.getElementById('submit-btn');
  const spinner = document.getElementById('btn-spinner');

  const name = document.getElementById('f-name').value.trim();
  const email = document.getElementById('f-email').value.trim();
  const subject = document.getElementById('f-subject').value;
  const message = document.getElementById('f-msg').value.trim();

  if (!currentUser || !currentUser.email) {
    alert('सपोर्ट टिकट दर्ज करने के लिए कृपया पहले Google से लॉगिन करें।');
    window.location.href = '/login/?redirect=/contact/';
    return;
  }

  btn.disabled = true;
  if (spinner) spinner.classList.remove('hidden');

  try {
    const res = await fetch('/api/support-ticket', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        title: subject + (name ? ` (द्वारा: ${name})` : ''),
        message: message,
        type: 'admin'
      })
    });

    const data = await res.json().catch(() => ({}));
    if (res.ok && data.success) {
      document.getElementById('form-container').classList.add('hidden');
      document.getElementById('success-container').classList.remove('hidden');
      document.getElementById('submitted-ticket-id').textContent = '#' + (data.ticketId || 'EV');
      if (window.showToast) window.showToast('टिकट सफलतापूर्वक सबमिट हो गया! 🎟️');
      loadUserTickets();
    } else {
      alert(data.error || 'टिकट सबमिट करने में समस्या आई। कृपया पुनः प्रयास करें।');
    }
  } catch (err) {
    alert('नेटवर्क समस्या। कृपया इंटरनेट कनेक्शन जांचें।');
  } finally {
    btn.disabled = false;
    if (spinner) spinner.classList.add('hidden');
  }
}

function resetContactForm() {
  document.getElementById('contact-form').reset();
  if (currentUser) {
    document.getElementById('f-name').value = currentUser.name || '';
    document.getElementById('f-email').value = currentUser.email || '';
  }
  document.getElementById('form-container').classList.remove('hidden');
  document.getElementById('success-container').classList.add('hidden');
}

async function loadUserTickets() {
  const section = document.getElementById('user-tickets-section');
  const list = document.getElementById('user-tickets-list');
  if (!section || !list) return;

  try {
    const res = await fetch('/api/support-ticket');
    if (!res.ok) return;
    const tickets = await res.json();

    if (Array.isArray(tickets) && tickets.length > 0) {
      section.classList.remove('hidden');
      list.innerHTML = tickets.map(t => {
        const isResolved = t.status === 'resolved' || t.status === 'closed';
        const badgeClass = isResolved ? 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20' : 'bg-amber-500/10 text-amber-500 border-amber-500/20';
        const statusText = t.status === 'resolved' ? 'हल किया गया (Resolved)' : (t.status === 'closed' ? 'बंद (Closed)' : 'प्रक्रियाधीन (Open)');
        const dateStr = t.created_at ? new Date(t.created_at).toLocaleDateString('hi-IN') : '';

        return `
          <div class="p-4 rounded-2xl bg-base border border-border flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="font-bold text-sm text-primary">${window.escapeHTML ? window.escapeHTML(t.title) : t.title}</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ${badgeClass}">${statusText}</span>
              </div>
              <p class="text-xs text-secondary line-clamp-1">${window.escapeHTML ? window.escapeHTML(t.message) : t.message}</p>
            </div>
            <div class="text-[11px] text-secondary shrink-0">${dateStr}</div>
          </div>
        `;
      }).join('');
    }
  } catch(e) {}
}
</script>
