<style>
.contact-container {
  max-width: 900px;
  margin: 2rem auto;
  padding: 1rem;
  font-family: sans-serif;
}
.hero {
  background: linear-gradient(135deg, var(--accent, #3b82f6), #8b5cf6);
  color: white;
  padding: 3rem 1rem;
  border-radius: 1rem;
  text-align: center;
  margin-bottom: 2rem;
}
.hero h1 { margin: 0; font-size: 2.5rem; }
.quick-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;
  margin-bottom: 3rem;
}
.q-card {
  background: var(--bg-raised, #ffffff);
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 0.75rem;
  padding: 1.5rem;
  text-align: center;
  box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  text-decoration: none;
  color: var(--text, #333);
  transition: transform 0.2s;
}
.q-card:hover {
  transform: translateY(-5px);
  border-color: var(--accent, #3b82f6);
}
.q-card .icon { font-size: 2rem; margin-bottom: 0.5rem; }
.form-section {
  background: var(--bg-raised, #ffffff);
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 1rem;
  padding: 2rem;
  margin-bottom: 3rem;
  box-shadow: 0 4px 6px rgba(0,0,0,0.05);
}
.form-group { margin-bottom: 1rem; }
.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: bold;
  color: var(--text, #333);
}
.form-group input, .form-group select, .form-group textarea {
  width: 100%;
  padding: 0.75rem;
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 0.5rem;
  background: var(--bg-raised, #fff);
  color: var(--text, #333);
  font-family: inherit;
}
.btn-submit {
  background: var(--accent, #3b82f6);
  color: white;
  border: none;
  padding: 1rem 2rem;
  border-radius: 0.5rem;
  font-weight: bold;
  font-size: 1.1rem;
  cursor: pointer;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.5rem;
}
.faq-item {
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 0.5rem;
  margin-bottom: 1rem;
  overflow: hidden;
}
.faq-q {
  background: var(--bg-raised, #f8fafc);
  padding: 1rem;
  font-weight: bold;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  color: var(--text, #333);
}
.faq-a {
  padding: 1rem;
  background: var(--bg-raised, #fff);
  display: none;
  color: var(--text-muted, #666);
}
.faq-item.active .faq-a { display: block; }
.faq-item.active .faq-q { border-bottom: 1px solid var(--border, #e2e8f0); }
.success-card {
  text-align: center;
  padding: 3rem 1rem;
  display: none;
}
.loader {
  border: 3px solid #f3f3f3;
  border-top: 3px solid white;
  border-radius: 50%;
  width: 20px;
  height: 20px;
  animation: spin 1s linear infinite;
  display: none;
}
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
</style>

<div class="contact-container">
  <div class="hero">
    <h1>🎧 Contact & Help Center</h1>
    <p>We're here to help you master English!</p>
  </div>

  <div class="quick-cards">
    <a href="mailto:englishvidyahq@gmail.com" class="q-card">
      <div class="icon">📧</div>
      <h3>Email</h3>
      <p>englishvidyahq@gmail.com</p>
    </a>
    <a href="https://wa.me/917070133396" target="_blank" class="q-card">
      <div class="icon">💬</div>
      <h3>WhatsApp</h3>
      <p>+917070133396</p>
    </a>
    <a href="https://youtube.com/@englishvidyahq" target="_blank" class="q-card">
      <div class="icon">📱</div>
      <h3>YouTube</h3>
      <p>@englishvidyahq</p>
    </a>
  </div>

  <div class="form-section" id="form-container">
    <h2>Send us a message</h2>
    <form id="contact-form" onsubmit="submitForm(event)">
      <div class="form-group">
        <label>Name</label>
        <input type="text" id="f-name" required>
      </div>
      <div class="form-group">
        <label>Email</label>
        <input type="email" id="f-email" required>
      </div>
      <div class="form-group">
        <label>Subject</label>
        <select id="f-subject">
          <option>General</option>
          <option>Grammar Question</option>
          <option>Technical Issue</option>
          <option>Feedback</option>
          <option>Suggest a Word</option>
        </select>
      </div>
      <div class="form-group">
        <label>Message</label>
        <textarea id="f-msg" rows="5" required></textarea>
      </div>
      <button type="submit" class="btn-submit" id="submit-btn">
        <span>Send Message</span>
        <div class="loader" id="spinner"></div>
      </button>
    </form>
  </div>

  <div class="success-card form-section" id="success-container">
    <div style="font-size: 4rem; margin-bottom: 1rem;">✅</div>
    <h2>Thank You!</h2>
    <p>Your message has been sent. We will contact you soon.</p>
    <button class="btn-submit" style="width: auto; margin: 1rem auto;" onclick="resetForm()">Send Another</button>
  </div>

  <div style="margin-bottom: 2rem;">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item" onclick="this.classList.toggle('active')">
      <div class="faq-q"><span>Grammar कैसे सीखें?</span> <span>▼</span></div>
      <div class="faq-a">हमारे Grammar section से शुरुआत करें, जहाँ हमने basics से advanced तक सब cover किया है।</div>
    </div>
    <div class="faq-item" onclick="this.classList.toggle('active')">
      <div class="faq-q"><span>क्या यह website free है?</span> <span>▼</span></div>
      <div class="faq-a">हाँ, अधिकांश content बिल्कुल मुफ़्त है!</div>
    </div>
    <div class="faq-item" onclick="this.classList.toggle('active')">
      <div class="faq-q"><span>Bihar Board 2025 की तैयारी कैसे करें?</span> <span>▼</span></div>
      <div class="faq-a">Class 10 और 12 sections देखें, जहाँ board exams के लिए special notes हैं।</div>
    </div>
    <div class="faq-item" onclick="this.classList.toggle('active')">
      <div class="faq-q"><span>Dictionary में नया शब्द कैसे जोड़वाएं?</span> <span>▼</span></div>
      <div class="faq-a">Contact form में 'Suggest a Word' चुनें या WhatsApp पर भेजें।</div>
    </div>
    <div class="faq-item" onclick="this.classList.toggle('active')">
      <div class="faq-q"><span>Certificate कब मिलेगा?</span> <span>▼</span></div>
      <div class="faq-a">Quiz scores और progress track करने पर certificate coming soon!</div>
    </div>
  </div>
</div>

<script>
const SHEET_WEBHOOK = ''; // Empty by default

async function submitForm(e) {
  e.preventDefault();
  const btn = document.getElementById('submit-btn');
  const spinner = document.getElementById('spinner');
  
  btn.disabled = true;
  spinner.style.display = 'block';

  const payload = {
    name: document.getElementById('f-name').value,
    email: document.getElementById('f-email').value,
    subject: document.getElementById('f-subject').value,
    message: document.getElementById('f-msg').value
  };

  try {
    if (SHEET_WEBHOOK) {
      await fetch(SHEET_WEBHOOK, {
        method: 'POST',
        body: JSON.stringify(payload),
        headers: { 'Content-Type': 'application/json' }
      });
    } else {
      // Simulate network
      await new Promise(r => setTimeout(r, 1000));
    }
    
    document.getElementById('form-container').style.display = 'none';
    document.getElementById('success-container').style.display = 'block';
    if (window.showToast) window.showToast('Message sent successfully!');
  } catch(err) {
    if (window.showToast) window.showToast('Error sending message');
  } finally {
    btn.disabled = false;
    spinner.style.display = 'none';
  }
}

function resetForm() {
  document.getElementById('contact-form').reset();
  document.getElementById('form-container').style.display = 'block';
  document.getElementById('success-container').style.display = 'none';
}
</script>
