---
layout: layouts/base.njk
pageTitle: "Help & Support - EnglishVidya"
metaDescription: "Contact EnglishVidya support team or submit a direct query to Master Manikant."
permalink: /contact/
---



<div class="support-container">
  <h1 class="support-title">Help & Support</h1>
  <p class="support-subtitle">सहायता और शिकायत केंद्र - हम आपकी पूरी मदद करेंगे।</p>

  <div id="unauth-view" style="display: none;">
    <!-- WhatsApp for guest users -->
    <div class="support-card">
      <div style="background: rgba(99,102,241,0.05); border: 1px solid rgba(99,102,241,0.15); padding: 15px; border-radius: 8px; margin-bottom: 25px; text-align: center;">
        <p style="margin: 0; font-size: 0.95rem;">
          🔑 <strong>In-App Support Ticket Desk:</strong> Please <a href="/login/" style="color: var(--accent); font-weight: bold;">Log In</a> to submit official tickets and track replies inside your dashboard.
        </p>
      </div>
      
      <h3 style="margin-top: 0; text-align: center;">Or Send a Message on WhatsApp</h3>
      <p style="text-align: center; color: var(--text-secondary); margin-bottom: 25px;">
        (अथवा व्हाट्सएप के माध्यम से सीधे संपर्क करें)
      </p>

      <form id="waForm">
        <div class="form-group">
          <label for="wa-name">Your Name (आपका नाम)</label>
          <input type="text" id="wa-name" required placeholder="Enter your name">
        </div>
        
        <div class="form-group">
          <label for="wa-purpose">Purpose (उद्देश्य)</label>
          <input type="text" id="wa-purpose" required placeholder="e.g., Grammar Doubt, Suggestion">
        </div>

        <div class="form-group">
          <label for="wa-message">Message (आपका संदेश)</label>
          <textarea id="wa-message" rows="5" required placeholder="Type your message here..."></textarea>
        </div>

        <button type="submit" class="btn-whatsapp">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/></svg>
          Send via WhatsApp
        </button>
      </form>
    </div>
  </div>

  <div id="auth-view" style="display: none;">
    <!-- In-app support dashboard -->
    <div class="support-card">
      <div class="support-tabs">
        <button class="support-tab-btn active" id="tab-create" onclick="switchSupportTab('create')">🆕 Create Ticket (नई शिकायत)</button>
        <button class="support-tab-btn" id="tab-list" onclick="switchSupportTab('list')">📁 My Tickets (मेरी शिकायतें)</button>
      </div>

      <!-- Create Ticket Pane -->
      <div id="pane-create">
        <form id="ticketForm">
          <div class="form-group">
            <label for="ticket-title">Topic / Subject (विषय)</label>
            <input type="text" id="ticket-title" required placeholder="e.g., Problem with Login, Spelling Error in Grammar lesson">
          </div>

          <div class="form-group">
            <label for="ticket-route">Route Complaint To (शिकायत किसे भेजनी है?)</label>
            <select id="ticket-route" required>
              <option value="admin">Complain to Admin (वेबसाइट/सहायक टीम को शिकायत)</option>
              <option value="owner">Complain to Owner (सीधा ओनर/मास्टर मणिकांत को शिकायत - Confidential)</option>
            </select>
            <p style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 5px;">
              * Owner route complaints will only be seen by the platform owner. (ओनर को भेजी गई शिकायतें सिर्फ़ मुख्य ओनर ही देख सकते हैं)
            </p>
          </div>

          <div class="form-group">
            <label for="ticket-message">Describe your issue in detail (अपनी समस्या विस्तार से लिखें)</label>
            <textarea id="ticket-message" rows="6" required placeholder="Type your complaint here..."></textarea>
          </div>

          <button type="submit" class="btn-submit">Submit Support Ticket (शिकायत दर्ज करें)</button>
        </form>
      </div>

      <!-- Ticket List Pane -->
      <div id="pane-list" style="display: none;">
        <div id="tickets-list-container">
          <!-- Tickets load here -->
        </div>
      </div>

      <!-- Ticket Detail Thread View Pane -->
      <div id="pane-detail" class="ticket-detail-view">
        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border-color); padding-bottom:10px;">
          <button onclick="switchSupportTab('list')" style="background:none; border:none; color:var(--accent); font-weight:bold; cursor:pointer; font-size:0.95rem;">&larr; Back to List</button>
          <span class="badge" id="detail-status-badge">Open</span>
        </div>
        
        <div>
          <h3 id="detail-title" style="margin: 0 0 8px 0;">Ticket Title</h3>
          <p id="detail-initial-message" style="margin: 0; background:rgba(0,0,0,0.1); padding:12px; border-radius:6px; font-size:0.95rem; line-height:1.4;">Initial Message</p>
        </div>

        <div style="display:flex; flex-direction:column; gap:12px; max-height: 350px; overflow-y:auto; padding-right:5px;" id="detail-replies">
          <!-- Replies load here -->
        </div>

        <div style="border-top: 1px solid var(--border-color); padding-top: 15px;" id="reply-form-container">
          <div class="form-group" style="margin-bottom:10px;">
            <label for="detail-reply-text">Post a Reply (अपना जवाब लिखें)</label>
            <textarea id="detail-reply-text" rows="3" required placeholder="Type reply here..."></textarea>
          </div>
          <button onclick="submitUserReply()" class="btn-submit" style="width:auto; float:right;">Send Reply</button>
          <div style="clear:both;"></div>
        </div>
      </div>
    </div>
  </div>

  {# Direct Support Fallback (WhatsApp / Email) #}
  <div class="support-card" style="margin-top: 24px; padding: 20px; background: rgba(99, 102, 241, 0.03); border: 1px dashed var(--border-color); text-align: center;">
    <h3 style="margin-top: 0; font-size: 1.1rem; color: var(--text-main);">📞 Direct Support (सीधा संपर्क)</h3>
    <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 16px;">
      अगर आपको टिकट का जवाब मिलने में देरी हो रही है, तो आप हमें सीधे ईमेल या व्हाट्सएप पर मैसेज कर सकते हैं:
    </p>
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <a href="https://wa.me/917070133396" target="_blank" rel="noopener noreferrer" class="btn-whatsapp" style="width: auto; padding: 8px 16px; font-size: 0.9rem; text-decoration: none;">
        💬 WhatsApp: +91 70701 33396
      </a>
      <a href="mailto:{{ site.email }}" class="btn-secondary" style="width: auto; padding: 8px 16px; font-size: 0.9rem; text-decoration: none; display: flex; align-items: center; gap: 6px; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: transparent; color: var(--text-main); font-weight: bold; cursor: pointer;" onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background='transparent'">
        ✉️ Email: {{ site.email }}
      </a>
    </div>
  </div>
</div>

<script>
let loggedInUser = null;
let activeTicket = null;

document.addEventListener('DOMContentLoaded', async () => {
  // Check auth
  try {
    const res = await fetch('/api/auth-me');
    const data = await res.json();
    if (data.loggedIn) {
      loggedInUser = data.user;
      document.getElementById('auth-view').style.display = 'block';
    } else {
      document.getElementById('unauth-view').style.display = 'block';
    }
  } catch (e) {
    document.getElementById('unauth-view').style.display = 'block';
  }
});

// Guest View WhatsApp Logic
document.getElementById('waForm').addEventListener('submit', function(e) {
  e.preventDefault();
  const name = document.getElementById('wa-name').value;
  const purpose = document.getElementById('wa-purpose').value;
  const message = document.getElementById('wa-message').value;
  
  const waNumber = '917070133396';
  const waText = `*Hello EnglishVidya Team!*%0A%0A*Name:* ${name}%0A*Purpose:* ${purpose}%0A*Message:* ${message}`;
  window.open(`https://wa.me/${waNumber}?text=${waText}`, '_blank');
});

// Support tab switcher
function switchSupportTab(tabName) {
  document.getElementById('tab-create').classList.remove('active');
  document.getElementById('tab-list').classList.remove('active');
  
  document.getElementById('pane-create').style.display = 'none';
  document.getElementById('pane-list').style.display = 'none';
  document.getElementById('pane-detail').style.display = 'none';

  if (tabName === 'create') {
    document.getElementById('tab-create').classList.add('active');
    document.getElementById('pane-create').style.display = 'block';
  } else if (tabName === 'list') {
    document.getElementById('tab-list').classList.add('active');
    document.getElementById('pane-list').style.display = 'block';
    loadUserTickets();
  }
}

// Submit Ticket Form
document.getElementById('ticketForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const title = document.getElementById('ticket-title').value.trim();
  const type = document.getElementById('ticket-route').value;
  const message = document.getElementById('ticket-message').value.trim();

  try {
    const res = await fetch('/api/support-ticket', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ title, type, message })
    });

    if (res.ok) {
      alert('Support ticket submitted successfully! (आपकी शिकायत दर्ज हो गई है)');
      document.getElementById('ticketForm').reset();
      switchSupportTab('list');
    } else {
      const errText = await res.text();
      alert('Failed to submit: ' + errText);
    }
  } catch (e) {
    alert('Error submitting ticket.');
  }
});

// Load user tickets
async function loadUserTickets() {
  const container = document.getElementById('tickets-list-container');
  container.innerHTML = '<p style="color:var(--text-secondary);">Loading tickets...</p>';
  try {
    const res = await fetch('/api/support-ticket');
    if (!res.ok) throw new Error();
    const data = await res.json();

    if (data.length === 0) {
      container.innerHTML = '<p style="color:var(--text-secondary); text-align:center; margin-top:20px;">You have not submitted any support tickets. (कोई शिकायत रिकॉर्ड नहीं है)</p>';
      return;
    }

    container.innerHTML = data.map(t => {
      const date = new Date(t.created_at).toLocaleDateString();
      const statusBadge = `<span class="badge badge-${t.status}">${t.status}</span>`;
      return `
        <div class="ticket-item" onclick="viewTicketDetails(${t.id})">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
            <strong style="font-size:1.05rem; color:var(--text-main);">${t.title}</strong>
            ${statusBadge}
          </div>
          <div style="display:flex; justify-content:space-between; font-size:0.8rem; color:var(--text-secondary);">
            <span>Sent to: <span style="text-transform:uppercase; font-weight:bold;">${t.type}</span></span>
            <span>Date: ${date}</span>
          </div>
        </div>
      `;
    }).join('');
  } catch (e) {
    container.innerHTML = '<p style="color:var(--error);">Failed to load support history.</p>';
  }
}

// View ticket details
async function viewTicketDetails(ticketId) {
  document.getElementById('pane-create').style.display = 'none';
  document.getElementById('pane-list').style.display = 'none';
  document.getElementById('pane-detail').style.display = 'flex';

  const replyTextarea = document.getElementById('detail-reply-text');
  const repliesContainer = document.getElementById('detail-replies');
  replyTextarea.value = '';
  repliesContainer.innerHTML = '<p style="color:var(--text-secondary);">Loading conversation...</p>';

  try {
    const res = await fetch(`/api/support-ticket?ticket_id=${ticketId}`);
    if (!res.ok) throw new Error();
    const data = await res.json();
    
    activeTicket = data.ticket;
    
    document.getElementById('detail-title').innerText = activeTicket.title;
    document.getElementById('detail-initial-message').innerText = activeTicket.message;
    document.getElementById('detail-status-badge').className = `badge badge-${activeTicket.status}`;
    document.getElementById('detail-status-badge').innerText = activeTicket.status.toUpperCase();

    // Disable reply form if ticket is closed
    if (activeTicket.status === 'closed') {
      document.getElementById('reply-form-container').style.display = 'none';
    } else {
      document.getElementById('reply-form-container').style.display = 'block';
    }

    if (data.replies.length === 0) {
      repliesContainer.innerHTML = '<p style="color:var(--text-secondary); text-align:center; font-style:italic; margin-top:20px;">Waiting for a staff response... (जवाब की प्रतीक्षा है)</p>';
      return;
    }

    repliesContainer.innerHTML = data.replies.map(r => {
      const isStaff = r.role === 'admin' || r.role === 'owner';
      const bubbleClass = isStaff ? 'staff' : 'user';
      const senderName = isStaff ? `${r.name} (Support Team)` : 'You';
      const date = new Date(r.created_at).toLocaleString();
      
      return `
        <div class="message-bubble ${bubbleClass}">
          <div style="font-size:0.75rem; opacity:0.8; margin-bottom:4px; font-weight:bold;">${senderName}</div>
          <div>${r.reply_text}</div>
          <div style="font-size:0.65rem; opacity:0.6; text-align:right; margin-top:4px;">${date}</div>
        </div>
      `;
    }).join('');

    repliesContainer.scrollTop = repliesContainer.scrollHeight;
  } catch (e) {
    repliesContainer.innerHTML = '<p style="color:var(--error);">Failed to load ticket details.</p>';
  }
}

async function submitUserReply() {
  const replyText = document.getElementById('detail-reply-text').value.trim();
  if (!replyText || !activeTicket) return;

  try {
    const res = await fetch('/api/support-reply', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ ticket_id: activeTicket.id, reply_text: replyText })
    });

    if (res.ok) {
      viewTicketDetails(activeTicket.id);
    } else {
      alert('Failed to send reply.');
    }
  } catch (e) {
    alert('Error sending reply.');
  }
}
</script>
