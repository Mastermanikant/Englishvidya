            <label class="form-label" for="user-phone">Mobile / WhatsApp Number</label>
            <input type="tel" id="user-phone" name="phone" class="form-input" placeholder="+91 XXXXX XXXXX" />
          </div>

          <div class="form-group">
            <label class="form-label" for="user-message">Your Message / Doubt / Feedback *</label>
            <textarea id="user-message" name="message" class="form-textarea" placeholder="Apna sawaal ya sujhav yahan likhein..." required></textarea>
