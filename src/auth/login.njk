---
layout: layouts/base.njk
pageTitle: "Login to EnglishVidya"
metaDescription: "Login to EnglishVidya to save your progress, add words to your diary, and participate in community discussions."
permalink: /login/
---

<div class="auth-container">
  <h1 class="auth-title">Login or Sign Up</h1>
  <p class="auth-desc">Continue with Google to start your learning journey and save your progress.</p>
  
  <a id="google-login-btn" href="/api/auth-google" class="btn-primary auth-google-btn">
    <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
      <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
      <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
      <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
    </svg>
    Continue with Google
  </a>

  <div class="auth-legal-text" style="margin-top: 30px;">
    अकाउंट बनाने या लॉगिन करने का मतलब है कि आप हमारी <a href="/legal-hindi/" style="color: var(--accent);">नियम और शर्तों (Legal Terms)</a> को स्वीकार करते हैं।
  </div>


</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const urlParams = new URLSearchParams(window.location.search);
  const redirect = urlParams.get('redirect') || '/profile/';
  
  // Google button redirect
  const googleBtn = document.getElementById('google-login-btn');
  if (googleBtn) {
    googleBtn.href = '/api/auth-google?redirect=' + encodeURIComponent(redirect);
    
    googleBtn.addEventListener('click', function() {
      this.style.opacity = '0.7';
      this.style.pointerEvents = 'none';
      this.innerHTML = '⏳ Redirecting to Google...';
    });
  }
});
</script>
