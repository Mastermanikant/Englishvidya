---
layout: layouts/base.njk
pageTitle: "Owner Headquarters"
metaDescription: "Restricted Access."
permalink: /iamkingoev/
---

<div class="auth-container" style="max-width: 400px; margin: 40px auto; padding: 30px; background: var(--bg-raised); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); text-align: center;">
  <h1 style="font-family: var(--font-heading); margin-bottom: 10px; color: var(--accent);">Owner HQ</h1>
  <p style="color: var(--text-secondary); margin-bottom: 30px;">Restricted Access Area.</p>
  
  <form action="/api/auth-custom" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
    <input type="text" name="username" placeholder="Username" autocomplete="off" required style="padding: 12px; border-radius: var(--radius-md); border: 1px solid var(--border-color); background: var(--bg-body); color: var(--text-main); font-size: 1rem;">
    <input type="password" name="password" placeholder="Password" autocomplete="off" required style="padding: 12px; border-radius: var(--radius-md); border: 1px solid var(--border-color); background: var(--bg-body); color: var(--text-main); font-size: 1rem;">
    <input type="hidden" name="redirect_to" value="/admin/">
    
    <button type="submit" class="btn-primary" style="padding: 12px; border-radius: var(--radius-md); font-weight: bold; font-size: 1.1rem; border: none; cursor: pointer; background: var(--accent); color: white;">
      Enter Headquarters
    </button>
  </form>
</div>
