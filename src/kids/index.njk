<style>
  .kids-hero {
    background: linear-gradient(135deg, #fce7f3, #dbeafe);
    border-radius: var(--radius-lg);
    padding: var(--sp-12) var(--sp-6);
    text-align: center;
    margin-bottom: var(--sp-12);
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
  }
  .kids-hero h1 {
    font-size: 3rem;
    color: #4f46e5;
    text-shadow: 2px 2px 0px #fff;
    margin-bottom: var(--sp-4);
  }
  .bounce-emoji {
    display: inline-block;
    animation: bounce 2s infinite;
  }
  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-20px); }
    60% { transform: translateY(-10px); }
  }
  
  .alphabet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--sp-6);
    margin-bottom: var(--sp-12);
  }
  .letter-card {
    background: white;
    border-radius: 20px;
    padding: var(--sp-6);
    text-align: center;
    cursor: pointer;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    border: 3px solid transparent;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  .letter-card:hover {
    transform: translateY(-8px) scale(1.05);
    box-shadow: 0 12px 20px rgba(0,0,0,0.15);
  }
  .letter-card:active {
    transform: translateY(0) scale(0.95);
  }
  
  .l-char { font-size: 4rem; font-weight: 900; line-height: 1; margin-bottom: var(--sp-2); }
  .l-emoji { font-size: 3rem; margin-bottom: var(--sp-2); }
  .l-en { font-size: 1.2rem; font-weight: bold; color: var(--text-primary); }
  .l-hi { font-size: 1rem; color: var(--text-secondary); margin-top: 4px; }
  
  .quiz-section {
    background: linear-gradient(135deg, #fffbeb, #fef3c7);
    border-radius: var(--radius-lg);
    padding: var(--sp-8);
    text-align: center;
    border: 2px dashed #f59e0b;
    margin-bottom: var(--sp-12);
  }
  .quiz-emoji { font-size: 5rem; margin-bottom: var(--sp-6); }
  .quiz-options {
    display: flex;
    justify-content: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .quiz-btn {
    background: white;
    border: 2px solid #f59e0b;
    border-radius: var(--radius-lg);
    padding: var(--sp-4) var(--sp-8);
    font-size: 1.5rem;
    font-weight: bold;
    color: #b45309;
    cursor: pointer;
    transition: all 0.2s;
  }
  .quiz-btn:hover { background: #f59e0b; color: white; transform: scale(1.1); }
  .quiz-btn.correct { background: #22c55e; border-color: #22c55e; color: white; animation: pulse 1s; }
  .quiz-btn.wrong { background: #ef4444; border-color: #ef4444; color: white; animation: shake 0.5s; }
  
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(34,197,94,0.7); } 70% { box-shadow: 0 0 0 15px rgba(34,197,94,0); } 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); } }
  @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-10px); } 75% { transform: translateX(10px); } }

  .star-anim {
    position: absolute; font-size: 3rem; pointer-events: none; opacity: 0;
    transition: all 1s ease-out;
  }
</style>

<div class="kids-hero animate-fade-in">
  <h1>🧒 Kids English Learning <span class="bounce-emoji">🎈</span></h1>
  <p style="font-size: 1.2rem; color: #4b5563;">Learn ABCs with fun pictures and sounds! Click on any card to hear it.</p>
</div>

<div class="alphabet-grid animate-fade-in" id="abc-grid">
  <!-- Generated by JS -->
</div>

<div class="quiz-section animate-fade-in" id="quiz-area">
  <h2 style="color: #b45309; font-size: 2rem; margin-bottom: var(--sp-4);">Quiz Time! 🎯</h2>
  <p style="margin-bottom: var(--sp-6);">Which letter does this start with?</p>
  <div class="quiz-emoji" id="q-emoji">🍎</div>
  <div class="quiz-options" id="q-options">
    <!-- Buttons generated by JS -->
  </div>
</div>

<script>
  const ALPHABET = [
    {l:'A', en:'Apple', hi:'सेब', e:'🍎', c:'#ef4444'},
    {l:'B', en:'Ball', hi:'गेंद', e:'⚽', c:'#3b82f6'},
    {l:'C', en:'Cat', hi:'बिल्ली', e:'🐱', c:'#f59e0b'},
    {l:'D', en:'Dog', hi:'कुत्ता', e:'🐶', c:'#8b5cf6'},
    {l:'E', en:'Elephant', hi:'हाथी', e:'🐘', c:'#6b7280'},
    {l:'F', en:'Fish', hi:'मछली', e:'🐟', c:'#06b6d4'},
    {l:'G', en:'Goat', hi:'बकरी', e:'🐐', c:'#84cc16'},
    {l:'H', en:'House', hi:'घर', e:'🏠', c:'#ea580c'},
    {l:'I', en:'Ice cream', hi:'आइसक्रीम', e:'🍦', c:'#ec4899'},
    {l:'J', en:'Jar', hi:'जार', e:'🫙', c:'#6366f1'},
    {l:'K', en:'Kite', hi:'पतंग', e:'🪁', c:'#10b981'},
    {l:'L', en:'Lion', hi:'शेर', e:'🦁', c:'#f59e0b'},
    {l:'M', en:'Mango', hi:'आम', e:'🥭', c:'#eab308'},
    {l:'N', en:'Nest', hi:'घोंसला', e:'🪺', c:'#a8a29e'},
    {l:'O', en:'Orange', hi:'संतरा', e:'🍊', c:'#f97316'},
    {l:'P', en:'Parrot', hi:'तोता', e:'🦜', c:'#22c55e'},
    {l:'Q', en:'Queen', hi:'रानी', e:'👑', c:'#d946ef'},
    {l:'R', en:'Rainbow', hi:'इंद्रधनुष', e:'🌈', c:'#ec4899'},
    {l:'S', en:'Sun', hi:'सूरज', e:'☀️', c:'#eab308'},
    {l:'T', en:'Tiger', hi:'बाघ', e:'🐯', c:'#f97316'},
    {l:'U', en:'Umbrella', hi:'छाता', e:'☂️', c:'#8b5cf6'},
    {l:'V', en:'Violin', hi:'वायलिन', e:'🎻', c:'#a855f7'},
    {l:'W', en:'Water', hi:'पानी', e:'💧', c:'#3b82f6'},
    {l:'X', en:'Xylophone', hi:'सीलोफोन', e:'🎵', c:'#14b8a6'},
    {l:'Y', en:'Yak', hi:'याक', e:'🐂', c:'#78350f'},
    {l:'Z', en:'Zebra', hi:'ज़ेबरा', e:'🦓', c:'#171717'}
  ];

  function speak(text) {
    if ('speechSynthesis' in window) {
      const u = new SpeechSynthesisUtterance(text);
      u.lang = 'en-US';
      u.rate = 0.9;
      window.speechSynthesis.speak(u);
    }
  }

  // Render Alphabet Grid
  const grid = document.getElementById('abc-grid');
  ALPHABET.forEach(item => {
    const card = document.createElement('div');
    card.className = 'letter-card';
    card.style.borderColor = `${item.c}40`;
    card.innerHTML = `
      <div class="l-char" style="color: ${item.c}">${item.l}</div>
      <div class="l-emoji">${item.e}</div>
      <div class="l-en">${item.en}</div>
      <div class="l-hi">${item.hi}</div>
    `;
    card.onclick = () => {
      speak(`${item.l} for ${item.en}`);
      card.style.borderColor = item.c;
      setTimeout(() => card.style.borderColor = `${item.c}40`, 1000);
    };
    grid.appendChild(card);
  });

  // Quiz Logic
  let currentQuiz = {};
  
  function initQuiz() {
    const qIndex = Math.floor(Math.random() * ALPHABET.length);
    currentQuiz = ALPHABET[qIndex];
    document.getElementById('q-emoji').innerText = currentQuiz.e;
    
    // Get 3 wrong options + 1 correct
    let options = [currentQuiz.l];
    while(options.length < 4) {
      const randL = ALPHABET[Math.floor(Math.random() * ALPHABET.length)].l;
      if(!options.includes(randL)) options.push(randL);
    }
    options.sort(() => Math.random() - 0.5); // shuffle
    
    const optContainer = document.getElementById('q-options');
    optContainer.innerHTML = '';
    
    options.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'quiz-btn';
      btn.innerText = opt;
      btn.onclick = () => checkQuiz(opt, btn);
      optContainer.appendChild(btn);
    });
  }

  function checkQuiz(selected, btn) {
    if(selected === currentQuiz.l) {
      btn.classList.add('correct');
      speak(`Correct! ${currentQuiz.l} for ${currentQuiz.en}`);
      showStars(btn);
      setTimeout(initQuiz, 1500);
    } else {
      btn.classList.add('wrong');
      speak(`Try again!`);
      setTimeout(() => btn.classList.remove('wrong'), 500);
    }
  }

  function showStars(btn) {
    const rect = btn.getBoundingClientRect();
    const star = document.createElement('div');
    star.className = 'star-anim';
    star.innerText = '⭐';
    star.style.left = `${rect.left + rect.width/2 - 20}px`;
    star.style.top = `${rect.top}px`;
    document.body.appendChild(star);
    
    setTimeout(() => {
      star.style.opacity = '1';
      star.style.transform = 'translateY(-100px) scale(2)';
    }, 50);
    
    setTimeout(() => {
      star.remove();
    }, 1000);
  }

  initQuiz();
</script>
