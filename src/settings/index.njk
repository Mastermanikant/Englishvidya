---
layout: layouts/base.njk
title: Settings & Preferences
permalink: /settings/
---

<style>
.settings-container {
  max-width: 800px;
  margin: 2rem auto;
  padding: 1rem;
  font-family: sans-serif;
}
.settings-section {
  background: var(--bg-raised, #ffffff);
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 1rem;
  padding: 2rem;
  margin-bottom: 2rem;
  box-shadow: 0 4px 6px rgba(0,0,0,0.05);
}
.settings-section h2 {
  margin-top: 0;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid var(--border, #e2e8f0);
  padding-bottom: 0.5rem;
  color: var(--text, #333);
}
/* Toggle Button styling */
#big-theme-toggle {
  width: 100%;
  padding: 1rem;
  font-size: 1.25rem;
  background: var(--bg-raised, #f1f5f9);
  border: 2px solid var(--accent, #3b82f6);
  border-radius: 0.75rem;
  color: var(--text, #333);
  cursor: pointer;
  transition: all 0.3s;
  font-weight: bold;
}
#big-theme-toggle:hover {
  background: var(--accent, #3b82f6);
  color: white;
}
.cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}
.option-card {
  border: 2px solid var(--border, #e2e8f0);
  border-radius: 0.75rem;
  padding: 1.5rem;
  text-align: center;
  cursor: pointer;
  background: var(--bg-raised, #fff);
  color: var(--text, #333);
  transition: border-color 0.2s;
}
.option-card.selected {
  border-color: var(--accent, #3b82f6);
  background: rgba(59, 130, 246, 0.05);
}
.pill-group {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}
.pill-btn {
  padding: 0.5rem 1.5rem;
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 9999px;
  background: var(--bg-raised, #fff);
  color: var(--text, #333);
  cursor: pointer;
}
.pill-btn.selected {
  background: var(--accent, #3b82f6);
  color: white;
  border-color: var(--accent, #3b82f6);
}
.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 0;
  border-bottom: 1px solid var(--border, #e2e8f0);
}
.toggle-switch {
  width: 50px;
  height: 26px;
  background-color: var(--border, #ccc);
  border-radius: 26px;
  position: relative;
  cursor: pointer;
  border: none;
  transition: 0.3s;
}
.toggle-switch::after {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  width: 22px;
  height: 22px;
  background: white;
  border-radius: 50%;
  transition: 0.3s;
}
.toggle-switch.active {
  background-color: var(--accent, #3b82f6);
}
.toggle-switch.active::after {
  transform: translateX(24px);
}
.btn {
  padding: 0.75rem 1.5rem;
  border-radius: 0.5rem;
  border: none;
  font-weight: bold;
  cursor: pointer;
}
.btn-danger {
  background: #ef4444;
  color: white;
}
.btn-outline {
  background: transparent;
  border: 2px solid var(--accent, #3b82f6);
  color: var(--accent, #3b82f6);
}
</style>

<div class="settings-container">
  <!-- Appearance -->
  <div class="settings-section">
    <h2>1. Appearance</h2>
    <button id="big-theme-toggle" role="switch" aria-checked="false">☀️ Day Mode / 🌙 Night Mode</button>
  </div>

  <!-- Language -->
  <div class="settings-section">
    <h2>2. Language Medium</h2>
    <div class="cards-grid">
      <div class="option-card selected" id="lang-hi" onclick="setLang('hi')">
        <h3>Hindi Medium</h3>
        <p>Learn English through Hindi</p>
      </div>
      <div class="option-card" id="lang-en" onclick="setLang('en')">
        <h3>English Medium</h3>
        <p>Learn entirely in English</p>
      </div>
    </div>
  </div>

  <!-- Notifications -->
  <div class="settings-section">
    <h2>3. Notifications</h2>
    <div class="toggle-row">
      <span>Daily Reminder</span>
      <button class="toggle-switch active" onclick="this.classList.toggle('active')"></button>
    </div>
    <div class="toggle-row">
      <span>New Lessons</span>
      <button class="toggle-switch active" onclick="this.classList.toggle('active')"></button>
    </div>
    <div class="toggle-row">
      <span>Test Reminders</span>
      <button class="toggle-switch" onclick="this.classList.toggle('active')"></button>
    </div>
  </div>

  <!-- Learning Preferences -->
  <div class="settings-section">
    <h2>4. Learning Preferences</h2>
    <p>Difficulty Level:</p>
    <div class="pill-group">
      <button class="pill-btn selected" onclick="selectPill(this, 'diff')">Easy</button>
      <button class="pill-btn" onclick="selectPill(this, 'diff')">Medium</button>
      <button class="pill-btn" onclick="selectPill(this, 'diff')">Hard</button>
    </div>
    <p style="margin-top:1.5rem;">Daily Goal (Words):</p>
    <div class="pill-group">
      <button class="pill-btn" onclick="selectPill(this, 'goal')">5</button>
      <button class="pill-btn selected" onclick="selectPill(this, 'goal')">10</button>
      <button class="pill-btn" onclick="selectPill(this, 'goal')">15</button>
      <button class="pill-btn" onclick="selectPill(this, 'goal')">20</button>
    </div>
  </div>

  <!-- Data & Privacy -->
  <div class="settings-section">
    <h2>5. Data & Privacy</h2>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <button class="btn btn-outline" onclick="exportData()">Export My Notes</button>
      <button class="btn btn-danger" onclick="clearData()">Clear All Local Data</button>
    </div>
  </div>

  <!-- About -->
  <div class="settings-section">
    <h2>6. About English Vidya</h2>
    <p>Version: <strong>v3.0.0</strong></p>
    <button class="btn btn-outline" style="margin-bottom: 1rem;" onclick="checkUpdates()">Check for updates</button>
    <p>
      <a href="/privacy/" style="color: var(--accent);">Privacy Policy</a> | 
      <a href="/contact/" style="color: var(--accent);">Contact Us</a>
    </p>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Theme setup
  const themeToggle = document.getElementById('big-theme-toggle');
  const currentTheme = localStorage.getItem('ev-theme') || 'light';
  if(currentTheme === 'dark') {
    document.documentElement.setAttribute('data-theme', 'dark');
    themeToggle.setAttribute('aria-checked', 'true');
    themeToggle.innerHTML = '🌙 Night Mode Active (Switch to Day)';
  }
  
  themeToggle.addEventListener('click', () => {
    let theme = document.documentElement.getAttribute('data-theme');
    if (theme === 'dark') {
      document.documentElement.removeAttribute('data-theme');
      localStorage.setItem('ev-theme', 'light');
      themeToggle.setAttribute('aria-checked', 'false');
      themeToggle.innerHTML = '☀️ Day Mode Active (Switch to Night)';
      if (window.showToast) window.showToast('Switched to Day Mode');
    } else {
      document.documentElement.setAttribute('data-theme', 'dark');
      localStorage.setItem('ev-theme', 'dark');
      themeToggle.setAttribute('aria-checked', 'true');
      themeToggle.innerHTML = '🌙 Night Mode Active (Switch to Day)';
      if (window.showToast) window.showToast('Switched to Night Mode');
    }
  });

  // Lang setup
  const lang = localStorage.getItem('ev-lang') || 'hi';
  setLang(lang, false);
});

function setLang(lang, showToastMsg = true) {
  document.getElementById('lang-hi').classList.remove('selected');
  document.getElementById('lang-en').classList.remove('selected');
  document.getElementById('lang-' + lang).classList.add('selected');
  localStorage.setItem('ev-lang', lang);
  if (showToastMsg && window.showToast) window.showToast('Language updated');
}

function selectPill(btn, group) {
  const siblings = btn.parentElement.querySelectorAll('.pill-btn');
  siblings.forEach(s => s.classList.remove('selected'));
  btn.classList.add('selected');
  if (window.showToast) window.showToast('Preference saved');
}

function clearData() {
  if (confirm('Are you sure you want to delete all local data? This cannot be undone.')) {
    localStorage.clear();
    if (window.showToast) window.showToast('All local data cleared');
    setTimeout(() => location.reload(), 1000);
  }
}

function exportData() {
  const data = localStorage.getItem('ev-diary-notes') || 'No notes found.';
  const blob = new Blob([data], { type: 'text/plain' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'english-vidya-notes.txt';
  a.click();
  URL.revokeObjectURL(url);
  if (window.showToast) window.showToast('Notes exported');
}

function checkUpdates() {
  if (window.checkForUpdates) {
    window.checkForUpdates();
  } else {
    if (window.showToast) window.showToast('You are on the latest version!');
  }
}
</script>
