<script>
document.addEventListener('DOMContentLoaded', async () => {
  // Location DOM Elements
  const pincodeInput = document.getElementById('input-pincode');
  const pincodeStatus = document.getElementById('pincode-status');
  const stateInput = document.getElementById('input-state');
  const districtInput = document.getElementById('input-district');
  const subdistrictInput = document.getElementById('input-subdistrict');
  const blockInput = document.getElementById('input-block');
  const panchayatInput = document.getElementById('input-panchayat');
  const villageContainer = document.getElementById('village-container');
  const wardInput = document.getElementById('input-ward');

  let villageTextVal = '';

  // Helper to set village input as text or select
  function setVillageDropdown(options) {
    if (!options || options.length === 0) {
      villageContainer.innerHTML = `<input type="text" id="input-village" placeholder="e.g. Kahra Village" value="${villageTextVal}">`;
      const textEl = document.getElementById('input-village');
      textEl.addEventListener('input', () => {
        villageTextVal = textEl.value;
      });
      return;
    }
    
    let html = `<select id="input-village-select">`;
    html += `<option value="">-- select village/area --</option>`;
    options.forEach(opt => {
      const selectedAttr = opt === villageTextVal ? 'selected' : '';
      html += `<option value="${opt}" ${selectedAttr}>${opt}</option>`;
    });
    html += `<option value="__custom__">-- Type custom village --</option>`;
    html += `</select>`;
    
    villageContainer.innerHTML = html;

    const selectEl = document.getElementById('input-village-select');
    selectEl.addEventListener('change', () => {
      if (selectEl.value === '__custom__') {
        villageContainer.innerHTML = `<input type="text" id="input-village" placeholder="e.g. Kahra Village" value="">`;
        const textEl = document.getElementById('input-village');
        textEl.focus();
        textEl.addEventListener('input', () => {
          villageTextVal = textEl.value;
        });
      } else {
        villageTextVal = selectEl.value;
      }
    });
  }

  function getVillageValue() {
    const selectEl = document.getElementById('input-village-select');
    if (selectEl) {
      return selectEl.value;
    }
    const textEl = document.getElementById('input-village');
    return textEl ? textEl.value.trim() : '';
  }

  // Handle pincode entry
  pincodeInput.addEventListener('input', async () => {
    const pin = pincodeInput.value.trim();
    if (pin.length === 6 && /^\d{6}$/.test(pin)) {
      pincodeStatus.textContent = '🔍 Fetching details...';
      pincodeStatus.style.color = 'var(--text-secondary)';
      try {
        const resp = await fetch(`https://api.postalpincode.in/pincode/${pin}`);
        const resData = await resp.json();
        if (resData && resData[0] && resData[0].Status === 'Success') {
          pincodeStatus.textContent = '✅ Pincode details loaded';
          pincodeStatus.style.color = 'var(--success)';
          
          const info = resData[0].PostOffice[0];
          stateInput.value = info.State || '';
          districtInput.value = info.District || '';
          subdistrictInput.value = info.Block === 'No' ? '' : (info.Block || '');
          blockInput.value = info.Block === 'No' ? '' : (info.Block || '');

          const poList = resData[0].PostOffice.map(po => po.Name);
          setVillageDropdown(poList);
        } else {
          pincodeStatus.textContent = '❌ Invalid Pincode or details not found';
          pincodeStatus.style.color = 'var(--error)';
        }
      } catch (err) {
        pincodeStatus.textContent = '⚠️ API error, please enter details manually';
        pincodeStatus.style.color = 'var(--warning)';
      }
    } else {
      pincodeStatus.textContent = '';
    }
  });

  // Fetch user data
  try {
    const res = await fetch('/api/auth-me');
    const data = await res.json();
    if (!data.loggedIn) {
      window.location.href = '/login/?redirect=/settings/';
      return;
    }

    const u = data.user;
    document.getElementById('input-name').value = u.name || '';
    document.getElementById('input-username').value = u.username || '';
    
    document.getElementById('input-facebook').value = u.social_facebook || '';
    document.getElementById('input-youtube').value = u.social_youtube || '';
    document.getElementById('input-instagram').value = u.social_instagram || '';
    document.getElementById('input-twitter').value = u.social_twitter || '';
    document.getElementById('input-linkedin').value = u.social_linkedin || '';
    document.getElementById('input-pinterest').value = u.social_pinterest || '';
    document.getElementById('input-website1').value = u.social_website1 || '';
    document.getElementById('input-website2').value = u.social_website2 || '';

    if (u.location_address) {
      try {
        const loc = JSON.parse(u.location_address);
        pincodeInput.value = loc.pincode || '';
        stateInput.value = loc.state || '';
        districtInput.value = loc.district || '';
        subdistrictInput.value = loc.subdistrict || '';
        blockInput.value = loc.block || '';
        panchayatInput.value = loc.panchayat || '';
        wardInput.value = loc.ward || '';
        villageTextVal = loc.village || '';
        
        if (loc.pincode) {
          villageContainer.innerHTML = `<input type="text" id="input-village" placeholder="e.g. Kahra Village" value="${villageTextVal}">`;
          const textEl = document.getElementById('input-village');
          textEl.addEventListener('input', () => {
            villageTextVal = textEl.value;
          });
          
          fetch(`https://api.postalpincode.in/pincode/${loc.pincode}`)
            .then(r => r.json())
            .then(resData => {
              if (resData && resData[0] && resData[0].Status === 'Success') {
                const poList = resData[0].PostOffice.map(po => po.Name);
                setVillageDropdown(poList);
              }
            }).catch(() => {});
        } else {
          villageContainer.innerHTML = `<input type="text" id="input-village" placeholder="e.g. Kahra Village" value="${villageTextVal}">`;
          const textEl = document.getElementById('input-village');
          textEl.addEventListener('input', () => {
            villageTextVal = textEl.value;
          });
        }
      } catch(e) {}
    } else {
      villageContainer.innerHTML = `<input type="text" id="input-village" placeholder="e.g. Kahra Village" value="">`;
      const textEl = document.getElementById('input-village');
      textEl.addEventListener('input', () => {
        villageTextVal = textEl.value;
      });
    }

    if (u.delete_requested_at) {
      document.getElementById('delete-status-container').style.display = 'none';
      document.getElementById('delete-pending-container').style.display = 'block';
    }

    // Populate recovery email and questions
    document.getElementById('input-recovery-email').value = u.recovery_email || '';
    
    if (u.security_questions) {
      if (u.security_questions[0]) {
        document.getElementById('q1-select').value = u.security_questions[0].question || '';
        document.getElementById('q1-answer').placeholder = '•••••• (सहेजा गया है, बदलने के लिए फिर से लिखें)';
        document.getElementById('q1-answer').required = false;
      }
      if (u.security_questions[1]) {
        document.getElementById('q2-select').value = u.security_questions[1].question || '';
        document.getElementById('q2-answer').placeholder = '•••••• (सहेजा गया है, बदलने के लिए फिर से लिखें)';
        document.getElementById('q2-answer').required = false;
      }
      if (u.security_questions[2]) {
        document.getElementById('q3-answer').placeholder = '•••••• (सहेजा गया है, बदलने के लिए फिर से लिखें)';
        document.getElementById('q3-answer').required = false;
        if (u.security_questions[2].is_custom) {
          document.getElementById('custom-q-check').checked = true;
          document.getElementById('q3-select').style.display = 'none';
          document.getElementById('q3-select').required = false;
          document.getElementById('q3-custom-text').style.display = 'block';
          document.getElementById('q3-custom-text').required = true;
          document.getElementById('q3-custom-text').value = u.security_questions[2].question || '';
        } else {
          document.getElementById('custom-q-check').checked = false;
          document.getElementById('q3-select').style.display = 'block';
          document.getElementById('q3-select').required = true;
          document.getElementById('q3-custom-text').style.display = 'none';
          document.getElementById('q3-custom-text').required = false;
          document.getElementById('q3-select').value = u.security_questions[2].question || '';
        }
      }
    }

    // Toggle password fields based on whether they have a password
    const pwdGroup = document.getElementById('password-current-group');
    const pwdDesc = document.getElementById('password-desc');
    const lblNewPwd = document.getElementById('lbl-new-password');
    const savePwdBtn = document.getElementById('save-password-btn');
    if (u.has_password) {
      pwdGroup.style.display = 'block';
      document.getElementById('input-current-password').required = true;
      pwdDesc.style.display = 'none';
      lblNewPwd.textContent = 'New Password (नया पासवर्ड - min 6 chars)';
      savePwdBtn.textContent = 'Update Password';
    } else {
      pwdGroup.style.display = 'none';
      document.getElementById('input-current-password').required = false;
      pwdDesc.style.display = 'block';
      lblNewPwd.textContent = 'Set Password (पासवर्ड सेट करें - min 6 chars)';
      savePwdBtn.textContent = 'Set Password';
    }

  } catch (e) {
    console.error('Failed to load user', e);
  }

  // Handle custom question checkbox toggle
  const customQCheck = document.getElementById('custom-q-check');
  const q3Select = document.getElementById('q3-select');
  const q3CustomText = document.getElementById('q3-custom-text');

  customQCheck.addEventListener('change', () => {
    if (customQCheck.checked) {
      q3Select.style.display = 'none';
      q3Select.required = false;
      q3CustomText.style.display = 'block';
      q3CustomText.required = true;
    } else {
      q3Select.style.display = 'block';
      q3Select.required = true;
      q3CustomText.style.display = 'none';
      q3CustomText.required = false;
    }
  });

  // Handle Password Change Setup
  const passChangeForm = document.getElementById('password-change-form');
  if (passChangeForm) {
    passChangeForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('save-password-btn');
      const alertBox = document.getElementById('security-alert');
      const currentPassword = document.getElementById('input-current-password').value;
      const newPassword = document.getElementById('input-new-password').value;

      if (newPassword.length < 6) return;

      btn.disabled = true;
      btn.textContent = 'Saving...';
      alertBox.style.display = 'none';

      try {
        const res = await fetch('/api/user-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ currentPassword: currentPassword || undefined, password: newPassword })
        });
        const data = await res.json();
        
        alertBox.style.display = 'block';
        if (res.ok && data.success) {
          alertBox.className = 'alert-msg alert-success';
          alertBox.textContent = 'Password updated successfully!';
          document.getElementById('input-current-password').value = '';
          document.getElementById('input-new-password').value = '';
          
          setTimeout(() => window.location.reload(), 2000);
        } else {
          alertBox.className = 'alert-msg alert-error';
          alertBox.textContent = data.error || 'Failed to update password.';
        }
      } catch (err) {
        alertBox.style.display = 'block';
        alertBox.className = 'alert-msg alert-error';
        alertBox.textContent = 'Network error.';
      } finally {
        btn.disabled = false;
      }
    });
  }

  // Handle Security Questions Form
  const securityQuestionsForm = document.getElementById('security-questions-form');
  if (securityQuestionsForm) {
    securityQuestionsForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('save-questions-btn');
      const alertBox = document.getElementById('security-alert');
      
      const recoveryEmail = document.getElementById('input-recovery-email').value.trim();
      
      const q1 = document.getElementById('q1-select').value;
      const a1 = document.getElementById('q1-answer').value;
      
      const q2 = document.getElementById('q2-select').value;
      const a2 = document.getElementById('q2-answer').value;
      
      const isCustom3 = document.getElementById('custom-q-check').checked;
      const q3 = isCustom3 ? document.getElementById('q3-custom-text').value : document.getElementById('q3-select').value;
      const a3 = document.getElementById('q3-answer').value;

      if (!q1 || !q2 || !q3) {
        alertBox.style.display = 'block';
        alertBox.className = 'alert-msg alert-error';
        alertBox.textContent = 'सभी ३ सुरक्षा प्रश्नों को चुनना अनिवार्य है।';
        return;
      }

      if (q1 === q2 || q1 === q3 || q2 === q3) {
        alertBox.style.display = 'block';
        alertBox.className = 'alert-msg alert-error';
        alertBox.textContent = 'सभी ३ सुरक्षा प्रश्न अलग-अलग होने चाहिए।';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Saving...';
      alertBox.style.display = 'none';

      try {
        const res = await fetch('/api/user-security-questions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            recoveryEmail,
            questions: [
              { question: q1, answer: a1 || undefined, isCustom: false },
              { question: q2, answer: a2 || undefined, isCustom: false },
              { question: q3, answer: a3 || undefined, isCustom: isCustom3 }
            ]
          })
        });
        const data = await res.json();
        
        alertBox.style.display = 'block';
        if (res.ok && data.success) {
          alertBox.className = 'alert-msg alert-success';
          alertBox.textContent = data.message || 'Security settings saved successfully!';
          setTimeout(() => window.location.reload(), 2000);
        } else {
          alertBox.className = 'alert-msg alert-error';
          alertBox.textContent = data.error || 'Failed to save security settings.';
        }
      } catch (err) {
        alertBox.style.display = 'block';
        alertBox.className = 'alert-msg alert-error';
        alertBox.textContent = 'Network error.';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Save Security Settings';
      }
    });
  }

  // Handle Profile Update
  document.getElementById('profile-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('save-profile-btn');
    const alertBox = document.getElementById('profile-alert');
    btn.disabled = true;
    btn.textContent = 'Saving...';
    
    const payload = {
      name: document.getElementById('input-name').value,
      username: document.getElementById('input-username').value,
      social_facebook: document.getElementById('input-facebook').value,
      social_youtube: document.getElementById('input-youtube').value,
      social_instagram: document.getElementById('input-instagram').value,
      social_twitter: document.getElementById('input-twitter').value,
      social_linkedin: document.getElementById('input-linkedin').value,
      social_pinterest: document.getElementById('input-pinterest').value,
      social_website1: document.getElementById('input-website1').value,
      social_website2: document.getElementById('input-website2').value,
      location_address: {
        pincode: pincodeInput.value.trim(),
        country: 'India',
        state: stateInput.value.trim(),
        district: districtInput.value.trim(),
        subdistrict: subdistrictInput.value.trim(),
        block: blockInput.value.trim(),
        panchayat: panchayatInput.value.trim(),
        village: getVillageValue(),
        ward: wardInput.value.trim()
      }
    };

    try {
      const res = await fetch('/api/user-update', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      
      const data = await res.json();
      alertBox.style.display = 'block';
      if (res.ok) {
        alertBox.className = 'alert-msg alert-success';
        alertBox.textContent = data.message || 'Profile saved successfully!';
        setTimeout(() => alertBox.style.display='none', 3000);
      } else {
        alertBox.className = 'alert-msg alert-error';
        alertBox.textContent = data.message || await res.text();
      }
    } catch (e) {
      alertBox.style.display = 'block';
      alertBox.className = 'alert-msg alert-error';
      alertBox.textContent = 'Network error. Please try again.';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Save Changes';
    }
  });

  // Handle Deletion Request
  document.getElementById('request-delete-btn').addEventListener('click', async () => {
    if (!confirm('Are you sure you want to request account deletion?')) return;
    
    try {
      const res = await fetch('/api/user-update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'request_delete' })
      });
      if (res.ok) {
        document.getElementById('delete-status-container').style.display = 'none';
        document.getElementById('delete-pending-container').style.display = 'block';
      } else {
        alert(await res.text());
      }
    } catch (e) {
      alert('Error requesting deletion');
    }
  });

  // Handle Cancel Deletion
  document.getElementById('cancel-delete-btn').addEventListener('click', async () => {
    try {
      const res = await fetch('/api/user-update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'cancel_delete' })
      });
      if (res.ok) {
        document.getElementById('delete-status-container').style.display = 'block';
        document.getElementById('delete-pending-container').style.display = 'none';
      } else {
        alert(await res.text());
      }
    } catch (e) {
      alert('Error cancelling deletion');
    }
  });
});
</script>
