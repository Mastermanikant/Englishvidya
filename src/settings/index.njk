        </div>
        <div class="form-group" style="grid-column: span 2;">
          <label>Ward No (वार्ड संख्या) - Optional</label>
          <input type="text" id="input-ward" placeholder="e.g. Ward 12">
        </div>
      </div>

      <div class="settings-header" style="margin-top: 32px;">
        <h2>Social Links</h2>
        <p style="font-size: 0.9rem; color: var(--text-secondary); margin-top: 4px;">Share your social profiles (optional)</p>
      </div>
      <div class="grid-2">
        <div class="form-group">
          <label>Facebook URL</label>
          <input type="url" id="input-facebook" placeholder="https://facebook.com/...">
        </div>
        <div class="form-group">
          <label>YouTube URL</label>
          <input type="url" id="input-youtube" placeholder="https://youtube.com/...">
        </div>
        <div class="form-group">
          <label>Instagram URL</label>
          <input type="url" id="input-instagram" placeholder="https://instagram.com/...">
        </div>
        <div class="form-group">
          <label>X (Twitter) URL</label>
          <input type="url" id="input-twitter" placeholder="https://x.com/...">
        </div>
        <div class="form-group">
          <label>LinkedIn URL</label>
          <input type="url" id="input-linkedin" placeholder="https://linkedin.com/in/...">
        </div>
        <div class="form-group">
          <label>Pinterest URL</label>
          <input type="url" id="input-pinterest" placeholder="https://pinterest.com/...">
        </div>
        <div class="form-group">
