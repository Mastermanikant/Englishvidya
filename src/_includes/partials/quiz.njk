<div class="quiz-wrapper" x-data="quizComponent({{ quizData | dump | escape }})">
  <!-- Quiz Header: Progress bar + counter + timer -->
  <div class="quiz-header">
    <div class="quiz-progress-wrap">
      <div class="quiz-progress-fill" :style="`width: ${(attempted/questions.length)*100}%`"></div>
    </div>
    <span class="quiz-q-count" x-text="`${attempted}/${questions.length}`"></span>
    <div class="quiz-timer" x-text="right + '✅ ' + wrong + '❌'" style="width:auto; padding: 0 10px; font-size:0.78rem; white-space:nowrap;"></div>
  </div>

  <!-- Questions -->
  <template x-for="(q, qIndex) in questions" :key="qIndex">
    <div x-show="!submitted">
      <!-- Question Card -->
      <div class="quiz-question-card">
        <div class="quiz-q-number" x-text="`Question ${qIndex + 1}`"></div>
        <div class="quiz-question-text" x-text="q.question"></div>
      </div>
      <!-- Options -->
      <div class="quiz-options">
        <template x-for="(opt, optIndex) in q.options" :key="optIndex">
          <button class="option-card btn-haptic"
            @click="selectOption(qIndex, optIndex)"
            :disabled="q.answered"
            :class="{
              'answered': q.answered,
              'correct':  q.answered && optIndex === q.correct,
              'wrong':    q.answered && q.selected === optIndex && optIndex !== q.correct,
              'selected': !q.answered && q.selected === optIndex
            }">
            <div class="option-label" x-text="String.fromCharCode(65 + optIndex)"></div>
            <div class="option-text" x-text="opt"></div>
            <span x-show="q.answered && optIndex === q.correct" style="font-size:1.1rem; margin-left:auto;">✅</span>
            <span x-show="q.answered && q.selected === optIndex && optIndex !== q.correct" style="font-size:1.1rem; margin-left:auto;">❌</span>
          </button>
        </template>
      </div>
      <!-- Explanation -->
      <div x-show="q.answered" x-html="q.explanation"
        style="margin: -0.75rem 0 1.5rem; padding: 1rem 1.25rem; background: var(--accent-soft); border-left: 3px solid var(--accent); border-radius: 0 0 var(--radius-md) var(--radius-md); font-size: 0.9rem; line-height: 1.6; animation: fadeSlideIn 0.3s var(--ease-out);">
      </div>
    </div>
  </template>

  <!-- Submit Button -->
  <button class="quiz-next-btn btn-haptic" style="display:block; width:100%;"
    x-show="attempted === questions.length && !submitted"
    @click="submitted = true">
    🏆 Final Result देखें
  </button>

  <!-- Result Card -->
  <div class="quiz-result-card" x-show="submitted" style="display:none;">
    <div class="quiz-score-number" x-text="`${right}/${questions.length}`"></div>
    <div class="quiz-result-title" x-text="right === questions.length ? '🎉 Perfect Score!' : right >= questions.length/2 ? '👏 Well Done!' : '📚 Keep Practicing!'"></div>
    <div class="quiz-result-subtitle" x-text="`आपने ${right} सही और ${wrong} गलत जवाब दिए।`"></div>
    <button class="quiz-next-btn btn-haptic" @click="resetQuiz()" style="margin: 0 auto;">
      🔄 फिर से कोशिश करें
    </button>
  </div>
</div>

<script>
document.addEventListener('alpine:init', () => {
  Alpine.data('quizComponent', (initialData) => ({
    questions: initialData.map(q => ({ ...q, answered: false, selected: null })),
    attempted: 0,
    right: 0,
    wrong: 0,
    submitted: false,
    selectOption(qIndex, optIndex) {
      const q = this.questions[qIndex];
      if (q.answered) return;
      q.answered = true;
      q.selected = optIndex;
      this.attempted++;
      if (optIndex === q.correct) { this.right++; } else { this.wrong++; }
    },
    resetQuiz() {
      this.questions.forEach(q => { q.answered = false; q.selected = null; });
      this.attempted = 0; this.right = 0; this.wrong = 0; this.submitted = false;
    }
  }));
});
</script>
