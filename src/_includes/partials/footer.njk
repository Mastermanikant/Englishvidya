{# ══ FOOTER PARTIAL (WCAG Compliant & Modern) ══ #}
<style>
.site-footer {
  background-color: #0f172a; /* Modern dark slate */
  color: #94a3b8;
  padding: 3rem 1.5rem 1.5rem;
  font-family: 'Inter', sans-serif;
  border-top: 1px solid #1e293b;
}
.footer-inner {
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
  max-width: 1200px;
  margin: 0 auto;
  justify-content: space-between;
}
.footer-brand {
  flex: 1 1 300px;
}
.footer-logo {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
  font-size: 1.25rem;
  font-weight: 700;
  color: #f8fafc;
  margin-bottom: 1rem;
}
.footer-logo img {
  width: 24px;
  height: 24px;
}
.footer-tagline {
  font-size: 0.875rem;
  line-height: 1.5;
  color: #cbd5e1;
}
.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 3rem;
  flex: 2 1 500px;
}
.footer-col {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.footer-col-title {
  color: #f8fafc;
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.5rem;
}
.footer-col a {
  color: #94a3b8;
  text-decoration: none;
  font-size: 0.875rem;
  transition: color 0.2s ease, outline 0.2s ease;
}
.footer-col a:hover, .footer-col a:focus {
  color: #38bdf8;
  outline: 2px solid transparent;
}
.footer-col a:focus-visible {
  outline: 2px solid #38bdf8;
  border-radius: 4px;
  padding: 2px;
}
.social-links {
  display: flex;
  gap: 1rem;
  align-items: center;
}
.social-links a {
  color: #fff;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem;
  border-radius: 50%;
}
.social-wa { background-color: #25D366; }
.social-fb { background-color: #1877F2; }
.social-ig { background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%); }
.social-yt { background-color: #FF0000; }
.social-x { background-color: #000000; border: 1px solid #333; }

.social-links a:hover, .social-links a:focus {
  transform: translateY(-3px);
  box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}
.social-links svg {
  width: 20px;
  height: 20px;
  fill: currentColor;
}
/* WCAG Compliant Tooltip on hover */
.social-links a::after {
  content: attr(aria-label);
  position: absolute;
  bottom: -30px;
  left: 50%;
  transform: translateX(-50%);
  background: #1e293b;
  color: #f8fafc;
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 0.75rem;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 10;
  border: 1px solid #334155;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}
.social-links a:hover::after, .social-links a:focus-visible::after {
  opacity: 1;
}

.footer-bottom {
  max-width: 1200px;
  margin: 2.5rem auto 0;
  padding-top: 2rem;
  border-top: 1px solid rgba(99,102,241,0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  text-align: center;
  font-size: 0.875rem;
  position: relative;
}
@media (min-width: 768px) {
  .footer-bottom {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    gap: 0;
  }
  .footer-bottom .footer-copyright {
    margin: 0 auto;
  }
}
.footer-bottom::before {
  content: '';
  position: absolute;
  top: -1px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 2px;
  background: linear-gradient(90deg, transparent, #8b5cf6, transparent);
  border-radius: 2px;
}
.footer-bottom p {
  margin: 0;
  color: #94a3b8;
}
.master-credit {
  color: #e2e8f0;
  font-weight: 600;
  font-size: 0.92rem;
  letter-spacing: 0.01em;
}
.master-credit strong {
  background: linear-gradient(135deg, #8b5cf6, #38bdf8);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.footer-copyright {
  color: #94a3b8;
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: center;
}
.footer-copyright .heart {
  color: #f43f5e;
  display: inline-block;
  animation: heartbeat 1.4s ease infinite;
}
@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  14% { transform: scale(1.2); }
  28% { transform: scale(1); }
  42% { transform: scale(1.15); }
  70% { transform: scale(1); }
}
.footer-build-time {
  font-size: 0.72rem;
  color: #475569;
  display: flex;
  align-items: center;
  gap: 0.3rem;
}
.footer-util-btns {
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 0.75rem;
}
.footer-util-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(99,102,241,0.25);
  color: #94a3b8;
  padding: 0.45rem 1rem;
  border-radius: 999px;
  cursor: pointer;
  font-size: 0.78rem;
  font-family: inherit;
  transition: all 0.25s ease;
  letter-spacing: 0.02em;
}
.footer-util-btn:hover {
  background: rgba(139,92,246,0.12);
  border-color: rgba(139,92,246,0.5);
  color: #c4b5fd;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(139,92,246,0.15);
}
</style>

