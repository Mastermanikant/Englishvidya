<div class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm hidden" id="mobile-drawer-overlay" role="dialog" aria-modal="true" aria-label="Mobile Navigation Menu">
  <div class="fixed inset-y-0 left-0 w-3/4 max-w-sm bg-base shadow-2xl flex flex-col transform -translate-x-full transition-transform duration-300 ease-in-out" id="mobile-drawer">
    <div class="h-16 flex items-center justify-between px-4 border-b border-border">
      <a href="/" class="flex items-center gap-2" aria-label="{{ site.siteName }} Home">
        <img src="/assets/icons/logo.webp" alt="" class="w-8 h-8 object-contain" loading="eager" aria-hidden="true">
        <span class="font-heading font-bold text-xl tracking-tight text-primary">English <span class="text-accent">Vidya</span></span>
      </a>
      <button class="p-2 text-secondary hover:text-primary transition-colors" id="mobile-drawer-close" aria-label="Close menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    
    <nav class="flex-1 overflow-y-auto py-4 px-3 flex flex-col gap-2" aria-label="Mobile Navigation Drawer">
      {% for item in site.nav %}
        {% if item.children %}
          <div class="font-bold text-xs text-secondary uppercase tracking-wider px-3 pt-2 pb-1">{{ item.label }}</div>
          {% for child in item.children %}
            <a href="{{ child.href }}" class="block px-3 py-2 text-base font-medium text-primary hover:text-accent hover:bg-raised rounded-lg transition-colors">{{ child.label }}</a>
          {% endfor %}
        {% else %}
          <a href="{{ item.href }}" class="block px-3 py-2 text-base font-medium text-primary hover:text-accent hover:bg-raised rounded-lg transition-colors">{{ item.label }}</a>
        {% endif %}
      {% endfor %}

      <div class="my-4 border-t border-border"></div>
      
      <a href="/login/" class="block px-3 py-2 text-base font-medium text-primary hover:text-accent hover:bg-raised rounded-lg transition-colors">👤 My Profile / Login</a>
      <button class="w-full text-left px-3 py-2 text-base font-medium text-primary hover:text-accent hover:bg-raised rounded-lg transition-colors flex items-center justify-between" id="theme-toggle-drawer-btn">
        <span>Toggle Theme</span>
        <span class="theme-label-moon text-lg">🌙</span>
        <span class="theme-label-sun text-lg" style="display:none;">☀️</span>
      </button>
    </nav>
  </div>
</div>
