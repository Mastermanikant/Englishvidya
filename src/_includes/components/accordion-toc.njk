{% macro render(items) %}
<div class="accordion-toc" id="toc-accordion">
    <div class="accordion-header">
        <span>Table of Contents (विषय - सूची)</span>
    </div>
    {% for item in items %}
    <details class="accordion-item" name="toc-accordion">
        <summary class="accordion-btn">
            {{ loop.index }}. {{ item.title }}
            <svg class="accordion-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </summary>
        <div class="accordion-content">
            <p>{{ item.desc }}</p>
            <a href="#section-{{ loop.index }}" style="color: var(--accent); font-weight: 600; font-size: 0.85rem; margin-top: 8px; display: inline-block;">इस विषय पर जाएँ ➔</a>
        </div>
    </details>
    {% endfor %}
</div>
{% endmacro %}
