---
layout: layouts/base.njk
---

<div class="article-layout-container">
  <div class="article-main-content">
    {# Breadcrumb #}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
          <meta itemprop="position" content="1">
        </li>
        <span class="breadcrumb-sep" aria-hidden="true">›</span>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/grammar/" itemprop="item"><span itemprop="name">Grammar</span></a>
          <meta itemprop="position" content="2">
        </li>
        <span class="breadcrumb-sep" aria-hidden="true">›</span>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name">{{ title }}</span>
          <meta itemprop="position" content="3">
        </li>
      </ol>
    </nav>

    {# Article Schema #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ title | jsonify | safe }},
      "description": {{ (description or title) | truncate(200) | jsonify | safe }},
      "url": "https://englishvidya.com/grammar/{{ slug }}/",
      "inLanguage": ["hi", "en"],
      "isPartOf": {
        "@type": "Course",
        "name": "English Grammar Course",
        "url": "https://englishvidya.com/grammar/"
      },
      "author": { "@type": "Organization", "name": "English Vidya" },
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "English Vidya",
        "url": "https://englishvidya.com"
      },
      "educationalLevel": "Beginner",
      "about": { "@type": "Thing", "name": "English Grammar" }
    }
    </script>

    {# Lesson Header #}
    <div class="lesson-header animate-fade-in">
      {% if part %}
      <span class="badge">Lesson {{ part }}</span>
      {% endif %}
      <h1 style="margin-top: var(--sp-3);">{{ title | escHtml }}</h1>
      <button class="focus-mode-toggle btn-haptic" onclick="window.toggleFocusMode && window.toggleFocusMode()" aria-label="Focus Mode" title="Distraction-less पढ़ाई के लिए">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
        Focus Mode
      </button>
    </div>

    {# Audio Player Section (Listen Feature) #}
    <div class="audio-player-wrapper">
      <div class="audio-controls">
        <button id="audio-play-btn" class="audio-btn play-btn" aria-label="Play/Pause Article">
          <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
          <span class="btn-text">Listen</span>
        </button>
        <button id="audio-stop-btn" class="audio-btn stop-btn" aria-label="Stop Audio" disabled>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h12v12H6z"/></svg>
        </button>
        
        <div class="audio-settings">
          <select id="audio-voice-select" class="audio-select" aria-label="Select Voice">
            <option value="">Default Voice</option>
          </select>
          <select id="audio-speed-select" class="audio-select" aria-label="Select Speed">
            <option value="0.75">0.75x</option>
            <option value="1" selected>1x</option>
            <option value="1.25">1.25x</option>
            <option value="1.5">1.5x</option>
          </select>
        </div>
      </div>
      <div id="audio-status" class="audio-status-text"></div>
    </div>

    {# Collapsible Controls #}
    <div class="collapsible-controls" style="display: flex; gap: var(--sp-3); margin-bottom: var(--sp-4); justify-content: flex-end; width: 100%;">
      <button id="collapse-all-btn" class="btn-secondary" style="padding: 6px 14px; font-size: 0.85rem; border-radius: 20px; font-weight: bold; cursor: pointer; display: none; align-items: center; gap: 6px;">
        🗜️ Collapse All
      </button>
      <button id="expand-all-btn" class="btn-secondary" style="padding: 6px 14px; font-size: 0.85rem; border-radius: 20px; font-weight: bold; cursor: pointer; display: none; align-items: center; gap: 6px;">
        📖 Expand All
      </button>
    </div>

    {# Markdown Content #}
    <div class="premium-card markdown-content" style="padding: var(--sp-6);">
      {{ content | safe }}

      {# Social Sharing Bar #}
      <div class="share-article-section">
        <div class="share-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent);"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
          <span>इस पाठ को शेयर करें (Share this Lesson)</span>
        </div>
        <div class="share-buttons-grid">
          <a href="https://api.whatsapp.com/send?text={{ title | urlencode }}%20{{ site.siteUrl }}{{ page.url | urlencode }}" target="_blank" rel="noopener noreferrer" class="share-btn whatsapp" aria-label="WhatsApp पर शेयर करें">
            <svg viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.457L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.42 9.864-9.858.002-2.634-1.023-5.11-2.885-6.974C16.589 1.808 14.113.784 11.48.784c-5.442 0-9.866 4.42-9.87 9.858-.001 1.902.503 3.754 1.464 5.375L2.05 21.95l6.096-1.599c1.603.953 3.195 1.452 4.823 1.452v-.002zm12.012-7.147c-.244-.122-1.44-.71-1.662-.792-.222-.082-.384-.122-.545.123-.162.244-.627.792-.769.954-.143.162-.285.183-.529.061-.244-.122-1.03-.38-1.962-1.211-.725-.647-1.214-1.446-1.356-1.69-.143-.244-.015-.376.107-.497.11-.11.244-.285.366-.428.122-.143.163-.244.244-.408.082-.163.041-.306-.02-.428-.061-.122-.545-1.31-.747-1.797-.197-.475-.388-.411-.531-.418-.137-.007-.294-.008-.451-.008-.157 0-.413.059-.628.294-.216.236-.823.805-.823 1.963 0 1.157.842 2.277.96 2.433.117.156 1.657 2.53 4.015 3.545.561.242.997.387 1.339.496.562.178 1.074.153 1.479.092.45-.068 1.44-.588 1.642-1.157.202-.569.202-1.057.142-1.157-.061-.101-.223-.162-.467-.284z"/></svg>
            <span>WhatsApp</span>
          </a>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ site.siteUrl }}{{ page.url | urlencode }}" target="_blank" rel="noopener noreferrer" class="share-btn facebook" aria-label="Facebook पर शेयर करें">
            <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            <span>Facebook</span>
          </a>
          <a href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ site.siteUrl }}{{ page.url | urlencode }}" target="_blank" rel="noopener noreferrer" class="share-btn x-platform" aria-label="X (Twitter) पर शेयर करें">
            <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            <span>X</span>
          </a>
          <a href="https://www.threads.net/intent/post?text={{ title | urlencode }}%20{{ site.siteUrl }}{{ page.url | urlencode }}" target="_blank" rel="noopener noreferrer" class="share-btn threads" aria-label="Threads पर शेयर करें">
            <svg viewBox="0 0 24 24"><path d="M14.286 11.233c.12-.99-.074-1.785-.576-2.36-.502-.575-1.252-.865-2.247-.865-.95 0-1.686.276-2.207.828-.522.552-.777 1.312-.765 2.278.01.966.27 1.716.782 2.25.51.534 1.228.8 2.15.8.963 0 1.693-.277 2.19-.83.498-.553.719-1.245.663-2.076l1.244.085c.094 1.353-.263 2.502-1.07 3.447-.808.945-2.004 1.417-3.593 1.417-1.42 0-2.544-.424-3.37-1.272C6.012 16.037 5.6 14.822 5.6 13.24c0-1.685.424-2.98 1.272-3.886.848-.906 2.05-1.36 3.606-1.36 1.543 0 2.723.442 3.54 1.326.817.884 1.18 2.083 1.09 3.593l-1.246.085v.054zm7.314.81c.01 1.704-.265 3.25-.826 4.636-.56 1.386-1.378 2.558-2.453 3.513-1.075.956-2.378 1.674-3.908 2.155C12.883 22.828 11.168 23 9.273 23c-1.922 0-3.666-.233-5.232-.698a12.83 12.83 0 01-4.184-2.076 11.96 11.96 0 01-2.812-3.376C-3.8 15.512-4 13.916-4 12.062c0-1.897.233-3.626.7-5.187.466-1.562 1.18-2.923 2.143-4.084C-.194 1.63 1.096.91 2.607.428 4.118-.052 5.815-.292 7.7-.292c2.012 0 3.824.238 5.437.714A12.05 12.05 0 0117.26 2.52c1.157 1.127 2.008 2.518 2.55 4.174.544 1.656.782 3.498.715 5.526l-1.25-.042c.062-1.782-.14-3.398-.607-4.847-.466-1.448-1.18-2.658-2.142-3.63a10.82 10.82 0 00-3.655-2.22c-1.403-.418-2.983-.628-4.738-.628-1.684 0-3.197.21-4.54.63a10.8 10.8 0 00-3.565 1.83 10.74 10.74 0 00-2.463 2.943c-.63 1.185-.945 2.558-.945 4.12 0 1.637.318 3.036.953 4.195.635 1.16 1.488 2.077 2.558 2.753a11.63 11.63 0 003.774 1.677c1.396.353 2.985.53 4.768.53 1.685 0 3.208-.15 4.57-.45 1.36-.3 2.52-.77 3.475-1.41.956-.64 1.675-1.464 2.158-2.473.483-1.01.714-2.174.693-3.494l1.246.042z"/></svg>
            <span>Threads</span>
          </a>
          <a href="https://pinterest.com/pin/create/button/?url={{ site.siteUrl }}{{ page.url | urlencode }}&description={{ title | urlencode }}" target="_blank" rel="noopener noreferrer" class="share-btn pinterest" aria-label="Pinterest पर शेयर करें">
            <svg viewBox="0 0 24 24"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.41 7.61 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.966 1.406-5.966s-.359-.72-.359-1.781c0-1.663.967-2.906 2.17-2.906 1.024 0 1.517.768 1.517 1.686 0 1.029-.656 2.57-.996 3.996-.283 1.195.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.27 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.607 0 11.985-5.36 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/></svg>
            <span>Pinterest</span>
          </a>
          <button class="share-btn copy-link" onclick="copyLessonLink(this)" aria-label="लिंक कॉपी करें">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span class="copy-text">Copy Link</span>
          </button>
          <button class="share-btn native-share" id="native-share-btn" style="display: none;" onclick="triggerNativeShare()" aria-label="अन्य माध्यम से शेयर करें">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>
            <span>Share</span>
          </button>
        </div>
      </div>

      <script>
      function copyLessonLink(btn) {
        var url = window.location.href;
        navigator.clipboard.writeText(url).then(function() {
          var textSpan = btn.querySelector('.copy-text');
          var originalText = textSpan.textContent;
          textSpan.textContent = 'Copied!';
          btn.style.backgroundColor = '#14b8a6';
          btn.style.color = '#ffffff';
          btn.style.borderColor = '#14b8a6';
          
          setTimeout(function() {
            textSpan.textContent = originalText;
            btn.style.backgroundColor = '';
            btn.style.color = '';
            btn.style.borderColor = '';
          }, 2000);
        }).catch(function(err) {
          console.error('Failed to copy: ', err);
        });
      }

      function triggerNativeShare() {
        if (navigator.share) {
          navigator.share({
            title: '{{ title | escape }}',
            text: '{{ description or title | escape }}',
            url: window.location.href
          }).catch(function(err) {
            console.log('Share cancelled or failed: ', err);
          });
        }
      }

      document.addEventListener('DOMContentLoaded', function() {
        if (navigator.share) {
          var nativeBtn = document.getElementById('native-share-btn');
          if (nativeBtn) {
            nativeBtn.style.display = 'inline-flex';
          }
        }
      });
      </script>
    </div>

    {# --- Integrated Reviews & Comments --- #}
    {% set reviewSlug = page.fileSlug %}
    {% include "partials/reviews-comments.njk" %}

    {# Online Test Link Banner (if testSlug exists) #}
    {% if testSlug %}
    <div class="take-test-banner" style="margin: 40px 0 var(--sp-6); padding: 24px; background: rgba(99, 102, 241, 0.05); border: 1px dashed var(--border); border-radius: 12px; text-align: center; box-shadow: var(--shadow-sm);">
      <h3 style="margin-top: 0; font-size: 1.15rem; color: var(--text-primary); font-family: 'Outfit', sans-serif; display: flex; align-items: center; justify-content: center; gap: 8px;">📝 क्या आपने यह पाठ पूरा कर लिया है?</h3>
      <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 16px; margin-top: 6px;">
        अपनी समझ की जाँच करने के लिए इस टॉपिक का ऑनलाइन टेस्ट (MCQ Quiz) दें।
      </p>
      <a href="/test/{{ testSlug }}/" class="btn-primary" style="text-decoration: none; padding: 10px 20px; font-size: 0.95rem; font-weight: bold; border-radius: var(--radius-md); display: inline-flex; align-items: center; gap: 8px;">
        ✍️ Start Online Test
      </a>
    </div>
    {% endif %}

    {# Prev / Next Navigation using Eleventy Collections #}
    {% set previousLesson = collections.grammar | getPreviousCollectionItem(page) %}
    {% set nextLesson = collections.grammar | getNextCollectionItem(page) %}

    <div class="lesson-nav-row" style="margin-top: var(--sp-6);">
      {% if previousLesson %}
      <a href="{{ previousLesson.url }}" class="lesson-nav-btn prev">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>{{ previousLesson.data.title | truncate(30) }}</span>
      </a>
      {% else %}
      <div></div>
      {% endif %}

      {% if nextLesson %}
      <a href="{{ nextLesson.url }}" class="lesson-nav-btn next">
        <span>{{ nextLesson.data.title | truncate(30) }}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
      {% endif %}
    </div>

    <div style="text-align: center; margin-top: var(--sp-6); margin-bottom: var(--sp-8);">
      <a href="/grammar/" class="lesson-back-btn">← सभी Grammar Lessons देखें</a>
    </div>

    {% include "components/faq-section.njk" %}
    {% include "components/author-bio.njk" %}
  </div>

  <aside class="sidebar-ads">
    <div class="ad-placeholder" style="width: 100%; min-height: 250px; background: var(--bg-raised); border: 1px dashed var(--border); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--text-secondary); text-align: center; padding: 20px;">
      <p style="font-size: 0.9rem; margin: 0;">Advertisement Space<br><small>(For future ads)</small></p>
    </div>
    <div class="ad-placeholder sticky-ad" style="position: sticky; top: 100px; width: 100%; min-height: 600px; background: var(--bg-raised); border: 1px dashed var(--border); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--text-secondary); text-align: center; padding: 20px;">
      <p style="font-size: 0.9rem; margin: 0;">Advertisement Space<br><small>(Sticky ad)</small></p>
    </div>
  </aside>
</div>

<style>
.article-layout-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0;
  display: grid;
  gap: 40px;
  grid-template-columns: 1fr;
}

@media (min-width: 1024px) {
  .article-layout-container {
    grid-template-columns: 1fr 300px;
  }
}

.article-main-content {
  width: 100%;
}

.sidebar-ads {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Hide ads in presenter-mode if no-ads-active is set */
body.no-ads-active.presenter-mode .sidebar-ads {
  display: none !important;
}
body.no-ads-active.presenter-mode .article-layout-container {
  grid-template-columns: 1fr !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const contentArea = document.querySelector('.markdown-content');
  if (!contentArea) return;

  const h2s = contentArea.querySelectorAll('h2');
  if (h2s.length === 0) return;

  // Show control buttons if we have collapsible headings
  const collapseAllBtn = document.getElementById('collapse-all-btn');
  const expandAllBtn = document.getElementById('expand-all-btn');
  if (collapseAllBtn) collapseAllBtn.style.display = 'inline-flex';
  if (expandAllBtn) expandAllBtn.style.display = 'inline-flex';

  h2s.forEach((h2, idx) => {
    // 1. Create a content container for elements between this H2 and the next H2
    const contentDiv = document.createElement('div');
    contentDiv.className = 'collapsible-content';
    contentDiv.id = `collapsible-section-${idx}`;

    // Move siblings into the container until next H2 (or end)
    let sibling = h2.nextSibling;
    while (sibling) {
      const nextSibling = sibling.nextSibling;
      // If we encounter a sharing box or another H2 or comments section, stop
      if (sibling.nodeType === 1 && (sibling.tagName === 'H2' || sibling.classList.contains('share-article-section') || sibling.id === 'word-rating-container')) {
        break;
      }
      contentDiv.appendChild(sibling);
      sibling = nextSibling;
    }

    // Insert container after H2
    h2.parentNode.insertBefore(contentDiv, h2.nextSibling);

    // 2. Setup H2 styling and arrow
    h2.classList.add('collapsible-header');
    h2.innerHTML = `<span>${h2.innerHTML}</span><span class="toggle-icon">▲</span>`;

    // Collapse by default
    collapseSection(h2, contentDiv);

    // 3. Click handler
    h2.addEventListener('click', () => {
      const isCollapsed = contentDiv.style.display === 'none';
      if (isCollapsed) {
        expandSection(h2, contentDiv);
      } else {
        collapseSection(h2, contentDiv);
      }
    });
  });

  function collapseSection(header, content) {
    content.style.display = 'none';
    header.classList.add('collapsed');
    header.querySelector('.toggle-icon').textContent = '▼';
  }

  // Handle CSS transition compatibility by setting display block on expand
  function expandSection(header, content) {
    content.style.display = 'block';
    header.classList.remove('collapsed');
    header.querySelector('.toggle-icon').textContent = '▲';
  }

  // Global actions
  if (collapseAllBtn) {
    collapseAllBtn.addEventListener('click', () => {
      h2s.forEach((h2, idx) => {
        const content = document.getElementById(`collapsible-section-${idx}`);
        if (content) collapseSection(h2, content);
      });
    });
  }

  if (expandAllBtn) {
    expandAllBtn.addEventListener('click', () => {
      h2s.forEach((h2, idx) => {
        const content = document.getElementById(`collapsible-section-${idx}`);
        if (content) expandSection(h2, content);
      });
    });
  }
});
</script>

{# ── Floating Table of Contents (TOC) Widget ── #}
<div id="toc-floating-widget" style="display: none;">
  <button id="toc-toggle-btn" class="toc-fab" aria-label="विषय सूची खोलें (Table of Contents)">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="8" y1="6" x2="21" y2="6"></line>
      <line x1="8" y1="12" x2="21" y2="12"></line>
      <line x1="8" y1="18" x2="21" y2="18"></line>
      <line x1="3" y1="6" x2="3.01" y2="6"></line>
      <line x1="3" y1="12" x2="3.01" y2="12"></line>
      <line x1="3" y1="18" x2="3.01" y2="18"></line>
    </svg>
    <span class="toc-fab-label">विषय सूची</span>
  </button>

  <div id="toc-panel" class="toc-panel" aria-hidden="true">
    <div class="toc-panel-header">
      <span class="toc-panel-title">📑 इस पाठ में</span>
      <button id="toc-close-btn" class="toc-close" aria-label="बंद करें">✕</button>
    </div>
    <nav id="toc-list" class="toc-list" aria-label="Table of Contents"></nav>
  </div>
  <div id="toc-backdrop" class="toc-backdrop"></div>
</div>

<style>
/* ── TOC Floating Button ── */
.toc-fab {
  position: fixed;
  bottom: 85px;
  left: 16px;
  z-index: 999;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 16px;
  border: none;
  border-radius: 50px;
  background: var(--accent, #6366f1);
  color: #fff;
  font-size: 0.82rem;
  font-weight: 700;
  font-family: 'Outfit', sans-serif;
  cursor: pointer;
  box-shadow: 0 4px 20px rgba(99, 102, 241, 0.35);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.toc-fab:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 28px rgba(99, 102, 241, 0.45);
}
.toc-fab:active {
  transform: scale(0.95);
}
.toc-fab-label {
  display: inline;
}

/* ── TOC Backdrop ── */
.toc-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 1000;
  opacity: 0;
  transition: opacity 0.25s ease;
}
.toc-backdrop.active {
  display: block;
  opacity: 1;
}

/* ── TOC Panel ── */
.toc-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1001;
  max-height: 65vh;
  background: var(--bg-card, #fff);
  border-radius: 20px 20px 0 0;
  box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.15);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.toc-panel.open {
  transform: translateY(0);
}

.toc-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px 12px;
  border-bottom: 1px solid var(--border, #e5e7eb);
  flex-shrink: 0;
}
.toc-panel-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-primary, #111);
  font-family: 'Outfit', sans-serif;
}
.toc-close {
  width: 32px;
  height: 32px;
  border: none;
  border-radius: 50%;
  background: var(--bg-hover, #f3f4f6);
  color: var(--text-secondary, #6b7280);
  font-size: 1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s;
}
.toc-close:hover {
  background: var(--border, #e5e7eb);
}

/* ── TOC List ── */
.toc-list {
  overflow-y: auto;
  padding: 12px 16px 20px;
  flex: 1;
}
.toc-list a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  margin-bottom: 4px;
  border-radius: 10px;
  text-decoration: none;
  color: var(--text-secondary, #6b7280);
  font-size: 0.9rem;
  font-weight: 500;
  font-family: 'Outfit', sans-serif;
  transition: background 0.15s, color 0.15s, transform 0.1s;
  line-height: 1.4;
}
.toc-list a:hover {
  background: var(--bg-hover, #f3f4f6);
  color: var(--text-primary, #111);
}
.toc-list a:active {
  transform: scale(0.98);
}
.toc-list a.toc-active {
  background: rgba(99, 102, 241, 0.08);
  color: var(--accent, #6366f1);
  font-weight: 700;
}
.toc-list .toc-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--bg-hover, #f3f4f6);
  color: var(--text-tertiary, #9ca3af);
  font-size: 0.72rem;
  font-weight: 700;
  flex-shrink: 0;
  transition: background 0.15s, color 0.15s;
}
.toc-list a.toc-active .toc-number {
  background: var(--accent, #6366f1);
  color: #fff;
}

/* ── Desktop: side panel instead of bottom sheet ── */
@media (min-width: 1024px) {
  .toc-fab {
    bottom: 32px;
    left: 32px;
  }
  .toc-panel {
    max-height: 70vh;
    max-width: 360px;
    bottom: 80px;
    left: 32px;
    right: auto;
    border-radius: 16px;
    transform: translateY(20px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease;
  }
  .toc-panel.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .toc-backdrop {
    display: none !important;
  }
}

/* ── Dark mode adjustments ── */
@media (prefers-color-scheme: dark) {
  .toc-fab {
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.25);
  }
  .toc-panel {
    box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.4);
  }
}
[data-theme="dark"] .toc-fab {
  box-shadow: 0 4px 20px rgba(99, 102, 241, 0.25);
}
[data-theme="dark"] .toc-panel {
  box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.4);
}

/* ── Hide TOC in focus/presenter mode ── */
body.presenter-mode #toc-floating-widget,
body.focus-mode-active #toc-floating-widget {
  display: none !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const contentArea = document.querySelector('.markdown-content');
  const tocWidget = document.getElementById('toc-floating-widget');
  if (!contentArea || !tocWidget) return;

  // Collect all H2 headings
  const h2s = contentArea.querySelectorAll('h2');
  if (h2s.length < 2) return; // Only show TOC if 2+ sections exist

  // Show the widget
  tocWidget.style.display = 'block';

  const tocList = document.getElementById('toc-list');
  const tocToggleBtn = document.getElementById('toc-toggle-btn');
  const tocPanel = document.getElementById('toc-panel');
  const tocCloseBtn = document.getElementById('toc-close-btn');
  const tocBackdrop = document.getElementById('toc-backdrop');

  // Build TOC items from H2s
  h2s.forEach((h2, idx) => {
    // Add an ID to the H2 for scroll targeting
    const tocId = `toc-heading-${idx}`;
    h2.id = tocId;

    // Extract text (handle collapsible-wrapped span structure)
    const firstSpan = h2.querySelector('span:first-child');
    const headingText = firstSpan ? firstSpan.textContent.trim() : h2.textContent.replace('▲', '').replace('▼', '').trim();

    const link = document.createElement('a');
    link.href = `#${tocId}`;
    link.innerHTML = `<span class="toc-number">${idx + 1}</span><span>${headingText}</span>`;
    link.addEventListener('click', (e) => {
      e.preventDefault();
      // Expand the section if collapsed
      const contentDiv = document.getElementById(`collapsible-section-${idx}`);
      if (contentDiv && contentDiv.style.display === 'none') {
        contentDiv.style.display = 'block';
        h2.classList.remove('collapsed');
        const toggleIcon = h2.querySelector('.toggle-icon');
        if (toggleIcon) toggleIcon.textContent = '▲';
      }
      // Scroll to heading
      h2.scrollIntoView({ behavior: 'smooth', block: 'start' });
      // Close panel
      closeTocPanel();
    });
    tocList.appendChild(link);
  });

  // Open/Close panel
  function openTocPanel() {
    tocPanel.classList.add('open');
    tocPanel.setAttribute('aria-hidden', 'false');
    tocBackdrop.classList.add('active');
    tocToggleBtn.style.display = 'none';
  }

  function closeTocPanel() {
    tocPanel.classList.remove('open');
    tocPanel.setAttribute('aria-hidden', 'true');
    tocBackdrop.classList.remove('active');
    tocToggleBtn.style.display = 'inline-flex';
  }

  tocToggleBtn.addEventListener('click', openTocPanel);
  tocCloseBtn.addEventListener('click', closeTocPanel);
  tocBackdrop.addEventListener('click', closeTocPanel);

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && tocPanel.classList.contains('open')) {
      closeTocPanel();
    }
  });

  // Highlight active section on scroll using IntersectionObserver
  const tocLinks = tocList.querySelectorAll('a');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const activeId = entry.target.id;
        tocLinks.forEach(link => {
          link.classList.toggle('toc-active', link.getAttribute('href') === `#${activeId}`);
        });
      }
    });
  }, {
    rootMargin: '-10% 0px -80% 0px',
    threshold: 0
  });

  h2s.forEach(h2 => observer.observe(h2));
});
</script>
