<!DOCTYPE html>
<html lang="{{ htmlLang or 'hi' }}" data-theme="dark" class="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">

  {# ── SEO Meta ── #}
  <title>{{ pageTitle or title or site.siteName }}</title>
  <meta name="description" content="{{ metaDescription or description or site.siteDescription }}">
  <link rel="canonical" href="{{ site.canonicalBase }}{{ page.url }}">
  {# ── Robots Meta ── #}
  {% if noindex %}
  <meta name="robots" content="noindex, follow">
  {% else %}
  <meta name="robots" content="index, follow">
  {% endif %}

  {# OpenGraph & Twitter Cards #}
  <meta property="og:title" content="{{ pageTitle or title or site.siteName }}">
  <meta property="og:description" content="{{ metaDescription or description or site.siteDescription }}">
  <meta property="og:url" content="{{ site.canonicalBase }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="{{ site.canonicalBase }}{{ ogImage or '/assets/icons/icon-512.png' }}">
  <meta property="og:site_name" content="{{ site.siteName }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle or title or site.siteName }}">
  <meta name="twitter:description" content="{{ metaDescription or description or site.siteDescription }}">
  <meta name="twitter:image" content="{{ site.canonicalBase }}{{ ogImage or '/assets/icons/icon-512.png' }}">


  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f172a">
  
  <link rel="icon" type="image/png" href="/assets/icons/icon-192.png">
  <link rel="icon" type="image/svg+xml" href="/assets/icons/logo.svg">
  <link rel="apple-touch-icon" href="/assets/icons/icon-192.png">
  <link rel="manifest" href="/manifest.json">

  {# ── Fonts ── #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800;900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800;900&display=swap"></noscript>

  {# ── CSS ── #}
  <link rel="stylesheet" href="/css/custom.css?v=3.0.0">
  <link rel="stylesheet" href="/css/style.css?v=3.0.1">

  {# ── Theme Restore ── #}
  <script>
    (function () {
      var saved = localStorage.getItem('ev-theme');
      var systemPref = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      var t = saved || systemPref;
      document.documentElement.setAttribute('data-theme', t);
      if (t === 'dark') document.documentElement.classList.add('dark');
      else document.documentElement.classList.remove('dark');
    })();
  </script>

  {{ extraHead | safe }}
</head>

<body class="bg-base text-primary font-sans antialiased h-screen flex overflow-hidden selection:bg-accent selection:text-white">

  {# ══ DESKTOP SIDEBAR ══ #}
  {% include "partials/sidebar.njk" %}

  {# ══ MAIN CONTENT AREA ══ #}
  <div class="flex-1 flex flex-col min-w-0 h-screen bg-base relative">
    
    {# ══ HEADER ══ #}
    {% include "partials/header.njk" %}

    {# ══ MAIN CONTENT ══ #}
    <main class="flex-1 overflow-y-auto w-full p-4 md:p-8 pb-24 md:pb-8" id="app-content" role="main">
      <div class="max-w-4xl mx-auto w-full">
        {# Breadcrumbs #}
        {% include "partials/breadcrumbs.njk" %}
        
        {# Article / Content wrapper with Typography plugin #}
        <article class="prose dark:prose-invert prose-indigo max-w-none mt-6">
          {{ content | safe }}
        </article>
      </div>

      {# ══ FOOTER ══ #}
      {% include "partials/footer.njk" %}
    </main>
  </div>

  {# ══ SEARCH OVERLAY ══ #}
  {% include "partials/search-overlay.njk" %}

  {# ══ MOBILE DRAWER ══ #}
  {% include "partials/mobile-drawer.njk" %}

  {# ══ BOTTOM NAV (Mobile) ══ #}
  {% include "partials/bottom-nav.njk" %}

  {# ══ TOAST CONTAINER ══ #}
  <div id="toast-container" aria-live="polite" aria-atomic="true" class="fixed bottom-20 left-1/2 transform -translate-x-1/2 z-50 flex flex-col gap-2"></div>

  {# ── JS ── #}
  <script src="/js/toast.js?v=2.1.0" defer></script>
  <script src="/js/app.js?v=2.1.0" defer></script>
  <script src="/js/auth-ui.js?v=2.1.0" defer></script>
  
  {% if page.url and '/my-diary' in page.url %}
  <script src="/js/diary.js?v=2.1.0" defer></script>
  {% endif %}

  {{ extraScripts | safe }}
</body>
</html>
