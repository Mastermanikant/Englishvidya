<!DOCTYPE html>
<html lang="{{ htmlLang or 'hi' }}" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>{{ pageTitle or title or "EnglishVidya — Learn English with Logic | Master Manikant" }}</title>
  <meta name="description" content="{{ metaDescription or description or "EnglishVidya is an open, high-speed English learning platform by Master Manikant Yadav. Free Bihar Board 12th & 10th English, 10-Level Grammar Ladder, and 19,000+ Bilingual Dictionary." }}" />
  <link rel="canonical" href="https://englishvidya.com{{ page.url }}" />
  {% if noindex %}
  <meta name="robots" content="noindex, follow" />
  {% endif %}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://englishvidya.com{{ page.url }}" />
  <meta property="og:title" content="{{ pageTitle or title or "EnglishVidya — Learn English with Logic" }}" />
  <meta property="og:description" content="{{ metaDescription or description or "Free educational notes for Bihar Board 10th/12th, Grammar, and 19,000+ Dictionary." }}" />
  <meta property="og:image" content="https://englishvidya.com/assets/icons/icon-512.png" />
  <meta property="og:site_name" content="EnglishVidya" />

  <!-- Twitter Meta -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ pageTitle or title or "EnglishVidya — Learn English with Logic" }}" />
  <meta name="twitter:description" content="{{ metaDescription or description or "100% Free & Open study material for Hindi-medium students." }}" />
  <meta name="twitter:image" content="https://englishvidya.com/assets/icons/icon-512.png" />

  <!-- ANTI-FOUC DAY/NIGHT THEME SCRIPT (FRANKBASE ENGINE) -->
  <script>
    (function() {
      try {
        var savedTheme = localStorage.getItem('ev-theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
        if (savedTheme === 'dark') document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts: Outfit + Plus Jakarta Sans + JetBrains Mono + Noto Sans Devanagari -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" />

  <link rel="stylesheet" href="/css/style.css?v=6.0.0" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/assets/icons/logo.svg" />
  <link rel="apple-touch-icon" href="/assets/icons/icon-192.png" />
  <link rel="manifest" href="/manifest.json" />

  <!-- Schema.org EducationalOrganization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "EnglishVidya",
    "url": "https://englishvidya.com",
    "logo": "https://englishvidya.com/assets/icons/logo.svg",
    "founder": {
      "@type": "Person",
      "name": "Master Manikant Yadav",
      "jobTitle": "Educator & Systems Architect",
      "url": "https://mastermanikant.com"
    },
    "description": "Bihar Board 12th & 10th English, Grammar, and Hindi-English Vocabulary Platform by Master Manikant.",
    "sameAs": [
      "https://youtube.com/@englishvidyahq",
      "https://whatsapp.com/channel/0029VbCnmPe0VycPXCmBBH43"
    ]
  }
  </script>

  {{ extraHead | safe }}
</head>
<body>

  <!-- UNIVERSAL MODULAR HEADER (FRANKBASE ARCHITECTURE) -->
  {% include "partials/header.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  <!-- UNIVERSAL MODULAR FOOTER (FRANKBASE ARCHITECTURE) -->
  {% include "partials/footer.njk" %}

  <!-- Search Overlay Modal -->
  {% include "partials/search-overlay.njk" %}

  <script src="/js/app.js?v=6.0.0"></script>
  <script src="/js/bookmarks.js?v=6.0.0"></script>
</body>
</html>
