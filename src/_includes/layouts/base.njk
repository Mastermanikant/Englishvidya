<!DOCTYPE html>
<html lang="{{ htmlLang or 'hi' }}" data-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">

  {# ── Google Analytics (GA4) ── #}
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VWJHVR3VBL"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-VWJHVR3VBL');
  </script>

  {# ── SEO Meta ── #}
  <title>{{ pageTitle or title or site.siteName }}</title>
  <meta name="description" content="{{ metaDescription or description or site.siteDescription }}">
  <link rel="canonical" href="{{ site.canonicalBase }}{{ page.url }}">
  {% if noindex %}
  <meta name="robots" content="noindex">
  {% endif %}

  {# ── Open Graph (WhatsApp, Facebook, Twitter preview) ── #}
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ pageTitle or title or site.siteName }}">
  <meta property="og:description" content="{{ metaDescription or description or site.siteDescription }}">
  <meta property="og:url" content="{{ site.canonicalBase }}{{ page.url }}">
  <meta property="og:locale" content="{{ htmlLang or 'hi_IN' }}">
  <link rel="alternate" hreflang="{{ htmlLang or 'hi' }}" href="{{ site.canonicalBase }}{{ page.url }}">
  <meta property="og:image" content="{{ ogImage or site.ogImage }}">
  <meta property="og:site_name" content="{{ site.siteName }}">
  <meta name="twitter:card" content="summary_large_image">

  {# ── Theme Color ── #}
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8fafc">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c1222">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="{{ site.siteName }}">

  {# ── Favicon & PWA ── #}
  <link rel="icon" type="image/png" href="/assets/icons/icon-192.png">
  <link rel="icon" type="image/svg+xml" href="/assets/icons/logo.svg">
  <link rel="apple-touch-icon" href="/assets/icons/icon-192.png">
  <link rel="manifest" href="/manifest.json">

  {# ── Schema.org Structured Data (SEO + AEO) ── #}
  {% if schema %}
  <script type="application/ld+json">
    {{ schema | stringifySchema | safe }}
  </script>
  {% elif schemaJson %}
  <script type="application/ld+json">{{ schemaJson | safe }}</script>
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "{{ pageTitle or site.siteName }}",
    "url": "{{ site.canonicalBase }}{{ page.url }}",
    "description": "{{ metaDescription or site.siteDescription }}",
    "isPartOf": {
      "@type": "EducationalOrganization",
      "name": "{{ site.siteName }}",
      "url": "{{ site.siteUrl }}"
    }
  }
  </script>
  {% endif %}

  {# ── Fonts ── #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800;900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800;900&display=swap"></noscript>

  {# ── CSS ── #}
  <link rel="stylesheet" href="/css/style.css?v=2.0.7">

  {# ── FOUC Prevention + Theme / Font-Scale Restore ── #}
  <script>
    (function () {
      // System theme detection on first visit
      var saved = localStorage.getItem('ev-theme');
      var systemPref = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      var t = saved || systemPref;
      document.documentElement.setAttribute('data-theme', t);
      
      // Font scale restore — only on html element (respects browser accessibility)
      var s = localStorage.getItem('ev-text-scale');
      if (s) {
        document.documentElement.style.fontSize = (parseFloat(s) * 100) + '%';
      }
    })();
  </script>

  {# ── Page-specific extra head content ── #}
  {{ extraHead | safe }}
</head>

<body>
  <a href="#app-content" class="skip-link">Skip to main content</a>
  {# ✨ Scroll Progress Bar ✨ #}
  <div class="scroll-progress-track" aria-hidden="true">
    <div class="scroll-progress-bar" id="scroll-progress"></div>
  </div>

  {# ══ HEADER — एक जगह बदलो, सब जगह बदलेगा ══ #}
  {% include "partials/header.njk" %}

  {# ══ SEARCH OVERLAY ══ #}
  {% include "partials/search-overlay.njk" %}

  {# ══ MAIN CONTENT ══ #}
  <main class="app-main" id="app-content" role="main">
    {# Breadcrumbs — automatically shown when page has breadcrumbs frontmatter #}
    {% include "partials/breadcrumbs.njk" %}
    {{ content | safe }}
  </main>

  {# ══ FOOTER ══ #}
  {% include "partials/footer.njk" %}

  {# ══ BOTTOM NAV (Mobile) ══ #}
  {% include "partials/bottom-nav.njk" %}

  {# ══ TOAST CONTAINER ══ #}
  <div id="toast-container" aria-live="polite" aria-atomic="true"></div>

  {# ── JS — existing app files ── #}
  <script src="/js/toast.js?v=2.0.8" defer></script>
  <script src="/js/app.js?v=2.0.8" defer></script>
  <script src="/js/heartbeat.js?v=2.0.8" defer></script>
  <script src="/js/auth-ui.js?v=2.0.8" defer></script>
  <script src="/js/bookmarks.js?v=2.0.8" defer></script>
  <script src="/js/alpine.min.js" defer></script>

  {% if page.url == '/' %}
  <script src="/js/home-redesign.js?v=2.0.8" defer></script>
  {% endif %}

  {% if page.url and '/my-diary' in page.url %}
  <script src="/js/diary.js?v=2.0.8" defer></script>
  {% endif %}

  {% if page.url and ('/grammar' in page.url or '/meaning' in page.url or '/article' in page.url) %}
  <script src="/js/community.js?v=2.0.8" defer></script>
  {% endif %}

  <script>
    // Lazy Load Search
    document.addEventListener('DOMContentLoaded', () => {
      const searchTriggerBtns = document.querySelectorAll('#search-trigger-btn');
      let searchLoaded = false;
      
      searchTriggerBtns.forEach(btn => {
        btn.addEventListener('click', function loadSearch(e) {
          e.preventDefault();
          if (searchLoaded) return;
          searchLoaded = true;
          
          const fuseScript = document.createElement('script');
          fuseScript.src = '/js/fuse.js';
          fuseScript.defer = true;
          document.body.appendChild(fuseScript);
          
          const searchScript = document.createElement('script');
          searchScript.src = '/js/search.js?v=2.0.8';
          searchScript.defer = true;
          fuseScript.onload = () => {
            document.body.appendChild(searchScript);
            searchScript.onload = () => {
              if (window.openSearch) {
                window.openSearch();
              }
            };
          };
        });
      });
    });
  </script>

  {{ extraScripts | safe }}

  {# ── PWA Service Worker Registration & Update Notification ── #}

  <script>
    (function() {
      let refreshing = false;
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (refreshing) return;
          refreshing = true;
          window.location.reload();
        });
      }

      window.showUpdateToast = function(worker) {
        if (document.querySelector('.update-toast:not(.temp-toast)')) return;

        const toast = document.createElement('div');
        toast.className = 'update-toast';
        toast.innerHTML = `
          <div style="flex: 1; font-size: 0.95rem; line-height: 1.4; font-family: inherit;">
            ✨ नया अपडेट उपलब्ध है! (New Update Available)
          </div>
          <button id="toast-update-btn">अपडेट करें</button>
        `;
        
        toast.querySelector('#toast-update-btn').addEventListener('click', () => {
          worker.postMessage({ type: 'SKIP_WAITING' });
        });

        document.getElementById('toast-container').appendChild(toast);
      };

      window.showTemporaryToast = function(message) {
        const existing = document.querySelector('.temp-toast');
        if (existing) existing.remove();

        const toast = document.createElement('div');
        toast.className = 'update-toast temp-toast';
        toast.style.background = 'linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(30, 41, 59, 0.9))';
        toast.innerHTML = `<div style="flex: 1; font-size: 0.95rem; font-family: inherit;">${message}</div>`;
        document.getElementById('toast-container').appendChild(toast);
        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transition = 'opacity 0.5s ease';
          setTimeout(() => toast.remove(), 500);
        }, 3000);
      };

      window.checkForUpdates = function() {
        if ('serviceWorker' in navigator) {
          window.showTemporaryToast('अपडेट की जांच की जा रही है... 🔄');
          navigator.serviceWorker.getRegistration().then(reg => {
            if (reg) {
              reg.update().then(() => {
                if (reg.waiting) {
                  window.showUpdateToast(reg.waiting);
                } else if (reg.installing) {
                  reg.installing.addEventListener('statechange', (e) => {
                    if (e.target.state === 'installed') {
                      window.showUpdateToast(e.target);
                    }
                  });
                } else {
                  window.showTemporaryToast('EnglishVidya पहले से ही अप-टू-डेट है! 🚀');
                }
              }).catch(err => {
                console.error('[SW] Update check error:', err);
                window.showTemporaryToast('अपडेट चेक करने में विफलता आई।');
              });
            } else {
              window.showTemporaryToast('कोई Service Worker सक्रिय नहीं है।');
            }
          });
        } else {
          window.showTemporaryToast('यह ब्राउज़र PWA का समर्थन नहीं करता है।');
        }
      };

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/service-worker.js')
            .then(function (reg) {
              console.log('[SW] Registered:', reg.scope);

              // Check if waiting
              if (reg.waiting) {
                window.showUpdateToast(reg.waiting);
              }

              // Check if updating
              reg.addEventListener('updatefound', () => {
                const newWorker = reg.installing;
                newWorker.addEventListener('statechange', () => {
                  if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                    window.showUpdateToast(newWorker);
                  }
                });
              });
            })
            .catch(function (err) {
              console.warn('[SW] Registration failed:', err);
            });
        });
      }
    })();
  </script>

  {# ── Text Scaling Widget & Teacher Mode ── #}


  <div id="ev-watermark" aria-hidden="true">EnglishVidya.com</div>

  <div id="screen-dimmer" class="screen-dimmer-overlay"></div>

  <div id="text-scaler-widget" class="text-scaler-widget" style="display: none; touch-action: none;" role="region" aria-label="Text Size Adjustment">
    <button id="text-scaler-toggle" class="text-scaler-toggle" aria-label="Adjust text size" aria-expanded="false">
      Aa
    </button>
    <div id="text-scaler-panel" class="text-scaler-panel" aria-hidden="true" style="display: flex;">
      <!-- Zoom Control -->
      <div style="display: flex; flex-direction: column; gap: 4px; width: 100%;">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--text-secondary);">
          <span>Text Zoom</span>
          <span id="text-scaler-value" class="panel-value" style="font-weight: 700; color: var(--accent); min-width: auto; text-align: right;">100%</span>
        </div>
        <div style="display: flex; gap: 6px; align-items: center; justify-content: space-between; width: 100%;">
          <button id="text-scaler-dec" class="zoom-btn" aria-label="Decrease text size">A-</button>
          <input type="range" id="text-zoom-slider" min="50" max="200" step="10" value="100" style="flex: 1; cursor: pointer; accent-color: var(--accent); height: 6px; border-radius: 3px;">
          <button id="text-scaler-inc" class="zoom-btn" aria-label="Increase text size" style="font-size: 16px !important;">A+</button>
        </div>
      </div>
      
      <!-- Brightness/Dimmer Control -->
      <div style="display: flex; flex-direction: column; gap: 4px; border-top: 1px solid var(--border); padding-top: 8px; width: 100%;">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--text-secondary);">
          <span>Brightness</span>
        </div>
        <div style="display: flex; gap: 6px; align-items: center; justify-content: space-between; width: 100%;">
          <span style="font-size: 14px;" title="Light">☀️</span>
          <input type="range" id="screen-dimmer-slider" min="0" max="80" value="0" style="flex: 1; cursor: pointer; accent-color: var(--accent); height: 6px; border-radius: 3px;">
          <span style="font-size: 14px;" title="Dark">🌙</span>
        </div>
      </div>
      
      <!-- Actions -->
      <div style="display: flex; gap: 6px; border-top: 1px solid var(--border); padding-top: 8px; align-items: center; justify-content: space-between; width: 100%;">
        <button id="teacher-fullscreen" class="action-btn" aria-label="Teacher Full Screen" title="Teacher Full Screen" style="background: var(--accent); color: white; border: none; width: 32px; height: 32px; border-radius: 8px; font-weight: bold; font-size: 16px; display: flex; align-items: center; justify-content: center; cursor: pointer;">⛶</button>
        <button id="text-scaler-reset" class="action-btn reset-btn" style="flex: 1; height: 32px; background: var(--bg-hover); color: var(--text-primary); border: 1px solid var(--border); cursor: pointer; font-weight: 600;" title="Reset text size">Reset</button>
        <button id="text-scaler-hide" class="action-btn hide-btn" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;" title="Hide this widget">✕</button>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const widget = document.getElementById('text-scaler-widget');
      const toggle = document.getElementById('text-scaler-toggle');
      const panel = document.getElementById('text-scaler-panel');
      
      const dimmerSlider = document.getElementById('screen-dimmer-slider');
      const screenDimmer = document.getElementById('screen-dimmer');
      if (dimmerSlider && screenDimmer) {
        let savedDimmer = localStorage.getItem('ev-screen-dimmer') || '0';
        dimmerSlider.value = savedDimmer;
        screenDimmer.style.backgroundColor = `rgba(0, 0, 0, ${savedDimmer / 100})`;
        
        dimmerSlider.addEventListener('input', (e) => {
          const val = e.target.value;
          screenDimmer.style.backgroundColor = `rgba(0, 0, 0, ${val / 100})`;
          localStorage.setItem('ev-screen-dimmer', val);
        });
      }
      const decBtn = document.getElementById('text-scaler-dec');
      const incBtn = document.getElementById('text-scaler-inc');
      const resetBtn = document.getElementById('text-scaler-reset');
      const hideBtn = document.getElementById('text-scaler-hide');
      const fullScreenBtn = document.getElementById('teacher-fullscreen');
      const headerBtn = document.getElementById('text-scaler-header-btn');
      const drawerBtn = document.getElementById('text-scaler-drawer-btn');
      const zoomSlider = document.getElementById('text-zoom-slider');
      
      if (!widget || !toggle) return;

      const isHidden = localStorage.getItem('ev-text-scaler-hidden') === 'true';
      if (!isHidden) {
        widget.style.display = 'flex';
      }

      function togglePanelState() {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        const nextState = !isExpanded;
        toggle.setAttribute('aria-expanded', nextState);
        panel.setAttribute('aria-hidden', !nextState);
        panel.classList.toggle('active', nextState);

        // If opening, ensure it doesn't overflow the right edge of the screen
        if (nextState) {
          requestAnimationFrame(() => {
            const rect = widget.getBoundingClientRect();
            const viewportWidth = window.innerWidth;
            if (rect.right > viewportWidth - 10) {
              const overflow = rect.right - (viewportWidth - 10);
              let newLeft = rect.left - overflow;
              newLeft = Math.max(10, newLeft);
              widget.style.left = newLeft + 'px';
              localStorage.setItem('ev-text-scaler-left', widget.style.left);
            }
          });
        }
      }

      function toggleScaler(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        
        // Ensure widget is visible and save preference
        widget.style.display = 'flex';
        localStorage.setItem('ev-text-scaler-hidden', 'false');
        
        togglePanelState();
      }

      if (headerBtn) {
        headerBtn.addEventListener('click', toggleScaler);
      }
      if (drawerBtn) {
        drawerBtn.addEventListener('click', toggleScaler);
      }

      // Restore presenter mode state
      let isPresenterMode = localStorage.getItem('ev-presenter-mode') === 'true';
      if (isPresenterMode) document.body.classList.add('presenter-mode');

      fullScreenBtn.addEventListener('click', () => {
        isPresenterMode = !isPresenterMode;
        if (isPresenterMode) {
          document.body.classList.add('presenter-mode');
          localStorage.setItem('ev-presenter-mode', 'true');
          const elem = document.documentElement;
          if (elem.requestFullscreen) {
            elem.requestFullscreen().catch(err => console.log(err));
          } else if (elem.webkitRequestFullscreen) {
            elem.webkitRequestFullscreen();
          } else if (elem.msRequestFullscreen) {
            elem.msRequestFullscreen();
          }
        } else {
          document.body.classList.remove('presenter-mode');
          localStorage.setItem('ev-presenter-mode', 'false');
          if (document.exitFullscreen && document.fullscreenElement) {
            document.exitFullscreen().catch(err => console.log(err));
          } else if (document.webkitExitFullscreen && document.webkitFullscreenElement) {
            document.webkitExitFullscreen();
          } else if (document.msExitFullscreen && document.msFullscreenElement) {
            document.msExitFullscreen();
          }
        }
      });

      document.addEventListener('fullscreenchange', () => {
        if (!document.fullscreenElement) {
          isPresenterMode = false;
          document.body.classList.remove('presenter-mode');
          localStorage.setItem('ev-presenter-mode', 'false');
        }
      });

      const savedLeft = localStorage.getItem('ev-text-scaler-left');
      const savedTop = localStorage.getItem('ev-text-scaler-top');
      if (savedLeft !== null && savedTop !== null) {
        widget.style.left = savedLeft;
        widget.style.top = savedTop;
        widget.style.bottom = 'auto';
        widget.style.right = 'auto';
      }

      let currentScale = parseFloat(localStorage.getItem('ev-text-scale') || '1.0');
      
      function setScale(scale) {
        currentScale = Math.max(0.5, Math.min(2.0, scale));
        document.documentElement.style.fontSize = (currentScale * 100) + '%';
        localStorage.setItem('ev-text-scale', currentScale);
        const valEl = document.getElementById('text-scaler-value');
        if (valEl) valEl.textContent = Math.round(currentScale * 100) + '%';
        
        if (zoomSlider) {
          zoomSlider.value = Math.round(currentScale * 100);
        }
      }

      setScale(currentScale);

      if (zoomSlider) {
        zoomSlider.value = Math.round(currentScale * 100);
        zoomSlider.addEventListener('input', (e) => {
          setScale(parseFloat(e.target.value) / 100);
        });
      }

      decBtn.addEventListener('click', () => setScale(currentScale - 0.1));
      incBtn.addEventListener('click', () => setScale(currentScale + 0.1));
      resetBtn.addEventListener('click', () => {
        setScale(1.0);
        if (dimmerSlider && screenDimmer) {
          dimmerSlider.value = 0;
          screenDimmer.style.backgroundColor = 'rgba(0, 0, 0, 0)';
          localStorage.setItem('ev-screen-dimmer', '0');
        }
      });
      hideBtn.addEventListener('click', () => {
        if (toggle.getAttribute('aria-expanded') === 'true') {
          togglePanelState();
        }
      });

      // ── Ad-Free Pass Warning Timer & State Logic ──
      let warningTimerDiv = null;
      let adFreeInterval = null;

      function checkAdFreeStatus() {
        const noAdsUntilStr = localStorage.getItem('ev-no-ads-until');
        const showWarningPref = localStorage.getItem('ev-show-warning-timer') !== 'false';
        
        if (noAdsUntilStr) {
          const expirationTime = parseInt(noAdsUntilStr, 10);
          const now = Date.now();
          const remainingMs = expirationTime - now;
          
          if (remainingMs > 0) {
            document.body.classList.add('no-ads-active');
            
            // Show red warning timer if 1 minute remains and setting is enabled
            if (remainingMs <= 60000 && showWarningPref) {
              if (!warningTimerDiv) {
                warningTimerDiv = document.createElement('div');
                warningTimerDiv.id = 'ad-free-warning-timer';
                document.body.appendChild(warningTimerDiv);
              }
              const remainingSec = Math.ceil(remainingMs / 1000);
              warningTimerDiv.innerHTML = `⚠️ <span style="color:#ef4444;margin-left:2px;">00:${remainingSec.toString().padStart(2, '0')}</span>`;
            } else {
              if (warningTimerDiv) {
                warningTimerDiv.remove();
                warningTimerDiv = null;
              }
            }
            return;
          }
        }
        
        document.body.classList.remove('no-ads-active');
        if (warningTimerDiv) {
          warningTimerDiv.remove();
          warningTimerDiv = null;
        }
      }

      checkAdFreeStatus();
      adFreeInterval = setInterval(checkAdFreeStatus, 1000);

      let isDragging = false;
      let startX, startY;
      let initialLeft, initialTop;
      let dragThreshold = 10;

      function onStart(e) {
        const clientX = e.type.startsWith('touch') ? e.touches[0].clientX : e.clientX;
        const clientY = e.type.startsWith('touch') ? e.touches[0].clientY : e.clientY;
        
        isDragging = false;
        startX = clientX;
        startY = clientY;
        
        const rect = widget.getBoundingClientRect();
        initialLeft = rect.left;
        initialTop = rect.top;
        
        widget.style.bottom = 'auto';
        widget.style.right = 'auto';
        widget.style.left = initialLeft + 'px';
        widget.style.top = initialTop + 'px';
        
        if (e.type === 'touchstart') {
          document.addEventListener('touchmove', onMove, { passive: false });
          document.addEventListener('touchend', onEnd);
        } else {
          document.addEventListener('mousemove', onMove);
          document.addEventListener('mouseup', onEnd);
        }
      }

      function onMove(e) {
        const clientX = e.type.startsWith('touch') ? e.touches[0].clientX : e.clientX;
        const clientY = e.type.startsWith('touch') ? e.touches[0].clientY : e.clientY;
        
        const dx = clientX - startX;
        const dy = clientY - startY;
        const dist = Math.sqrt(dx * dx + dy * dy);
        
        if (!isDragging && dist > dragThreshold) {
          isDragging = true;
        }
        
        if (isDragging) {
          if (e.cancelable) e.preventDefault();
          
          let newLeft = initialLeft + dx;
          let newTop = initialTop + dy;
          
          const viewportWidth = window.innerWidth;
          const viewportHeight = window.innerHeight;
          const rect = widget.getBoundingClientRect();
          
          // Calculate boundaries based on whether the panel is active/open
          const isPanelActive = panel.classList.contains('active');
          const visibleWidth = isPanelActive ? rect.width : toggle.getBoundingClientRect().width;
          const visibleHeight = isPanelActive ? rect.height : toggle.getBoundingClientRect().height;
          
          newLeft = Math.max(10, Math.min(viewportWidth - visibleWidth - 10, newLeft));
          newTop = Math.max(10, Math.min(viewportHeight - visibleHeight - 10, newTop));
          
          widget.style.left = newLeft + 'px';
          widget.style.top = newTop + 'px';
        }
      }

      function onEnd(e) {
        if (e.type === 'touchend') {
          document.removeEventListener('touchmove', onMove);
          document.removeEventListener('touchend', onEnd);
        } else {
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onEnd);
        }
        
        if (isDragging) {
          localStorage.setItem('ev-text-scaler-left', widget.style.left);
          localStorage.setItem('ev-text-scaler-top', widget.style.top);
        } else {
          togglePanelState();
        }
      }

      toggle.addEventListener('mousedown', onStart);
      toggle.addEventListener('touchstart', (e) => {
        // Only trigger onStart if the target isn't a child element with its own logic
        onStart(e);
      }, { passive: true });
    });
  </script>
  <!-- Global Annotation Tool Trigger (Lazy Loaded) -->
  <button id="ev-global-pen-trigger" title="Smart Writing Tool (Draw on Screen)" aria-label="Toggle Smart Writing Tool" style="position: fixed; bottom: 20px; right: 70px; width: 48px; height: 48px; border-radius: 50%; background: #013220; color: white; border: 2px solid rgba(255,255,255,0.1); box-shadow: 0 4px 16px rgba(0,0,0,0.3); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 20px; z-index: 9999; transition: all 0.2s;">
    ✏️
  </button>
  <script>
    document.getElementById('ev-global-pen-trigger').addEventListener('click', function() {
      const btn = this;
      
      // Load CSS if not loaded
      if (!document.getElementById('ev-annotation-css')) {
        const link = document.createElement('link');
        link.id = 'ev-annotation-css';
        link.rel = 'stylesheet';
        link.href = '/css/annotation-tool.css';
        document.head.appendChild(link);
      }
      
      // Load JS if not loaded
      if (!window.EVAnnotationEngine) {
        btn.innerHTML = '⏳'; // Loading state
        const script = document.createElement('script');
        script.src = '/js/annotation-tool.js';
        script.onload = () => {
          const isActive = window.EVAnnotationEngine.toggleEngine();
          btn.innerHTML = isActive ? '❌' : '✏️';
          if (isActive) btn.style.background = '#ef4444';
          else btn.style.background = '#013220';
        };
        document.body.appendChild(script);
      } else {
        const isActive = window.EVAnnotationEngine.toggleEngine();
        btn.innerHTML = isActive ? '❌' : '✏️';
        if (isActive) btn.style.background = '#ef4444';
        else btn.style.background = '#013220';
      }
    });
  </script>
</body>
</html>
