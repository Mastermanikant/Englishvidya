---
layout: layouts/base.njk
---

<div class="max-w-4xl mx-auto w-full px-2 sm:px-4 py-4">

  <!-- 1. Sticky Study Toolbar -->
  <div class="sticky top-16 z-20 bg-base/95 backdrop-blur-md border border-border/90 rounded-2xl p-3 sm:p-4 mb-6 shadow-xs flex flex-wrap items-center justify-between gap-3">
    
    <!-- Left: Breadcrumb & Progress -->
    <div class="flex items-center gap-2 text-xs text-secondary font-medium">
      <a href="/" class="hover:text-accent transition-colors">Home</a>
      <span>/</span>
      {% if tags and "class-12" in tags %}
      <a href="/class-12/" class="hover:text-accent transition-colors">Class 12th</a>
      {% elif tags and "class-10" in tags %}
      <a href="/class-10/" class="hover:text-accent transition-colors">Class 10th</a>
      {% elif tags and "grammar" in tags %}
      <a href="/grammar/" class="hover:text-accent transition-colors">Grammar</a>
      {% else %}
      <span>Study Material</span>
      {% endif %}
      <span>/</span>
      <span class="text-primary font-bold truncate max-w-[150px] sm:max-w-[250px]">{{ title | default(pageTitle) }}</span>
    </div>

    <!-- Right: Reader Controls (Font size, Audio, Print, Bookmark) -->
    <div class="flex items-center gap-1.5 shrink-0">
      
      <!-- Font Size Adjuster -->
      <div class="flex items-center bg-raised border border-border rounded-lg p-0.5 text-xs font-bold text-secondary">
        <button onclick="window.changeArticleFontSize && window.changeArticleFontSize(-1)" class="px-2 py-1 hover:text-accent rounded transition-colors" title="Decrease Font Size" aria-label="Decrease Font Size">A−</button>
        <button onclick="window.changeArticleFontSize && window.changeArticleFontSize(1)" class="px-2 py-1 hover:text-accent rounded transition-colors" title="Increase Font Size" aria-label="Increase Font Size">A+</button>
      </div>

      <!-- 3-Speed Audio Player Button -->
      <button onclick="window.toggleSpeechPlayer && window.toggleSpeechPlayer()" class="px-2.5 py-1.5 rounded-lg bg-raised border border-border hover:border-accent text-xs font-semibold text-primary flex items-center gap-1 transition-colors" title="Listen with Audio (3-Speed)" aria-label="Listen with Audio">
        <span>🔊 सुनो</span>
      </button>

      <!-- Print / PDF Button -->
      <button onclick="window.print()" class="px-2.5 py-1.5 rounded-lg bg-raised border border-border hover:border-accent text-xs font-semibold text-primary flex items-center gap-1 transition-colors" title="Print / Save PDF Notes" aria-label="Print Notes">
        <span>🖨️ प्रिंट</span>
      </button>

      <!-- Save / Bookmark Button -->
      <button onclick="window.saveCurrentChapterBookmark && window.saveCurrentChapterBookmark()" class="px-2.5 py-1.5 rounded-lg bg-raised border border-border hover:border-accent text-xs font-semibold text-primary flex items-center gap-1 transition-colors" title="Bookmark Chapter" aria-label="Bookmark Chapter">
        <span>🔖</span>
      </button>

    </div>
  </div>

  <!-- 2. Reading Progress Line Indicator -->
  <div class="fixed top-16 left-0 right-0 h-1 bg-border/40 z-30">
    <div id="reading-progress-bar" class="h-full bg-sky-500 transition-all duration-100" style="width: 0%;"></div>
  </div>

  <!-- 3. Main Reading Content Container -->
  <div class="bg-raised border border-border/80 rounded-3xl p-6 sm:p-10 shadow-xs">
    
    <!-- Meta & Collapsible Controls Header -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-6 mb-6 border-b border-border text-xs text-secondary">
      <div class="flex items-center gap-3">
        {% if date %}
        <span>📅 {{ date | toISO | truncate(10, true, "") }}</span>
        {% endif %}
        <span class="inline-flex items-center gap-1 font-semibold text-sky-500 bg-sky-500/10 px-2.5 py-0.5 rounded-full">
          <span>🎯</span> बिहार बोर्ड स्पेशल
        </span>
      </div>

      <div class="flex items-center gap-2">
        <button id="collapse-all-btn" class="px-3 py-1.5 rounded-lg bg-base border border-border hover:border-accent font-semibold text-xs transition-colors">
          🗜️ Collapse All
        </button>
        <button id="expand-all-btn" class="px-3 py-1.5 rounded-lg bg-base border border-border hover:border-accent font-semibold text-xs transition-colors">
          📖 Expand All
        </button>
      </div>
    </div>

    <!-- Article Content (Line-by-line, summary, Q&A) -->
    <article class="markdown-body prose dark:prose-invert max-w-none text-base sm:text-lg leading-relaxed">
      {{ content | safe }}
    </article>

    <!-- 4. Interactive 5-Star Chapter Rating Card -->
    <div class="mt-12 p-6 rounded-2xl bg-base border border-border text-center space-y-3">
      <h3 class="text-base sm:text-lg font-bold font-heading text-primary">
        ⭐ क्या यह पाठ आपको अच्छी तरह समझ आया?
      </h3>
      <p class="text-xs sm:text-sm text-secondary">
        अपनी समझ के अनुसार रेटिंग दें ताकि हम इसे और बेहतर बना सकें।
      </p>
      <div class="flex items-center justify-center gap-2 text-2xl" id="chapter-rating-stars">
        <button onclick="window.rateChapter && window.rateChapter(1)" class="hover:scale-125 transition-transform" title="1 Star" aria-label="1 Star">⭐</button>
        <button onclick="window.rateChapter && window.rateChapter(2)" class="hover:scale-125 transition-transform" title="2 Stars" aria-label="2 Stars">⭐</button>
        <button onclick="window.rateChapter && window.rateChapter(3)" class="hover:scale-125 transition-transform" title="3 Stars" aria-label="3 Stars">⭐</button>
        <button onclick="window.rateChapter && window.rateChapter(4)" class="hover:scale-125 transition-transform" title="4 Stars" aria-label="4 Stars">⭐</button>
        <button onclick="window.rateChapter && window.rateChapter(5)" class="hover:scale-125 transition-transform" title="5 Stars" aria-label="5 Stars">⭐</button>
      </div>
      <div id="chapter-rating-status" class="text-xs font-semibold text-emerald-500 hidden">
        धन्यवाद! आपकी रेटिंग दर्ज हो गई है।
      </div>
    </div>

    <!-- 5. WhatsApp Doubt & Sharing Bar -->
    <div class="mt-8 p-6 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <div class="space-y-1 text-center sm:text-left">
        <strong class="text-sm text-emerald-700 dark:text-emerald-400 font-bold block">💡 कोई लाइन या प्रश्न समझ नहीं आया?</strong>
        <span class="text-secondary">मास्टर मणिकांत सर से सीधे WhatsApp पर डाउट पूछें।</span>
      </div>
      <a href="https://api.whatsapp.com/send?text={{ ('नमस्ते सर, मुझे EnglishVidya पर इस पाठ में डाउट है: ' + (title | default(pageTitle)) + ' - https://englishvidya.com' + page.url) | urlencode }}" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold whitespace-nowrap transition-colors flex items-center gap-1.5">
        <span>💬 WhatsApp पर डाउट पूछें</span>
      </a>
    </div>

    <!-- 6. Next / Previous Navigation -->
    <div class="mt-10 pt-6 border-t border-border flex items-center justify-between gap-4">
      <a href="/" class="px-4 py-2 rounded-xl bg-base border border-border hover:border-accent text-xs sm:text-sm font-semibold text-primary transition-colors">
        ← होमपेज (Home)
      </a>
      {% if tags and "class-12" in tags %}
      <a href="/class-12/" class="px-4 py-2 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 text-xs sm:text-sm font-bold transition-colors">
        12वीं के सभी पाठ देखें →
      </a>
      {% elif tags and "class-10" in tags %}
      <a href="/class-10/" class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs sm:text-sm font-bold transition-colors">
        10वीं के सभी पाठ देखें →
      </a>
      {% else %}
      <a href="/grammar/" class="px-4 py-2 rounded-xl bg-indigo-500 hover:bg-indigo-400 text-white text-xs sm:text-sm font-bold transition-colors">
        व्याकरण के सभी पाठ देखें →
      </a>
      {% endif %}
    </div>

  </div>
</div>

<script src="/js/collapsible.js?v=2.1.0" defer></script>
<script>
// Article Reader Utilities
(function() {
  let currentZoom = 100;
  window.changeArticleFontSize = function(delta) {
    const article = document.querySelector('.markdown-body');
    if (!article) return;
    currentZoom = Math.min(140, Math.max(85, currentZoom + (delta * 10)));
    article.style.fontSize = (currentZoom / 100) * 1.1 + 'rem';
  };

  window.rateChapter = function(stars) {
    const status = document.getElementById('chapter-rating-status');
    if (status) status.classList.remove('hidden');
    if (window.showToast) window.showToast(`⭐ आपने ${stars}/5 स्टार रेटिंग दी! धन्यवाद।`, 'success');
  };

  window.saveCurrentChapterBookmark = function() {
    const bookmarks = JSON.parse(localStorage.getItem('ev-bookmarks') || '[]');
    const title = document.title || 'Chapter Note';
    const url = window.location.pathname;
    
    if (!bookmarks.some(b => b.url === url)) {
      bookmarks.unshift({ title, url, date: new Date().toISOString() });
      localStorage.setItem('ev-bookmarks', JSON.stringify(bookmarks));
      if (window.showToast) window.showToast('🔖 चैप्टर बुकमार्क में सुरक्षित हो गया!', 'success');
      else alert('🔖 चैप्टर बुकमार्क में सुरक्षित हो गया!');
    } else {
      if (window.showToast) window.showToast('ℹ️ यह चैप्टर पहले से बुकमार्क है!', 'info');
      else alert('ℹ️ यह चैप्टर पहले से बुकमार्क है!');
    }
  };
})();
</script>
