---
layout: layouts/base.njk
pageTitle: "Forgot Password - EnglishVidya"
permalink: /forgot-password/
---

<div class="auth-container">
  <h1 class="auth-title">🔑 Password Recovery</h1>
  <p class="auth-desc">
    अपना रजिस्टर्ड ईमेल या यूज़रनेम दर्ज करें ताकि हम आपको पासवर्ड रीसेट करने के लिए ६-अंकीय OTP और लिंक भेज सकें।
  </p>

  <div id="alert-msg" class="auth-error" style="display: none; padding: 12px; margin-bottom: 18px;"></div>

  <!-- Step 1 Form -->
  <form id="forgot-form-step1" class="auth-form">
    <div class="form-group">
      <label class="auth-label">Email or Username (ईमेल या यूज़रनेम)</label>
      <input type="text" id="input-email-username" class="auth-input" placeholder="e.g. rohan@email.com or rohan_12" required>
    </div>
    <button type="submit" class="btn-primary auth-submit-btn" id="btn-step1">Next (आगे बढ़ें)</button>
  </form>

  <!-- Step 2 Form (Recovery Email Choice) -->
  <form id="forgot-form-step2" class="auth-form" style="display: none; gap: 20px;">
    <p class="auth-desc" style="margin-bottom: 0;">
      आपके अकाउंट में एक वैकल्पिक रिकवरी ईमेल भी सेट है। कृपया रीसेट कोड भेजने के लिए इनमें से कोई एक ईमेल चुनें:
    </p>
    
    <div class="auth-radio-group">
      <label class="auth-radio-label">
        <input type="radio" name="target-email" value="primary" checked>
        <div>
          <span class="auth-radio-title">Primary Email (मुख्य ईमेल)</span>
          <div id="obfuscated-primary" class="auth-radio-sub"></div>
        </div>
      </label>

      <label class="auth-radio-label">
        <input type="radio" name="target-email" value="recovery" checked>
        <div>
          <span class="auth-radio-title">Recovery Email (बैकअप ईमेल)</span>
          <div id="obfuscated-recovery" class="auth-radio-sub"></div>
        </div>
      </label>
    </div>

    <button type="submit" class="btn-primary auth-submit-btn" id="btn-step2">Send Reset Details (रीसेट कोड भेजें)</button>
  </form>

  <!-- Success Message State -->
  <div id="success-state" style="display: none; text-align: center;">
    <div style="font-size: 3rem; margin-bottom: 15px;">✉️</div>
    <h3 class="auth-title" style="margin-bottom: 10px;">OTP Sent Successfully!</h3>
    <p id="success-text" class="auth-desc" style="margin-bottom: 24px;"></p>
    <a href="/reset-password/" class="btn-primary auth-submit-btn" style="display: inline-block; text-decoration: none;">Enter OTP (ओटीपी दर्ज करें)</a>
  </div>

  <!-- Local Dev Debug Container -->
  <div id="dev-debug-container" class="auth-dev-debug">
    <h4 class="auth-dev-title">⚠️ [Developer Mode] Local Details</h4>
    <div class="auth-dev-content">
      <strong>OTP Code:</strong> <code id="dev-otp-code" class="auth-dev-code"></code><br>
      <strong>Reset Link:</strong> <a id="dev-reset-link" href="" class="auth-dev-link"></a>
    </div>
  </div>

  <div class="auth-footer">
    <a href="/login/" class="auth-back-link">← Back to Login</a>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const alertBox = document.getElementById('alert-msg');
  const step1Form = document.getElementById('forgot-form-step1');
  const step2Form = document.getElementById('forgot-form-step2');
  const successState = document.getElementById('success-state');
  const successText = document.getElementById('success-text');
  
  const devDebugContainer = document.getElementById('dev-debug-container');
  const devOtpCode = document.getElementById('dev-otp-code');
  const devResetLink = document.getElementById('dev-reset-link');

  let currentUsernameOrEmail = '';

  function showAlert(msg, isError = true) {
    alertBox.style.display = 'block';
    if (isError) {
      alertBox.style.backgroundColor = 'rgba(220, 38, 38, 0.1)';
      alertBox.style.borderColor = 'var(--error)';
      alertBox.style.color = 'var(--error)';
    } else {
      alertBox.style.backgroundColor = 'rgba(34, 197, 94, 0.1)';
      alertBox.style.borderColor = 'var(--success)';
      alertBox.style.color = 'var(--success)';
    }
    alertBox.textContent = msg;
  }

  // Handle Step 1 Submit
  step1Form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const inputVal = document.getElementById('input-email-username').value.trim();
    if (!inputVal) return;

    const btn = document.getElementById('btn-step1');
    btn.disabled = true;
    btn.textContent = 'Processing...';
    alertBox.style.display = 'none';

    try {
      const res = await fetch('/api/auth-reset-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ emailOrUsername: inputVal })
      });
      const data = await res.json();

      if (res.ok) {
        currentUsernameOrEmail = inputVal;
        if (data.requireChoice) {
          // Show Step 2 Choice Form
          document.getElementById('obfuscated-primary').textContent = data.primaryEmail;
          document.getElementById('obfuscated-recovery').textContent = data.recoveryEmail;
          
          step1Form.style.display = 'none';
          step2Form.style.display = 'flex';
        } else {
          // Automatically sent to primary email, show success state
          step1Form.style.display = 'none';
          successState.style.display = 'block';
          successText.textContent = data.message || `एक पासवर्ड रीसेट लिंक और ६-अंकीय OTP कोड आपके पंजीकृत ईमेल पर भेज दिया गया है। यह कोड ३० घंटे के लिए वैध रहेगा।`;
          
          if (data.devMode) {
            devDebugContainer.style.display = 'block';
            devOtpCode.textContent = data.devOtp;
            devResetLink.href = data.devResetLink;
            devResetLink.textContent = data.devResetLink;
          }
        }
      } else {
        showAlert(data.error || 'अकाउंट खोजने में त्रुटि हुई।');
      }
    } catch (err) {
      showAlert('नेटवर्क त्रुटि। कृपया पुनः प्रयास करें।');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Next (आगे बढ़ें)';
    }
  });

  // Handle Step 2 Submit
  step2Form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const selectedTarget = document.querySelector('input[name="target-email"]:checked').value;
    const btn = document.getElementById('btn-step2');
    btn.disabled = true;
    btn.textContent = 'Sending...';
    alertBox.style.display = 'none';

    try {
      const res = await fetch('/api/auth-reset-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          emailOrUsername: currentUsernameOrEmail,
          sendTo: selectedTarget
        })
      });
      const data = await res.json();

      if (res.ok) {
        step2Form.style.display = 'none';
        successState.style.display = 'block';
        successText.textContent = data.message || `पासवर्ड रीसेट लिंक और ६-अंकीय OTP कोड आपके चुने हुए ईमेल पर भेज दिया गया है।`;
        
        if (data.devMode) {
          devDebugContainer.style.display = 'block';
          devOtpCode.textContent = data.devOtp;
          devResetLink.href = data.devResetLink;
          devResetLink.textContent = data.devResetLink;
        }
      } else {
        showAlert(data.error || 'कोड भेजने में त्रुटि हुई।');
      }
    } catch (err) {
      showAlert('नेटवर्क त्रुटि। कृपया पुनः प्रयास करें।');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Reset Details (रीसेट कोड भेजें)';
    }
  });
});
</script>
