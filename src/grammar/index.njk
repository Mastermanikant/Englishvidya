layout: layouts/base.njk
pageTitle: "English Grammar Master Syllabus"
metaDescription: "EnglishVidya 100% Comprehensive Grammar Syllabus. A detailed roadmap for Hindi-medium students covering translation, competitive exams, and spoken English."
permalink: /grammar/
---


<div class="syllabus-header">
    <h1>📚 Master Syllabus: Grammar & Beyond</h1>
    <p>EnglishVidya पर हम सिर्फ नियम नहीं रटवाते, बल्कि भाषा के पीछे का <strong>लॉजिक</strong> समझाते हैं। यह भारत का सबसे विस्तृत (100% Comprehensive) सिलेबस है जो आपको <strong>बुनियादी स्तर (Basic)</strong> से लेकर <strong>प्रतियोगी परीक्षाओं (Competitive Exams)</strong> तक अंग्रेज़ी की गहरी समझ बनाने में मदद करेगा। <br><br>नीचे दिए गए Modules पर क्लिक (Expand) करके देखें कि हम आपको क्या-क्या और कैसे पढ़ाएंगे。</p>
</div>

<div class="accordion">

{% set modules = collections.grammar | groupby("data.module") %}

{% set moduleOrder = [
  { name: 'Foundation & Sounds', label: '🟢 Foundation & Sounds (नींव और ध्वनियाँ)' },
  { name: 'Sentence Building Blocks', label: '🟡 Sentence Building Blocks (वाक्य संरचना)' },
  { name: 'Parts of Speech', label: '🟠 Parts of Speech (शब्द भेद)' },
  { name: 'Tenses & Conditionals', label: '🔵 Tenses & Conditionals (काल और शर्तें)' },
  { name: 'Modals', label: '🟣 Modals (मनोभाव क्रियाएं)' },
  { name: 'Advanced Syntax', label: '🟤 Advanced Syntax (एडवांस्ड ग्रामर)' },
  { name: 'Spoken English & Dialogues', label: '🔴 Spoken English & Dialogues (स्पोकन इंग्लिश)' },
  { name: 'Common Errors & Vocabulary', label: '⚫ Common Errors & Vocabulary (शब्दावली और सुधार)' }
] %}

{% for mod in moduleOrder %}
  {% set items = modules[mod.name] %}
  {% if items and items.length > 0 %}
    <div class="accordion-item">
        <button class="accordion-btn">{{ mod.label }} <span class="icon">▼</span></button>
        <div class="accordion-content"><div class="accordion-inner">
            <ul class="topic-list">
              {% for item in items %}
                <li>
                  <span class="topic-title">
                    {% if item.data.published == false %}
                      <span style="color: inherit;">{{ item.data.title }}</span>
                      <span class="badge" style="background:#f59e0b; color:white;">Coming Later</span>
                    {% else %}
                      <a href="{{ item.url }}" style="color: inherit; text-decoration: underline; display: inline-flex; align-items: center; gap: 8px;">
                        {{ item.data.title }}
                        <span class="badge" style="background:#10b981; color:white;">Published</span>
                      </a>
                    {% endif %}
                  </span>
                  {% if item.data.description %}
                    <ul class="micro-topics"><li>{{ item.data.description }}</li></ul>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
        </div></div>
    </div>
  {% endif %}
{% endfor %}

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.accordion-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const item = btn.parentElement;
            item.classList.toggle('active');
            const content = item.querySelector('.accordion-content');
            if (item.classList.contains('active')) {
                content.style.maxHeight = content.scrollHeight + "px";
            } else {
                content.style.maxHeight = "0";
            }
        });
    });
    // Open the first one by default
    const firstItem = document.querySelector('.accordion-item');
    if (firstItem) {
        firstItem.classList.add('active');
        const firstContent = firstItem.querySelector('.accordion-content');
        if (firstContent) {
            firstContent.style.maxHeight = firstContent.scrollHeight + "px";
        }
    }
});
</script>
