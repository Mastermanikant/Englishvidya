<div class="max-w-6xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-heading font-bold text-primary">Dashboard Overview</h1>
    <a href="/" class="text-sm text-accent hover:text-accent-hover transition-colors">← Back to Site</a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="glass p-6 rounded-2xl hover-lift">
      <h3 class="text-secondary text-sm font-semibold mb-2">Total Users</h3>
      <p class="text-3xl font-bold text-primary">1,248</p>
      <span class="text-green-500 text-xs font-medium">↑ 12% this week</span>
    </div>
    <div class="glass p-6 rounded-2xl hover-lift">
      <h3 class="text-secondary text-sm font-semibold mb-2">Active Comments</h3>
      <p class="text-3xl font-bold text-primary">456</p>
      <span class="text-green-500 text-xs font-medium">↑ 5% this week</span>
    </div>
    <div class="glass p-6 rounded-2xl hover-lift">
      <h3 class="text-secondary text-sm font-semibold mb-2">Articles</h3>
      <p class="text-3xl font-bold text-primary">84</p>
      <span class="text-blue-500 text-xs font-medium">Updated 2h ago</span>
    </div>
    <div class="glass p-6 rounded-2xl hover-lift">
      <h3 class="text-secondary text-sm font-semibold mb-2">System Status</h3>
      <p class="text-3xl font-bold text-green-500">Healthy</p>
      <span class="text-secondary text-xs font-medium">Uptime 99.9%</span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass p-6 rounded-2xl">
      <h2 class="text-xl font-heading font-bold text-primary mb-4">Recent Activity</h2>
      <ul class="space-y-4">
        <li class="flex items-center justify-between border-b border-border pb-4">
          <div>
            <p class="text-sm font-semibold text-primary">New user registration</p>
            <p class="text-xs text-secondary">alice@example.com</p>
          </div>
          <span class="text-xs text-secondary">5m ago</span>
        </li>
        <li class="flex items-center justify-between border-b border-border pb-4">
          <div>
            <p class="text-sm font-semibold text-primary">Comment posted</p>
            <p class="text-xs text-secondary">On "Grammar Basics"</p>
          </div>
          <span class="text-xs text-secondary">12m ago</span>
        </li>
        <li class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-primary">Profile updated</p>
            <p class="text-xs text-secondary">bob@example.com</p>
          </div>
          <span class="text-xs text-secondary">1h ago</span>
        </li>
      </ul>
      <a href="/admin/audit/" class="block text-center text-sm text-accent mt-4 hover:underline">View all activity</a>
    </div>

    <div class="glass p-6 rounded-2xl">
      <h2 class="text-xl font-heading font-bold text-primary mb-4">Quick Links</h2>
      <div class="flex flex-col gap-3">
        <a href="/admin/users/" class="p-4 bg-raised rounded-xl hover-lift flex items-center justify-between border border-border">
          <span class="font-medium text-primary">Manage Users</span>
          <span class="text-secondary">→</span>
        </a>
        <a href="/admin/comments/" class="p-4 bg-raised rounded-xl hover-lift flex items-center justify-between border border-border">
          <span class="font-medium text-primary">Review Comments</span>
          <span class="text-secondary">→</span>
        </a>
        <a href="/admin/audit/" class="p-4 bg-raised rounded-xl hover-lift flex items-center justify-between border border-border">
          <span class="font-medium text-primary">Audit Logs</span>
          <span class="text-secondary">→</span>
        </a>
      </div>
    </div>
  </div>
</div>
