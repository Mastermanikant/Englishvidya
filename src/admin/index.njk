---
layout: layouts/base.njk
pageTitle: "Admin Dashboard"
permalink: /admin/
---

<div class="admin-container" style="max-width: 1000px; margin: 40px auto; padding: 20px;">
  <h1 style="font-family: var(--font-heading); color: var(--accent); margin-bottom: 30px;">Admin Dashboard</h1>
  
  <div id="admin-auth-error" style="display: none; padding: 20px; background: #ffebee; color: #c62828; border-radius: var(--radius-md);">
    You do not have permission to view this page. <a href="/">Go Home</a>
  </div>

  <div id="admin-content" style="display: none;">
    <div class="tabs" style="display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; flex-wrap: wrap;">
      <button class="btn-primary" onclick="loadPendingLinks()" style="padding: 8px 16px; border-radius: var(--radius-sm); cursor: pointer;">Pending Links</button>
      <button class="btn-primary" onclick="loadPendingUGC()" style="padding: 8px 16px; border-radius: var(--radius-sm); cursor: pointer;">Pending Meanings</button>
      <button class="btn-secondary" id="tab-revert" onclick="loadSoftDeleted()" style="padding: 8px 16px; border-radius: var(--radius-sm); cursor: pointer; background: var(--bg-raised); color: var(--text-main); border: 1px solid var(--border-color); display: none;">Revert Bin (Owner Only)</button>
      <button class="btn-secondary" onclick="loadDeletionRequests()" style="padding: 8px 16px; border-radius: var(--radius-sm); cursor: pointer; background: rgba(255,0,0,0.1); color: var(--error); border: 1px solid var(--error);">Account Deletion Requests</button>
    </div>

    <div id="admin-list" style="display: flex; flex-direction: column; gap: 15px;">
      <!-- Content loads here -->
      <p style="color: var(--text-secondary);">Loading...</p>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', async () => {
  try {
    const res = await fetch('/api/auth-me');
    const data = await res.json();
    if (data.loggedIn && (data.user.role === 'admin' || data.user.role === 'owner')) {
      document.getElementById('admin-content').style.display = 'block';
      if (data.user.role === 'owner') {
        document.getElementById('tab-revert').style.display = 'inline-block';
      }
      loadPendingLinks();
    } else {
      document.getElementById('admin-auth-error').style.display = 'block';
    }
  } catch (e) {
    document.getElementById('admin-auth-error').style.display = 'block';
  }
});

async function loadPendingLinks() {
  const list = document.getElementById('admin-list');
  list.innerHTML = '<p>Loading pending links...</p>';
  try {
    const res = await fetch('/api/admin-data?type=pending_links');
    if (!res.ok) throw new Error('Unauthorized');
    const data = await res.json();
    
    if (data.length === 0) {
      list.innerHTML = '<p style="color: var(--text-secondary);">No pending links to review.</p>';
      return;
    }

    list.innerHTML = data.map(item => {
      let pendingUrls = [];
      try {
        pendingUrls = JSON.parse(item.reference_links).filter(r => r.status === 'pending');
      } catch(e) {}
      if (pendingUrls.length === 0) return '';

      return `
      <div style="background: var(--bg-raised); padding: 20px; border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
        <p><strong>Comment:</strong> ${item.comment_text}</p>
        <p><strong>By:</strong> ${item.name}</p>
        <div style="margin: 10px 0;">
          <strong>Pending Links:</strong>
          <ul>
            ${pendingUrls.map(u => `<li><a href="${u.url}" target="_blank" style="color: var(--accent);">${u.url}</a></li>`).join('')}
          </ul>
        </div>
        <div style="margin-top: 15px; display: flex; gap: 10px;">
          <button onclick="adminAction('link', ${item.id}, 'approve')" style="background: #34A853; color: white; padding: 6px 12px; border: none; border-radius: var(--radius-sm); cursor: pointer;">Approve Links</button>
          <button onclick="adminAction('link', ${item.id}, 'reject')" style="background: #EA4335; color: white; padding: 6px 12px; border: none; border-radius: var(--radius-sm); cursor: pointer;">Reject Links</button>
        </div>
      </div>
    `}).join('');
  } catch(e) {
    list.innerHTML = '<p style="color: #EA4335;">Failed to load data.</p>';
  }
}

async function loadPendingUGC() {
  const list = document.getElementById('admin-list');
  list.innerHTML = '<p>Loading pending UGC...</p>';
  try {
    const res = await fetch('/api/admin-data?type=pending_ugc');
    if (!res.ok) throw new Error('Unauthorized');
    const data = await res.json();
    
    if (data.length === 0) {
      list.innerHTML = '<p style="color: var(--text-secondary);">No pending meanings to review.</p>';
      return;
    }

    list.innerHTML = data.map(item => `
      <div style="background: var(--bg-raised); padding: 20px; border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
        <p><strong>Word:</strong> ${item.word_slug}</p>
        <p><strong>Meaning:</strong> ${item.meaning_text}</p>
        <p><strong>By:</strong> ${item.name}</p>
        <div style="margin-top: 15px; display: flex; gap: 10px;">
          <button onclick="adminAction('ugc', ${item.id}, 'approve')" style="background: #34A853; color: white; padding: 6px 12px; border: none; border-radius: var(--radius-sm); cursor: pointer;">Approve</button>
          <button onclick="adminAction('ugc', ${item.id}, 'reject')" style="background: #EA4335; color: white; padding: 6px 12px; border: none; border-radius: var(--radius-sm); cursor: pointer;">Reject</button>
        </div>
      </div>
    `).join('');
  } catch(e) {
    list.innerHTML = '<p style="color: #EA4335;">Failed to load data. You might not have admin rights.</p>';
  }
}

async function loadSoftDeleted() {
  const list = document.getElementById('admin-list');
  list.innerHTML = '<p>Loading revert bin...</p>';
  try {
    const res = await fetch('/api/admin-data?type=deleted');
    if (!res.ok) throw new Error('Unauthorized');
    const data = await res.json();
    
    if (data.length === 0) {
      list.innerHTML = '<p style="color: var(--text-secondary);">Recycle bin is empty.</p>';
      return;
    }

    list.innerHTML = data.map(item => `
      <div style="background: var(--bg-raised); padding: 20px; border-radius: var(--radius-lg); border: 1px solid var(--border-color); opacity: 0.8;">
        <p><strong>Type:</strong> <span style="text-transform: uppercase; color: var(--accent);">${item.source}</span></p>
        <p><strong>Text:</strong> ${item.text}</p>
        <p><strong>Deleted By:</strong> Admin #${item.action_by_id} on ${new Date(item.action_at).toLocaleDateString()}</p>
        <div style="margin-top: 15px;">
          <button onclick="adminRevert('${item.source}', ${item.id})" style="background: var(--accent); color: white; padding: 6px 12px; border: none; border-radius: var(--radius-sm); cursor: pointer;">Restore (Revert)</button>
        </div>
      </div>
    `).join('');
  } catch(e) {
    list.innerHTML = '<p style="color: #EA4335;">Failed to load data. You must be an Owner to view this.</p>';
  }
}

async function loadDeletionRequests() {
  const list = document.getElementById('admin-list');
  list.innerHTML = '<p>Loading deletion requests...</p>';
  try {
    const res = await fetch('/api/admin-data?type=deletion_requests');
    if (!res.ok) throw new Error('Unauthorized');
    const data = await res.json();
    
    if (data.length === 0) {
      list.innerHTML = '<p style="color: var(--text-secondary);">No pending account deletion requests.</p>';
      return;
    }

    list.innerHTML = data.map(item => `
      <div style="background: var(--bg-raised); padding: 20px; border-radius: var(--radius-lg); border: 1px solid var(--error);">
        <p><strong>Name:</strong> ${item.name} (${item.email})</p>
        <p><strong>Requested At:</strong> <span style="color: var(--error); font-weight: bold;">${new Date(item.delete_requested_at).toLocaleDateString()}</span></p>
        <div style="margin-top: 15px; display: flex; gap: 10px;">
          <button onclick="adminAction('user', ${item.id}, 'approve_delete')" style="background: var(--error); color: white; padding: 6px 12px; border: none; border-radius: var(--radius-sm); cursor: pointer;">Approve Deletion (Anonymize)</button>
        </div>
      </div>
    `).join('');
  } catch(e) {
    list.innerHTML = '<p style="color: #EA4335;">Failed to load data. You must be an Admin to view this.</p>';
  }
}

async function adminAction(type, id, action) {
  const res = await fetch('/api/admin-action', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({type, id, action})
  });
  if(res.ok) {
    alert('Action successful!');
    loadPendingUGC();
  } else {
    alert('Failed to perform action.');
  }
}

async function adminRevert(type, id) {
  const res = await fetch('/api/admin-revert', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({type, id})
  });
  if(res.ok) {
    alert('Restored successfully!');
    loadSoftDeleted();
  } else {
    alert('Failed to restore. Are you the Owner?');
  }
}
</script>
