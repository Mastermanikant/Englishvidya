---
layout: layouts/base.njk
title: Audit Logs
---
<div class="max-w-6xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-heading font-bold text-primary">Audit Logs</h1>
      <p class="text-sm text-secondary mt-1">System activity and security events</p>
    </div>
    <a href="/admin/" class="text-sm text-accent hover:text-accent-hover transition-colors">← Dashboard</a>
  </div>

  <div class="glass rounded-2xl overflow-hidden">
    <div class="p-4 border-b border-border flex flex-wrap gap-4 bg-raised items-center justify-between">
      <div class="flex gap-2">
        <select class="bg-base border border-border text-primary text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-accent">
          <option>All Events</option>
          <option>Logins</option>
          <option>Data Changes</option>
          <option>Security</option>
        </select>
        <select class="bg-base border border-border text-primary text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-accent">
          <option>Last 24 Hours</option>
          <option>Last 7 Days</option>
          <option>Last 30 Days</option>
        </select>
      </div>
      <button class="px-4 py-2 bg-base border border-border text-primary rounded-lg text-sm font-medium hover:bg-raised transition-colors">Download Logs</button>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-raised border-b border-border">
            <th class="py-3 px-4 text-xs font-semibold text-secondary uppercase tracking-wider">Timestamp</th>
            <th class="py-3 px-4 text-xs font-semibold text-secondary uppercase tracking-wider">Event Type</th>
            <th class="py-3 px-4 text-xs font-semibold text-secondary uppercase tracking-wider">User / IP</th>
            <th class="py-3 px-4 text-xs font-semibold text-secondary uppercase tracking-wider">Details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border text-sm">
          <tr class="hover:bg-raised transition-colors">
            <td class="py-3 px-4 text-secondary whitespace-nowrap">2023-11-20 14:32:01</td>
            <td class="py-3 px-4"><span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400">auth.login</span></td>
            <td class="py-3 px-4 text-primary">alice@example.com<br><span class="text-xs text-secondary">192.168.1.100</span></td>
            <td class="py-3 px-4 text-primary">Successful login via Google OAuth</td>
          </tr>
          <tr class="hover:bg-raised transition-colors">
            <td class="py-3 px-4 text-secondary whitespace-nowrap">2023-11-20 13:15:45</td>
            <td class="py-3 px-4"><span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-400">user.update</span></td>
            <td class="py-3 px-4 text-primary">bob_admin<br><span class="text-xs text-secondary">10.0.0.5</span></td>
            <td class="py-3 px-4 text-primary">Changed role of <code>charlie@example.com</code> to <code>banned</code></td>
          </tr>
          <tr class="hover:bg-raised transition-colors">
            <td class="py-3 px-4 text-secondary whitespace-nowrap">2023-11-20 12:05:12</td>
            <td class="py-3 px-4"><span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400">auth.failed</span></td>
            <td class="py-3 px-4 text-primary">unknown<br><span class="text-xs text-secondary">203.0.113.42</span></td>
            <td class="py-3 px-4 text-primary">Failed login attempt for <code>admin@site.com</code> (Invalid password)</td>
          </tr>
          <tr class="hover:bg-raised transition-colors">
            <td class="py-3 px-4 text-secondary whitespace-nowrap">2023-11-20 10:22:33</td>
            <td class="py-3 px-4"><span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">content.publish</span></td>
            <td class="py-3 px-4 text-primary">bob_admin<br><span class="text-xs text-secondary">10.0.0.5</span></td>
            <td class="py-3 px-4 text-primary">Published new article: <code>"Advanced Phrasal Verbs"</code></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
