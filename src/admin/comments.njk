---
layout: layouts/base.njk
title: Manage Comments & Links — EnglishVidya Admin
---
<div class="max-w-6xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-heading font-extrabold text-primary flex items-center gap-2">
        <span>💬</span> कमेंट्स एवं चर्चा मॉडरेशन (Comments & Discussions)
      </h1>
      <p class="text-xs text-secondary mt-1">वेबसाइट के विभिन्न अध्यायों व व्याकरण पाठों पर विद्यार्थियों की टिप्पणियाँ</p>
    </div>
    <a href="/admin/" class="text-xs font-semibold text-accent hover:underline">← डैशबोर्ड</a>
  </div>

  <div class="rounded-3xl border border-border bg-raised overflow-hidden shadow-xs">
    
    <!-- Filter Tabs -->
    <div class="p-4 border-b border-border flex items-center justify-between gap-3 bg-base">
      <div class="flex items-center gap-2">
        <button id="tab-all-comments" onclick="switchCommentTab('all')" class="px-4 py-2 bg-accent text-white rounded-xl text-xs font-bold transition-all shadow-xs">
          सभी कमेंट्स (All Comments)
        </button>
        <button id="tab-pending-links" onclick="switchCommentTab('links')" class="px-4 py-2 bg-raised border border-border text-secondary hover:text-primary rounded-xl text-xs font-semibold transition-all">
          पेंडिंग लिंक्स (Pending Links)
        </button>
      </div>

      <button onclick="loadComments()" class="px-3 py-1.5 bg-raised border border-border rounded-xl text-xs font-semibold text-primary hover:border-accent flex items-center gap-1">
        🔄 रिफ्रेश
      </button>
    </div>

    <!-- Live Comments List -->
    <div id="comments-container" class="divide-y divide-border">
      <div class="p-8 text-center text-xs text-secondary">कमेंट्स लोड हो रहे हैं...</div>
    </div>

  </div>
</div>

<script>
let currentTab = 'all';

async function loadComments() {
  const container = document.getElementById('comments-container');
  container.innerHTML = '<div class="p-8 text-center text-xs text-secondary">कमेंट्स लोड हो रहे हैं...</div>';

  const typeParam = currentTab === 'links' ? 'pending_links' : 'comments';

  try {
    const res = await fetch(`/api/admin-data?type=${typeParam}&limit=50`);
    if (!res.ok) {
      container.innerHTML = '<div class="p-8 text-center text-xs text-rose-500">अनधिकृत या सर्वर त्रुटि।</div>';
      return;
    }

    const items = await res.json();
    renderComments(items);
  } catch(e) {
    container.innerHTML = '<div class="p-8 text-center text-xs text-rose-500">नेटवर्क त्रुटि।</div>';
  }
}

function renderComments(items) {
  const container = document.getElementById('comments-container');
  if (!items || items.length === 0) {
    container.innerHTML = '<div class="p-12 text-center text-xs text-secondary">कोई कमेंट नहीं मिला।</div>';
    return;
  }

  container.innerHTML = items.map(c => {
    const name = window.escapeHTML ? window.escapeHTML(c.name || 'Student') : (c.name || 'Student');
    const firstChar = (name[0] || 'U').toUpperCase();
    const dateStr = c.created_at ? new Date(c.created_at).toLocaleDateString('hi-IN', { hour: '2-digit', minute: '2-digit' }) : '--';
    const text = window.escapeHTML ? window.escapeHTML(c.comment_text || '') : (c.comment_text || '');
    const isDeleted = c.status === 'deleted';

    return `
      <div class="p-6 hover:bg-base/30 transition-colors">
        <div class="flex items-start justify-between gap-4">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-2xl bg-accent/15 text-accent flex-shrink-0 flex items-center justify-center font-bold text-sm">
              ${firstChar}
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="font-bold text-sm text-primary">${name}</span>
                <span class="text-[11px] text-secondary">• ${dateStr}</span>
                ${isDeleted ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-500 border border-rose-500/20">Deleted</span>' : ''}
              </div>
              <p class="text-[11px] text-secondary mb-2">
                पेज: <a href="/${c.page_slug || ''}" target="_blank" class="text-accent underline font-semibold">${c.page_slug || 'General'} ↗</a>
              </p>
              <p class="text-xs sm:text-sm text-primary mb-3 leading-relaxed bg-base/50 p-3 rounded-xl border border-border/50">
                ${text}
              </p>
              <div class="flex items-center gap-3">
                ${currentTab === 'links' ? `
                  <button onclick="moderateLink(${c.id}, 'approve')" class="text-xs font-bold text-emerald-500 hover:underline">
                    ✅ लिंक अप्रूव करें
                  </button>
                  <button onclick="moderateLink(${c.id}, 'reject')" class="text-xs font-bold text-rose-500 hover:underline">
                    ❌ लिंक रिजेक्ट करें
                  </button>
                ` : `
                  ${!isDeleted ? `
                    <button onclick="deleteComment(${c.id})" class="text-xs font-bold text-rose-500 hover:underline">
                      🗑️ डिलीट करें (Soft Delete)
                    </button>
                  ` : ''}
                `}
              </div>
            </div>
          </div>
        </div>
      </div>
    `;
  }).join('');
}

function switchCommentTab(tab) {
  currentTab = tab;
  const btnAll = document.getElementById('tab-all-comments');
  const btnLinks = document.getElementById('tab-pending-links');

  if (tab === 'all') {
    btnAll.className = 'px-4 py-2 bg-accent text-white rounded-xl text-xs font-bold transition-all shadow-xs';
    btnLinks.className = 'px-4 py-2 bg-raised border border-border text-secondary hover:text-primary rounded-xl text-xs font-semibold transition-all';
  } else {
    btnLinks.className = 'px-4 py-2 bg-accent text-white rounded-xl text-xs font-bold transition-all shadow-xs';
    btnAll.className = 'px-4 py-2 bg-raised border border-border text-secondary hover:text-primary rounded-xl text-xs font-semibold transition-all';
  }
  loadComments();
}

async function deleteComment(commentId) {
  if (!confirm('क्या आप इस कमेंट को हटाना चाहते हैं?')) return;

  try {
    const res = await fetch('/api/admin-action', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        type: 'comment',
        id: commentId,
        action: 'reject'
      })
    });
    if (res.ok) {
      if (window.showToast) window.showToast('कमेंट डिलीट हो गया!');
      loadComments();
    } else {
      alert('कार्रवाई विफल।');
    }
  } catch(e) {
    alert('नेटवर्क त्रुटि।');
  }
}

async function moderateLink(commentId, action) {
  try {
    const res = await fetch('/api/admin-action', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        type: 'link',
        id: commentId,
        action: action
      })
    });
    if (res.ok) {
      if (window.showToast) window.showToast(`लिंक ${action === 'approve' ? 'स्वीकृत' : 'अस्वीकृत'}!`);
      loadComments();
    } else {
      alert('कार्रवाई विफल।');
    }
  } catch(e) {
    alert('नेटवर्क त्रुटि।');
  }
}

document.addEventListener('DOMContentLoaded', loadComments);
</script>
