---
layout: layouts/base.njk
title: Manage Users — EnglishVidya Admin
---
<div class="max-w-6xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-heading font-extrabold text-primary flex items-center gap-2">
        <span>👥</span> उपयोगकर्ता प्रबंधन (User Management)
      </h1>
      <p class="text-xs text-secondary mt-1">D1 डेटाबेस में पंजीकृत सभी विद्यार्थियों व मॉडरेटर्स का प्रबंधन</p>
    </div>
    <a href="/admin/" class="text-xs font-semibold text-accent hover:underline">← डैशबोर्ड</a>
  </div>

  <div class="rounded-3xl border border-border bg-raised overflow-hidden shadow-xs">
    
    <!-- Filter and Search Bar -->
    <div class="p-4 border-b border-border flex flex-col sm:flex-row items-center justify-between gap-3 bg-base">
      <div class="relative w-full sm:w-80">
        <input type="text" id="user-search-input" placeholder="नाम या ईमेल से खोजें..." oninput="filterUsersTable()" class="w-full px-4 py-2 rounded-xl bg-raised border border-border text-xs text-primary focus:outline-none focus:border-accent placeholder-secondary">
        <span class="absolute right-3 top-2 text-secondary text-xs">🔍</span>
      </div>
      <button onclick="exportUsersToCSV()" class="px-4 py-2 bg-accent text-white rounded-xl text-xs font-bold hover:bg-accent/90 transition-all shadow-xs flex items-center gap-1.5">
        <span>📥</span> CSV एक्सपोर्ट करें
      </button>
    </div>

    <!-- Live Users Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-base/50 border-b border-border text-[11px] font-bold text-secondary uppercase tracking-wider">
            <th class="py-3.5 px-4">यूजर</th>
            <th class="py-3.5 px-4">रोल</th>
            <th class="py-3.5 px-4">ट्रस्ट स्कोर</th>
            <th class="py-3.5 px-4">स्थिति</th>
            <th class="py-3.5 px-4">शामिल हुए</th>
            <th class="py-3.5 px-4 text-right">कार्रवाई (Actions)</th>
          </tr>
        </thead>
        <tbody id="users-table-body" class="divide-y divide-border text-xs">
          <tr>
            <td colspan="6" class="py-8 text-center text-secondary">यूजर्स लोड हो रहे हैं...</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Table Footer / Pagination -->
    <div class="p-4 border-t border-border bg-base/50 flex items-center justify-between text-xs text-secondary">
      <span id="users-count-summary">कुल: 0 यूजर्स</span>
      <button onclick="loadUsers()" class="px-3 py-1 bg-raised border border-border rounded-lg text-primary hover:border-accent font-semibold flex items-center gap-1">
        🔄 रिफ्रेश
      </button>
    </div>

  </div>
</div>

<script>
let allUsers = [];

async function loadUsers() {
  const tbody = document.getElementById('users-table-body');
  tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-secondary">यूजर्स लोड हो रहे हैं...</td></tr>';

  try {
    const res = await fetch('/api/admin-data?type=users&limit=100');
    if (!res.ok) {
      tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-rose-500">अनधिकृत या सर्वर त्रुटि।</td></tr>';
      return;
    }

    allUsers = await res.json();
    renderUsers(allUsers);
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-rose-500">नेटवर्क त्रुटि।</td></tr>';
  }
}

function renderUsers(users) {
  const tbody = document.getElementById('users-table-body');
  const countSummary = document.getElementById('users-count-summary');
  countSummary.textContent = `कुल: ${users.length} यूजर्स`;

  if (users.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-secondary">कोई यूजर नहीं मिला।</td></tr>';
    return;
  }

  tbody.innerHTML = users.map(u => {
    const name = window.escapeHTML ? window.escapeHTML(u.name || 'Student') : (u.name || 'Student');
    const email = window.escapeHTML ? window.escapeHTML(u.email || '') : (u.email || '');
    const firstChar = (name[0] || 'U').toUpperCase();
    const dateStr = u.created_at ? new Date(u.created_at).toLocaleDateString('hi-IN') : '--';
    const isBanned = u.is_shadow_banned === 1;

    const roleBadge = u.role === 'owner' ? 'bg-amber-500/10 text-amber-500 border-amber-500/20' : (u.role === 'admin' ? 'bg-indigo-500/10 text-indigo-500 border-indigo-500/20' : 'bg-base text-secondary border-border');
    const statusBadge = isBanned ? 'bg-rose-500/10 text-rose-500 border-rose-500/20' : 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20';
    const statusText = isBanned ? 'शैडो बैन' : 'सक्रिय';

    return `
      <tr class="hover:bg-base/30 transition-colors">
        <td class="py-3.5 px-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-accent/15 text-accent flex items-center justify-center font-bold text-xs shrink-0">
              ${firstChar}
            </div>
            <div>
              <div class="font-bold text-primary">${name}</div>
              <div class="text-[11px] text-secondary">${email}</div>
            </div>
          </div>
        </td>
        <td class="py-3.5 px-4">
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ${roleBadge}">${(u.role || 'user').toUpperCase()}</span>
        </td>
        <td class="py-3.5 px-4">
          <button onclick="editTrustScore(${u.id}, ${u.trust_score || 10})" class="font-semibold text-primary hover:text-accent flex items-center gap-1" title="क्लिक करके ट्रस्ट स्कोर बदलें">
            <span>⭐ ${u.trust_score || 10}</span>
            <span class="text-[10px] text-secondary">✏️</span>
          </button>
        </td>
        <td class="py-3.5 px-4">
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ${statusBadge}">${statusText}</span>
        </td>
        <td class="py-3.5 px-4 text-secondary text-[11px]">${dateStr}</td>
        <td class="py-3.5 px-4 text-right">
          <div class="flex items-center justify-end gap-2">
            ${u.role !== 'owner' ? `
              <button onclick="toggleShadowBan(${u.id}, ${isBanned ? 0 : 1})" class="px-2.5 py-1 rounded-lg ${isBanned ? 'bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500/20' : 'bg-rose-500/10 text-rose-500 hover:bg-rose-500/20'} font-semibold text-[11px] transition-colors">
                ${isBanned ? 'अनबैन' : 'बैन'}
              </button>
            ` : '<span class="text-[11px] text-secondary font-bold">Owner</span>'}
          </div>
        </td>
      </tr>
    `;
  }).join('');
}

function filterUsersTable() {
  const query = document.getElementById('user-search-input').value.toLowerCase().trim();
  if (!query) {
    renderUsers(allUsers);
    return;
  }
  const filtered = allUsers.filter(u => 
    (u.name && u.name.toLowerCase().includes(query)) || 
    (u.email && u.email.toLowerCase().includes(query)) ||
    (u.username && u.username.toLowerCase().includes(query))
  );
  renderUsers(filtered);
}

async function toggleShadowBan(userId, newStatus) {
  const actionName = newStatus === 1 ? 'शैडो बैन' : 'अनबैन';
  if (!confirm(`क्या आप इस यूजर को ${actionName} करना चाहते हैं?`)) return;

  try {
    const res = await fetch('/api/admin-action', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        type: 'user_shadow_ban',
        id: userId,
        is_shadow_banned: newStatus
      })
    });
    if (res.ok) {
      if (window.showToast) window.showToast(`यूजर स्थिति अपडेट हो गई (${actionName})`);
      loadUsers();
    } else {
      alert('कार्रवाई करने में असमर्थ।');
    }
  } catch(e) {
    alert('नेटवर्क त्रुटि।');
  }
}

async function editTrustScore(userId, currentScore) {
  const newScoreStr = prompt('नया ट्रस्ट स्कोर दर्ज करें (0 - 100):', currentScore);
  if (newScoreStr === null) return;
  const score = parseInt(newScoreStr, 10);
  if (isNaN(score) || score < 0 || score > 100) {
    alert('कृपया 0 से 100 के बीच वैध संख्या दर्ज करें।');
    return;
  }

  try {
    const res = await fetch('/api/admin-action', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        type: 'user_trust',
        id: userId,
        trust_score: score
      })
    });
    if (res.ok) {
      if (window.showToast) window.showToast('ट्रस्ट स्कोर अपडेट हो गया! ⭐');
      loadUsers();
    } else {
      alert('अपडेट करने में विफल।');
    }
  } catch(e) {
    alert('नेटवर्क त्रुटि।');
  }
}

function exportUsersToCSV() {
  if (!allUsers || allUsers.length === 0) {
    alert('एक्सपोर्ट करने के लिए कोई यूजर नहीं है।');
    return;
  }

  let csvContent = 'ID,Name,Email,Username,Role,TrustScore,ShadowBanned,JoinedAt\n';
  allUsers.forEach(u => {
    csvContent += `"${u.id}","${(u.name || '').replace(/"/g, '""')}","${u.email}","${u.username || ''}","${u.role}","${u.trust_score}","${u.is_shadow_banned}","${u.created_at}"\n`;
  });

  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `englishvidya-users-${new Date().toISOString().slice(0, 10)}.csv`;
  a.click();
  URL.revokeObjectURL(url);
}

document.addEventListener('DOMContentLoaded', loadUsers);
</script>
