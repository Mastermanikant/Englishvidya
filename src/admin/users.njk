---
layout: layouts/base.njk
title: Manage Users
---
<div class="max-w-6xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-heading font-bold text-primary">User Management</h1>
      <p class="text-sm text-secondary mt-1">Manage all registered users</p>
    </div>
    <a href="/admin/" class="text-sm text-accent hover:text-accent-hover transition-colors">← Dashboard</a>
  </div>

  <div class="glass rounded-2xl overflow-hidden">
    <div class="p-4 border-b border-border flex items-center justify-between bg-raised">
      <input type="text" placeholder="Search users..." class="w-full max-w-sm px-4 py-2 rounded-lg bg-base border border-border focus:outline-none focus:border-accent text-sm text-primary placeholder-secondary">
      <button class="ml-4 px-4 py-2 bg-accent text-white rounded-lg text-sm font-medium hover:bg-accent-hover transition-colors">Export CSV</button>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-raised border-b border-border">
            <th class="py-3 px-4 text-xs font-semibold text-secondary uppercase tracking-wider">User</th>
            <th class="py-3 px-4 text-xs font-semibold text-secondary uppercase tracking-wider">Role</th>
            <th class="py-3 px-4 text-xs font-semibold text-secondary uppercase tracking-wider">Status</th>
            <th class="py-3 px-4 text-xs font-semibold text-secondary uppercase tracking-wider">Joined</th>
            <th class="py-3 px-4 text-xs font-semibold text-secondary uppercase tracking-wider text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <tr class="hover:bg-raised transition-colors">
            <td class="py-4 px-4">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center text-accent font-bold">A</div>
                <div>
                  <div class="text-sm font-medium text-primary">Alice Smith</div>
                  <div class="text-xs text-secondary">alice@example.com</div>
                </div>
              </div>
            </td>
            <td class="py-4 px-4 text-sm text-primary">Member</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">Active</span>
            </td>
            <td class="py-4 px-4 text-sm text-secondary">Oct 12, 2023</td>
            <td class="py-4 px-4 text-right text-sm font-medium">
              <a href="#" class="text-accent hover:text-accent-hover mr-3">Edit</a>
              <a href="#" class="text-red-500 hover:text-red-600">Ban</a>
            </td>
          </tr>
          <tr class="hover:bg-raised transition-colors">
            <td class="py-4 px-4">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center text-accent font-bold">B</div>
                <div>
                  <div class="text-sm font-medium text-primary">Bob Johnson</div>
                  <div class="text-xs text-secondary">bob@example.com</div>
                </div>
              </div>
            </td>
            <td class="py-4 px-4 text-sm text-primary">Admin</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">Active</span>
            </td>
            <td class="py-4 px-4 text-sm text-secondary">Sep 05, 2023</td>
            <td class="py-4 px-4 text-right text-sm font-medium">
              <a href="#" class="text-accent hover:text-accent-hover mr-3">Edit</a>
            </td>
          </tr>
          <tr class="hover:bg-raised transition-colors">
            <td class="py-4 px-4">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-secondary font-bold">C</div>
                <div>
                  <div class="text-sm font-medium text-primary">Charlie Brown</div>
                  <div class="text-xs text-secondary">charlie@example.com</div>
                </div>
              </div>
            </td>
            <td class="py-4 px-4 text-sm text-primary">Member</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400">Banned</span>
            </td>
            <td class="py-4 px-4 text-sm text-secondary">Nov 20, 2023</td>
            <td class="py-4 px-4 text-right text-sm font-medium">
              <a href="#" class="text-accent hover:text-accent-hover mr-3">Edit</a>
              <a href="#" class="text-green-500 hover:text-green-600">Unban</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="p-4 border-t border-border bg-raised flex items-center justify-between">
      <span class="text-sm text-secondary">Showing 1 to 3 of 1,248</span>
      <div class="flex gap-2">
        <button class="px-3 py-1 border border-border rounded text-sm text-secondary disabled:opacity-50" disabled>Prev</button>
        <button class="px-3 py-1 border border-border rounded text-sm text-primary bg-base hover:bg-raised">Next</button>
      </div>
    </div>
  </div>
</div>
