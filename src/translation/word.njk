---
layout: layouts/base.njk
pagination:
  data: allTranslations
  size: 1
  alias: translationEntry
permalink: /translation/{{ translationEntry.slug }}/
eleventyComputed:
  pageTitle: "100+ Hindi to English Translations for {{ translationEntry.word }} — English Vidya"
  metaDescription: "Learn how to use the word '{{ translationEntry.word }}' in different tenses and situations with Hindi to English translations and example sentences."
  schemaJson: |
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for t in translationEntry.translations %}{
          "@type": "Question",
          "name": "How do you say '{{ t.en | escape }}' in Hindi? ({{ t.tense | escape }})",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{ t.hi | escape }}"
          }
        }{% if not loop.last %},{% endif %}{% endfor %}
      ]
    }
---

{# Breadcrumb #}
{% set breadcrumbs = [
  { label: "Home", url: "/" },
  { label: "Dictionary", url: "/dictionary/" },
  { label: translationEntry.word, url: "/dictionary/" + translationEntry.slug + "/" },
  { label: "Translations" }
] %}
{% include "partials/breadcrumbs.njk" %}

<div style="margin-top: var(--sp-6); display: flex; flex-direction: column; gap: var(--sp-6);">
  <div class="card" style="border-left: 4px solid var(--accent); padding: var(--sp-6);">
    <div style="display: flex; gap: 24px; align-items: flex-start; flex-wrap: wrap; margin-bottom: 24px;">
      <div style="flex: 1; min-width: 250px;">
        <h1 style="margin: 0 0 16px 0; font-size: 2.2rem; color: var(--text-main); display: flex; align-items: center; gap: 10px;">
          {{ translationEntry.word }} — Translations
          <button onclick="speakWord('{{ translationEntry.word | escape }}')" style="background:none; border:none; cursor:pointer; font-size:1.6rem; padding:0; display: inline-flex; align-items: center; justify-content: center;" title="Listen">🔊</button>
        </h1>
        <p style="font-size: 1.1rem; color: var(--text-secondary); margin: 0 0 24px 0;">
          Here you will find various example sentences and translations using the word <strong>{{ translationEntry.word }}</strong> in different tenses and situations.
        </p>

        <div>
          <a href="/dictionary/{{ translationEntry.slug }}/" class="panel-btn" style="text-decoration: none; display: inline-block; padding: 10px 20px; background: var(--bg-card); border: 2px solid var(--accent); border-radius: 8px; color: var(--accent); font-weight: bold; font-size: 1.1rem;">
            📖 Read Full Dictionary Meaning
          </a>
        </div>
      </div>
      
      {# Image displaying with full-screen popup button #}
      <div class="card-image-wrapper" id="word-img-wrapper" style="position: relative; width: 240px; height: 160px; border-radius: 12px; overflow: hidden; flex-shrink: 0; box-shadow: 0 10px 20px rgba(0,0,0,0.25);">
        <img src="/assets/images/flashcards/{{ translationEntry.slug }}.webp" onerror="document.getElementById('word-img-wrapper').style.display='none'" style="width: 100%; height: 100%; object-fit: cover;" alt="{{ translationEntry.word }}">
        <button onclick="openImageModal('/assets/images/flashcards/{{ translationEntry.slug }}.webp')" style="position: absolute; right: 12px; top: 12px; background: rgba(0,0,0,0.6); color: white; border: none; border-radius: 6px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s;" title="View Fullscreen" onmouseover="this.style.background='rgba(0,0,0,0.8)'" onmouseout="this.style.background='rgba(0,0,0,0.6)'">⛶</button>
      </div>
    </div>

    <div style="display: flex; flex-direction: column; gap: 16px;">
      {% if translationEntry.translations and translationEntry.translations.length > 0 %}
        {% for t in translationEntry.translations %}
          <div style="padding: 16px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px;">
            <h3 style="margin: 0 0 8px 0; font-size: 1rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em;">{{ t.tense }}</h3>
            <p style="margin: 0 0 4px 0; font-size: 1.2rem; color: var(--text-main); font-weight: 500; display: flex; align-items: center; gap: 8px;">
              "{{ t.en }}"
              <button onclick="speakWord('{{ t.en | escape }}')" style="background:none; border:none; cursor:pointer; font-size:1.2rem; padding:0; display: inline-flex; align-items: center; justify-content: center;" title="Listen to sentence">🔊</button>
            </p>
            <p style="margin: 0; font-size: 1.1rem; color: var(--text-secondary);">{{ t.hi }}</p>
          </div>
        {% endfor %}
      {% else %}
        <p>No translations available for this word yet.</p>
      {% endif %}
    </div>
  </div>
</div>

<script>
  function speakWord(text) {
    if ('speechSynthesis' in window) {
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'en-US';
      window.speechSynthesis.speak(utterance);
    } else {
      alert("Text-to-speech is not supported in this browser.");
    }
  }

  function openImageModal(src) {
    let modal = document.getElementById('image-fullscreen-modal');
    if (!modal) {
      modal = document.createElement('div');
      modal.id = 'image-fullscreen-modal';
      modal.style = `
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(0,0,0,0.9); display: flex; align-items: center; justify-content: center;
        z-index: 10000; cursor: pointer; opacity: 0; transition: opacity 0.3s ease;
      `;
      modal.innerHTML = `
        <img id="fullscreen-modal-img" alt="Fullscreen image view" style="max-width: 90%; max-height: 90%; object-fit: contain; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.5);" />
        <button style="position: absolute; top: 20px; right: 20px; background: none; border: none; color: white; font-size: 2rem; cursor: pointer;">&times;</button>
      `;
      modal.onclick = () => {
        modal.style.opacity = '0';
        setTimeout(() => { modal.style.display = 'none'; }, 300);
      };
      document.body.appendChild(modal);
    }
    const img = document.getElementById('fullscreen-modal-img');
    img.src = src;
    modal.style.display = 'flex';
    modal.offsetHeight; // force reflow
    modal.style.opacity = '1';
  }
</script>
