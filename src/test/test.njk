---
layout: layouts/base.njk
pageTitle: "English Grammar Online Tests — English Vidya"
metaDescription: "Test your grammar knowledge with our free online tests. Find tests on nouns, verbs, vowel sounds, pronunciation, and track your progress."
permalink: /test/
---

<div class="test-directory-container" style="max-width: 1000px; margin: 0 auto; padding: var(--sp-6) var(--sp-4);">
  <div style="text-align: center; margin-bottom: var(--sp-8);">
    <h1 style="font-size: 2.75rem; color: var(--accent); margin-bottom: var(--sp-3); font-family: 'Outfit', sans-serif; font-weight: 800;">📝 Grammar Online Tests</h1>
    <p style="color: var(--text-secondary); font-size: 1.15rem; max-width: 600px; margin: 0 auto; line-height: 1.6;">
      अपने व्याकरण ज्ञान का परीक्षण करें! अपनी प्रगति को ट्रैक करने के लिए लॉग-इन करें और देखें कि आपने क्या सीखा है।
    </p>
  </div>

  {# Search Input #}
  <div style="margin-bottom: var(--sp-8); position: relative; max-width: 600px; margin-left: auto; margin-right: auto;">
    <input type="text" id="test-search-input" placeholder="🔍 टेस्ट खोजें (जैसे: Noun, Sounds...)" 
           style="width: 100%; padding: 1.25rem 1.5rem; font-size: 1.15rem; border-radius: 99px; border: 2px solid var(--border); background: var(--bg-raised); color: var(--text-main); transition: all 0.3s ease; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); outline: none;"
           onfocus="this.style.borderColor='var(--accent)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';"
           onblur="this.style.borderColor='var(--border)'; this.style.boxShadow='0 4px 6px -1px rgba(0,0,0,0.05)';"
           oninput="filterTests()">
  </div>

  {# Test Grid/List #}
  <div id="test-grid" style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));">
    {% for test in grammarTests %}
      <div class="test-card card" data-title="{{ test.title | lower }} {{ test.lessonTitle | lower }}" 
           style="background: var(--bg-raised); padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1.25rem; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); border: 1px solid var(--border); border-radius: 1rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); cursor: pointer;"
           onmouseover="this.style.borderColor='var(--accent)'; this.style.transform='translateY(-6px)'; this.style.boxShadow='0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04)';"
           onmouseout="this.style.borderColor='var(--border)'; this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 6px -1px rgba(0,0,0,0.05)';">
        
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <span style="font-size: 0.75rem; color: #fff; background: var(--accent); padding: 0.25rem 0.75rem; border-radius: 99px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em;">Grammar</span>
            <span style="font-size: 0.75rem; color: #fff; background: #f59e0b; padding: 0.25rem 0.75rem; border-radius: 99px; font-weight: bold;">Standard</span>
          </div>
          <h2 style="font-size: 1.35rem; margin: 0 0 0.5rem 0; color: var(--text-main); font-family: 'Outfit', sans-serif; font-weight: 700; line-height: 1.3;">{{ test.lessonTitle }}</h2>
          <p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{{ test.title }}</p>
        </div>
        
        <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: auto;">
          <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem; color: var(--text-secondary); font-weight: 600;">
            <span style="display: flex; align-items: center; gap: 4px;">⏱️ 10 mins</span>
            <span style="color: var(--border);">|</span>
            <span style="display: flex; align-items: center; gap: 4px;">📝 15 Qs</span>
          </div>

          <div id="highest-score-{{ test.slug }}" style="font-size: 0.9rem; font-weight: bold; color: var(--text-secondary); display: none; background: rgba(16, 185, 129, 0.1); padding: 0.75rem; border-radius: 0.5rem; text-align: center; border: 1px solid rgba(16, 185, 129, 0.2);">
            Best Score: <span class="score-val" style="color: #10b981; font-size: 1.1rem; margin-left: 4px;">--</span>
          </div>
          
          <a href="/test/{{ test.slug }}/" class="btn-primary" 
             style="text-decoration: none; padding: 0.875rem 1.5rem; font-weight: 700; font-size: 1rem; border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; gap: 8px; background: linear-gradient(135deg, var(--accent), #2563eb); color: white; border: none; transition: opacity 0.2s; width: 100%; box-shadow: 0 4px 14px 0 rgba(59, 130, 246, 0.39);"
             onmouseover="this.style.opacity='0.9'"
             onmouseout="this.style.opacity='1'">
            Start Test &rarr;
          </a>
        </div>
      </div>
    {% endfor %}
  </div>
  
  <div id="no-tests-found" style="text-align: center; padding: 4rem 2rem; color: var(--text-secondary); display: none; background: var(--bg-raised); border-radius: 1rem; border: 1px dashed var(--border); margin-top: 2rem;">
    <div style="font-size: 3rem; margin-bottom: 1rem;">🔍</div>
    <p style="font-size: 1.25rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.5rem;">कोई टेस्ट नहीं मिला</p>
    <p style="font-size: 1rem;">कृपया दूसरा शब्द खोजें।</p>
  </div>
</div>

<script>
  function filterTests() {
    const q = document.getElementById('test-search-input').value.toLowerCase().trim();
    const cards = document.querySelectorAll('.test-card');
    const noResults = document.getElementById('no-tests-found');
    let found = 0;

    cards.forEach(card => {
      const text = card.getAttribute('data-title');
      if (text.includes(q)) {
        card.style.display = 'flex';
        found++;
      } else {
        card.style.display = 'none';
      }
    });

    noResults.style.display = found === 0 ? 'block' : 'none';
  }

  // Load scores for logged in users
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const res = await fetch('/api/tests?type=history');
      if (res.ok) {
        const attempts = await res.json();
        // Compute best score per slug
        const bestScores = {};
        attempts.forEach(att => {
          const scorePercent = (att.score / att.total_questions) * 100;
          if (!bestScores[att.lesson_slug] || bestScores[att.lesson_slug].percent < scorePercent) {
            bestScores[att.lesson_slug] = {
              score: att.score,
              total: att.total_questions,
              percent: scorePercent
            };
          }
        });

        // Update DOM
        Object.keys(bestScores).forEach(slug => {
          const container = document.getElementById(`highest-score-${slug}`);
          if (container) {
            container.querySelector('.score-val').textContent = `${bestScores[slug].score}/${bestScores[slug].total}`;
            container.style.display = 'block';
          }
        });
      }
    } catch (e) {
      console.warn('[EV] Failed to load scores history:', e);
    }
  });
</script>
