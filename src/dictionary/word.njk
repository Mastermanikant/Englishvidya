---
layout: layouts/base.njk
pagination:
  data: allWords
  size: 1
  alias: wordEntry
permalink: /dictionary/{{ wordEntry.slug }}/
eleventyComputed:
  pageTitle: "Meaning of {{ wordEntry.word }} in Hindi — English Vidya"
  metaDescription: "Learn the Hindi meaning, pronunciation ({{ wordEntry.pron }}), definition, and example sentences for the English word '{{ wordEntry.word }}'."
  schemaJson: |
    {
      "@context": "https://schema.org",
      "@type": "DefinedTerm",
      "name": "{{ wordEntry.word | escape }}",
      "description": "{{ (wordEntry.definition or wordEntry.meaning) | escape }}",
      "inDefinedTermSet": {
        "@type": "DefinedTermSet",
        "name": "English Vidya Vocabulary Dictionary",
        "url": "https://englishvidya.com/dictionary/"
      }
    }
---

{# Breadcrumb #}
{% set catName = wordEntry.category %}
{% set catIcon = '📁' %}
{% for cat in categoriesIndex %}
  {% if cat.slug == wordEntry.category %}
    {% set catName = cat.name %}
    {% set catIcon = cat.icon %}
  {% endif %}
{% endfor %}

{% set breadcrumbs = [
  { label: "Home", url: "/" },
  { label: "Dictionary", url: "/dictionary/" },
  { label: catIcon + " " + catName, url: "/dictionary/" + wordEntry.category + "/" },
  { label: wordEntry.word }
] %}
{% include "partials/breadcrumbs.njk" %}

<div style="margin-top: var(--sp-6); display: flex; flex-direction: column; gap: var(--sp-6);">
  <div class="card" style="border-left: 4px solid var(--accent); padding: var(--sp-6); display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 280px;">
      {# Main single line header as requested #}
      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: var(--sp-4);">
        <h1 style="margin: 0; font-size: 2.2rem; display: flex; align-items: center; gap: 10px; color: var(--text-main);">
          {{ wordEntry.word }}
          <button onclick="speakWord('{{ wordEntry.word | escape }}')" style="background:none; border:none; cursor:pointer; font-size:1.6rem; padding:0; display: inline-flex; align-items: center; justify-content: center;" title="Listen">🔊</button>
          <button onclick="toggleBookmark('{{ wordEntry.slug }}', '{{ wordEntry.word | escape }}', '{{ wordEntry.meaning | escape }}', '{{ wordEntry.pron | escape }}', '{{ wordEntry.category }}')" id="bookmark-btn-{{ wordEntry.slug }}" class="bookmark-btn" style="background:none; border:none; cursor:pointer; font-size:1.6rem; padding:0; display: inline-flex; align-items: center; justify-content: center; transition: transform 0.2s;" title="Save to Favorites">🤍</button>
        </h1>
        {% if wordEntry.pron %}
          <span style="font-size: 1.3rem; color: var(--text-secondary);">( {{ wordEntry.pron }} )</span>
        {% endif %}
        {% if wordEntry.meaning %}
          <span style="font-size: 1.6rem; font-weight: bold; color: var(--accent); margin-left: 8px;">{{ wordEntry.meaning }}</span>
        {% endif %}
      </div>

      {% if wordEntry.hasTranslations %}
      <div style="margin-bottom: 16px;">
        <a href="/translation/{{ wordEntry.slug }}/" class="panel-btn" style="text-decoration: none; display: inline-block; padding: 10px 20px; background: var(--accent); border: none; border-radius: 8px; color: white; font-weight: bold; font-size: 1.1rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
          ✨ See 100+ Sentence Translations
        </a>
      </div>
      {% endif %}

      {# Actions Card (Ratings + Diary) #}
      <div class="card" style="margin-bottom: 16px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 16px; background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
        <div id="word-rating-container" data-slug="{{ wordEntry.slug }}" style="display: flex; align-items: center; gap: 8px;">
          <div class="star-rating-input" role="radiogroup" aria-label="Rate this word" style="display: flex; gap: 4px; font-size: 1.5rem; cursor: pointer;">
            <button type="button" role="radio" aria-checked="false" aria-label="1 Star" class="rating-star" data-value="1" title="Rate 1 Star" style="color: var(--border); transition: color 0.2s; background:none;border:none;padding:0;cursor:pointer;font-size:inherit;">★</button>
            <button type="button" role="radio" aria-checked="false" aria-label="2 Stars" class="rating-star" data-value="2" title="Rate 2 Stars" style="color: var(--border); transition: color 0.2s; background:none;border:none;padding:0;cursor:pointer;font-size:inherit;">★</button>
            <button type="button" role="radio" aria-checked="false" aria-label="3 Stars" class="rating-star" data-value="3" title="Rate 3 Stars" style="color: var(--border); transition: color 0.2s; background:none;border:none;padding:0;cursor:pointer;font-size:inherit;">★</button>
            <button type="button" role="radio" aria-checked="false" aria-label="4 Stars" class="rating-star" data-value="4" title="Rate 4 Stars" style="color: var(--border); transition: color 0.2s; background:none;border:none;padding:0;cursor:pointer;font-size:inherit;">★</button>
            <button type="button" role="radio" aria-checked="false" aria-label="5 Stars" class="rating-star" data-value="5" title="Rate 5 Stars" style="color: var(--border); transition: color 0.2s; background:none;border:none;padding:0;cursor:pointer;font-size:inherit;">★</button>
          </div>
          <span style="font-weight: bold; font-size: 1.1rem; color: var(--text-main); margin-left: 8px;" id="rating-avg">0.0</span>
          <span style="font-size: 0.9rem; color: var(--text-secondary);" id="rating-count">(0 votes)</span>
        </div>
        <button id="add-diary-btn" class="btn-secondary" style="display: flex; align-items: center; gap: 8px; padding: 8px 16px; background: transparent; border: 1px solid var(--accent); border-radius: var(--radius-md); color: var(--text-main); font-weight: bold; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='var(--accent-soft)'" onmouseout="this.style.background='transparent'">
          📓 Add to Diary
        </button>
      </div>

      {# Word Info Cards #}
      <div style="display: flex; flex-direction: column; gap: 16px; margin-top: 24px; padding-top: 16px; border-top: 1px dashed var(--border);">
        {% if wordEntry.usages and wordEntry.usages.length > 0 %}
          {% for u in wordEntry.usages %}
            <div style="margin-bottom: 8px;">
              <h3 style="margin: 0 0 6px 0; font-size: 1rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;"><span style="display:inline-block; padding:2px 6px; background:var(--bg-footer); color:var(--text-secondary); border-radius:4px; font-size:0.75rem; font-weight:bold; margin-right:6px; text-transform:uppercase;">{{ u.partOfSpeech }}</span> Definition</h3>
              <p style="margin: 0; font-size: 1.1rem; line-height: 1.5; color: var(--text-main);">{{ u.definition }}</p>
              
              {% if u.examples %}
                <div style="margin-top: 12px; display: flex; flex-direction: column; gap: 8px;">
                  {% for ex in u.examples %}
                    <div style="font-style: italic; font-size: 1.1rem; color: var(--text-main); border-left: 3px solid var(--border); padding-left: var(--sp-3);">
                      "{{ ex.en }}"<br>
                      <span style="font-style:normal; font-size:1rem; color:var(--text-secondary);">{{ ex.hi }}</span>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
          
          {% if wordEntry.synonyms and wordEntry.synonyms.length > 0 %}
            <div>
              <h3 style="margin: 0 0 6px 0; font-size: 1rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Synonyms</h3>
              <p style="margin: 0; font-size: 1.1rem; line-height: 1.5; color: var(--text-main);">{{ wordEntry.synonyms | join(', ') }}</p>
            </div>
          {% endif %}
          {% if wordEntry.antonyms and wordEntry.antonyms.length > 0 %}
            <div>
              <h3 style="margin: 0 0 6px 0; font-size: 1rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Antonyms</h3>
              <p style="margin: 0; font-size: 1.1rem; line-height: 1.5; color: var(--text-main);">{{ wordEntry.antonyms | join(', ') }}</p>
            </div>
          {% endif %}
          {% if wordEntry.collocations and wordEntry.collocations.length > 0 %}
            <div>
              <h3 style="margin: 0 0 6px 0; font-size: 1rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Collocations</h3>
              <p style="margin: 0; font-size: 1.1rem; line-height: 1.5; color: var(--text-main);">{{ wordEntry.collocations | join(', ') }}</p>
            </div>
          {% endif %}
        {% else %}
          {# Old Format fallback #}
          {% if wordEntry.definition %}
            <div>
              <h3 style="margin: 0 0 6px 0; font-size: 1rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Definition</h3>
              <p style="margin: 0; font-size: 1.1rem; line-height: 1.5; color: var(--text-main);">{{ wordEntry.definition }}</p>
            </div>
          {% endif %}
  
          {% if wordEntry.example %}
            <div>
              <h3 style="margin: 0 0 6px 0; font-size: 1rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Example Sentence</h3>
              <div style="font-style: italic; font-size: 1.1rem; color: var(--text-main); border-left: 3px solid var(--border); padding-left: var(--sp-3); margin-top: 4px;">
                "{{ wordEntry.example }}"
              </div>
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>

    {# Image displaying with full-screen popup button #}
    <div class="card-image-wrapper" id="word-img-wrapper" style="position: relative; width: 280px; height: 200px; border-radius: 12px; overflow: hidden; flex-shrink: 0; box-shadow: 0 10px 20px rgba(0,0,0,0.25);">
      <img src="/assets/images/flashcards/{{ wordEntry.slug }}.webp" onerror="document.getElementById('word-img-wrapper').style.display='none'" style="width: 100%; height: 100%; object-fit: cover;" alt="{{ wordEntry.word }}">
      <button onclick="openImageModal('/assets/images/flashcards/{{ wordEntry.slug }}.webp')" style="position: absolute; right: 12px; top: 12px; background: rgba(0,0,0,0.6); color: white; border: none; border-radius: 6px; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s;" title="View Fullscreen" onmouseover="this.style.background='rgba(0,0,0,0.8)'" onmouseout="this.style.background='rgba(0,0,0,0.6)'">⛶</button>
    </div>
  </div>
  </div>

  {# UGC (User Generated Content) Section #}
  <div class="card" id="ugc-section" style="margin-top: 32px; padding: 24px; background: var(--bg-raised); border-radius: var(--radius-xl); box-shadow: var(--shadow-md);">
    <h3 style="margin-top: 0; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; font-family: var(--font-heading); color: var(--text-main); font-size: 1.4rem;">
      <span style="display: flex; align-items: center; gap: 8px;">🌍 <span style="background: var(--gradient-accent); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Community Meanings</span></span>
      <button id="add-ugc-btn" class="btn-primary" style="padding: 8px 16px; background: var(--accent); color: white; border: none; border-radius: var(--radius-md); font-size: 0.9rem; font-weight: bold; cursor: pointer; transition: transform 0.2s;">+ Add Yours</button>
    </h3>
    
    <div id="ugc-list" style="display: flex; flex-direction: column; gap: 16px;">
      <p style="color: var(--text-secondary); font-size: 0.9rem;">Loading community meanings...</p>
    </div>
  </div>

  {# Comments Section #}
  <div class="card" id="comments-section" style="margin-top: 32px; padding: 24px; background: var(--bg-raised); border-radius: var(--radius-xl); box-shadow: var(--shadow-md);">
    <h3 style="margin-top: 0; margin-bottom: 20px; font-family: var(--font-heading); color: var(--text-main); font-size: 1.4rem; display: flex; align-items: center; gap: 8px;">
      💬 Comments & Discussion
    </h3>
    
    <div style="margin-bottom: 24px; display: flex; flex-direction: column; gap: 12px;">
      <div style="display: flex; gap: 12px;">
        <input type="text" id="comment-input" placeholder="Ask a question or add a tip..." style="flex: 1; padding: 12px 16px; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--bg-base); color: var(--text-main); font-size: 1rem; transition: border-color 0.2s;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'">
        <button id="post-comment-btn" class="btn-primary" style="padding: 12px 24px; background: var(--accent); color: white; border: none; border-radius: var(--radius-md); font-weight: bold; cursor: pointer; transition: transform 0.2s;">Post</button>
      </div>
      
      <!-- Reference Links Toggle -->
      <div>
        <button id="toggle-refs-btn" style="background: none; border: none; color: var(--accent); font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 0; font-size: 0.9rem;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
          + Add Reference Link
        </button>
        <div id="refs-container" style="display: none; margin-top: 12px; flex-direction: column; gap: 8px;">
          <input type="url" class="ref-input" placeholder="Reference Link 1 (https://...)" style="width: 100%; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-base); color: var(--text-main); font-size: 0.85rem;">
          <input type="url" class="ref-input" placeholder="Reference Link 2 (Optional)" style="width: 100%; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-base); color: var(--text-main); font-size: 0.85rem; display: none;">
          <input type="url" class="ref-input" placeholder="Reference Link 3 (Optional)" style="width: 100%; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-base); color: var(--text-main); font-size: 0.85rem; display: none;">
          <input type="url" class="ref-input" placeholder="Reference Link 4 (Optional)" style="width: 100%; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-base); color: var(--text-main); font-size: 0.85rem; display: none;">
          <input type="url" class="ref-input" placeholder="Reference Link 5 (Optional)" style="width: 100%; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-base); color: var(--text-main); font-size: 0.85rem; display: none;">
          <button id="add-more-refs-btn" style="background: none; border: none; color: var(--text-secondary); font-size: 0.8rem; cursor: pointer; text-align: left; padding: 0;">+ Add more</button>
        </div>
      </div>
    </div>

    <div id="comments-list" style="display: flex; flex-direction: column; gap: 16px;">
      <p style="color: var(--text-secondary); font-size: 0.9rem;">Loading comments...</p>
    </div>
  </div>

  {# Extra Detailed Information Section #}
  {% if wordEntry.detailedInfo and wordEntry.detailedInfo.length > 0 %}
    <div class="dictionary-ad" style="margin-top: 32px; padding: var(--sp-6); border-top: 4px solid var(--accent); background: var(--bg-card); border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
      <h2 style="font-size: 1.5rem; margin-bottom: 20px; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
        <span style="font-size: 1.8rem;">💡</span> Extra Facts & Info
      </h2>
      <div style="display: flex; flex-direction: column; gap: 20px;">
        {% for info in wordEntry.detailedInfo %}
          <div>
            <h3 style="margin: 0 0 10px 0; font-size: 1.2rem; color: var(--accent); font-weight: 600;">{{ info.title }}</h3>
            <ul style="margin: 0; padding-left: 20px; color: var(--text-main); font-size: 1.1rem; line-height: 1.6;">
              {% for point in info.points %}
                <li style="margin-bottom: 8px;">{{ point }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {# Related Words Section #}
  <div style="margin-top: var(--sp-4);">
    <h2 style="font-size: 1.3rem; margin-bottom: 16px;">Other Words in {{ catName }}</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 10px;">
      {% set count = 0 %}
      {% for w in allWords %}
        {% if w.category == wordEntry.category and w.slug != wordEntry.slug and count < 25 %}
          <a href="/dictionary/{{ w.slug }}/" class="panel-btn" style="text-decoration: none; font-size: 0.9rem; padding: 8px 16px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; color: var(--text-main); font-weight: 500; transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.borderColor='var(--accent)';" onmouseout="this.style.borderColor='var(--border)';">
            {{ w.word }}
          </a>
          {% set count = count + 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
  function speakWord(text) {
    if ('speechSynthesis' in window) {
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'en-US';
      window.speechSynthesis.speak(utterance);
    } else {
      alert("Text-to-speech is not supported in this browser.");
    }
  }

  function openImageModal(src) {
    let modal = document.getElementById('image-fullscreen-modal');
    if (!modal) {
      modal = document.createElement('div');
      modal.id = 'image-fullscreen-modal';
      modal.style = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.3s ease;
      `;
      modal.innerHTML = `
        <img id="fullscreen-modal-img" alt="Fullscreen image view" style="max-width: 90%; max-height: 90%; object-fit: contain; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.5);" />
        <button style="position: absolute; top: 20px; right: 20px; background: none; border: none; color: white; font-size: 2rem; cursor: pointer;">&times;</button>
      `;
      modal.onclick = () => {
        modal.style.opacity = '0';
        setTimeout(() => { modal.style.display = 'none'; }, 300);
      };
      document.body.appendChild(modal);
    }
    const img = document.getElementById('fullscreen-modal-img');
    img.src = src;
    modal.style.display = 'flex';
    // Force reflow
    modal.offsetHeight;
    modal.style.opacity = '1';
  }
</script>
