---
layout: layouts/base.njk
pageTitle: "English Dictionary Categories — English Vidya"
metaDescription: "Browse our comprehensive English to Hindi dictionary by categories."
permalink: /dictionary/
---

{# Breadcrumb #}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a>
  <span class="breadcrumb-sep" aria-hidden="true">›</span>
  <span aria-current="page">Dictionary</span>
</nav>

<div class="hero-welcome animate-fade-in" style="padding-bottom: var(--sp-4);">
  <h1 style="font-size: 1.5rem;">🔤 English Dictionary</h1>
  <p class="hero-subtitle">Browse words by category with Hindi meanings and pronunciation.</p>
</div>

<div class="word-grid animate-fade-in" style="margin-top: var(--sp-6);">
  {% for cat in categoriesIndex %}
    <a href="/dictionary/{{ cat.slug }}/" class="word-card" style="text-decoration: none; padding: var(--sp-4); display: flex; align-items: center; gap: var(--sp-3);">
      <div style="font-size: 2rem;">{{ cat.icon | default('📁') }}</div>
      <div>
        <h3 style="margin: 0; color: var(--text-color);">{{ cat.name }}</h3>
        <p style="margin: 0; font-size: 0.9rem; color: var(--text-secondary);">{{ cat.count }} words</p>
      </div>
    </a>
  {% endfor %}
</div>
