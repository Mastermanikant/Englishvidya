---
layout: layouts/base.njk
pageTitle: "English Dictionary Categories — English Vidya"
metaDescription: "Browse our comprehensive English to Hindi dictionary by categories."
permalink: /dictionary/
---

{% set breadcrumbs = [
  { label: "Home", url: "/" },
  { label: "Dictionary" }
] %}
{% include "partials/breadcrumbs.njk" %}

<div class="hero-welcome animate-fade-in dict-hero">
  <h1 class="dict-hero-title">🔤 English Dictionary</h1>
  <p class="hero-subtitle">Browse words by category with Hindi meanings and pronunciation.</p>
</div>

{# A-Z Navigation Bar #}
<div class="a-z-nav-container animate-fade-in dict-nav-container">
  <h2 class="dict-nav-title">Browse Alphabetically</h2>
  <div class="a-z-nav dict-a-z-list">
    {% for l in alphabet %}
      <a href="/dictionary/letter/{{ l | lower }}/" class="letter-btn dict-letter-btn">
        {{ l }}
      </a>
    {% endfor %}
  </div>
</div>

<div class="category-accordion animate-fade-in dict-category-container">
  <h2 class="dict-category-title">Browse by Categories</h2>
  {% for mainGroup in groupedCategories %}
    <details class="category-main-folder dict-main-folder">
      <summary class="dict-main-summary">
        📁 {{ mainGroup.name }}
        <span class="dict-summary-icon">▼</span>
      </summary>
      
      <div class="dict-sub-folder-container">
        {% for subGroup in mainGroup.subCategories %}
          <details class="category-sub-folder dict-sub-folder">
            <summary class="dict-sub-summary">
              📂 {{ subGroup.name }}
              <span class="dict-summary-icon">▼</span>
            </summary>
            
            <div class="dict-cards-grid">
              {% for cat in subGroup.items %}
                <a href="/dictionary/{{ cat.slug }}/" class="word-card dict-word-card">
                  <div class="dict-word-card-icon">{{ cat.icon | default('📄') }}</div>
                  <div>
                    <div class="dict-word-card-title">{{ cat.name }}</div>
                    <div class="dict-word-card-count">{{ cat.count }} words</div>
                  </div>
                </a>
              {% endfor %}
            </div>
          </details>
        {% endfor %}
      </div>
    </details>
  {% endfor %}
</div>

