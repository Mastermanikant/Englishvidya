---
layout: layouts/base.njk
pageTitle: "English Dictionary Categories — English Vidya"
metaDescription: "Browse our comprehensive English to Hindi dictionary by categories."
permalink: /dictionary/
---

{# Breadcrumb #}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a>
  <span class="breadcrumb-sep" aria-hidden="true">›</span>
  <span aria-current="page">Dictionary</span>
</nav>

<div class="hero-welcome animate-fade-in" style="padding-bottom: var(--sp-4);">
  <h1 style="font-size: 1.5rem;">🔤 English Dictionary</h1>
  <p class="hero-subtitle">Browse words by category with Hindi meanings and pronunciation.</p>
</div>

<div class="category-accordion animate-fade-in" style="margin-top: var(--sp-6); display: flex; flex-direction: column; gap: var(--sp-4);">
  {% for mainGroup in groupedCategories %}
    <details class="category-main-folder" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
      <summary style="padding: var(--sp-4); font-size: 1.25rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: var(--sp-2); list-style: none; user-select: none; border-bottom: 1px solid transparent; transition: border-color 0.2s;">
        📁 {{ mainGroup.name }}
        <span style="margin-left: auto; font-size: 1rem; color: var(--text-secondary);">▼</span>
      </summary>
      
      <div style="padding: var(--sp-3) var(--sp-4) var(--sp-4) var(--sp-4); display: flex; flex-direction: column; gap: var(--sp-3); background: var(--bg-body); border-top: 1px solid var(--border);">
        {% for subGroup in mainGroup.subCategories %}
          <details class="category-sub-folder" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; border-left: 4px solid var(--border);">
            <summary style="padding: var(--sp-3); font-size: 1.1rem; font-weight: 500; cursor: pointer; display: flex; align-items: center; gap: var(--sp-2); list-style: none; user-select: none;">
              📂 {{ subGroup.name }}
              <span style="margin-left: auto; font-size: 0.9rem; color: var(--text-secondary);">▼</span>
            </summary>
            
            <div style="padding: var(--sp-3); display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--sp-3); background: var(--bg-footer); border-top: 1px solid var(--border);">
              {% for cat in subGroup.items %}
                <a href="/dictionary/{{ cat.slug }}/" class="word-card" style="text-decoration: none; padding: var(--sp-3); display: flex; align-items: center; gap: var(--sp-2); border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); transition: border-color 0.2s, background 0.2s, transform 0.2s;" onmouseover="this.style.borderColor='var(--accent)'; this.style.transform='translateY(-2px)';" onmouseout="this.style.borderColor='var(--border)'; this.style.transform='none';">
                  <div style="font-size: 1.5rem;">{{ cat.icon | default('📄') }}</div>
                  <div>
                    <div style="font-weight: 600; color: var(--text-main); font-size: 1rem;">{{ cat.name }}</div>
                    <div style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 4px;">{{ cat.count }} words</div>
                  </div>
                </a>
              {% endfor %}
            </div>
          </details>
        {% endfor %}
      </div>
    </details>
  {% endfor %}
</div>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
  details[open] > summary span {
    transform: rotate(180deg);
  }
  details summary span {
    transition: transform 0.3s ease;
  }
</style>
