---
layout: layouts/base.njk
pagination:
  data: categoriesIndex
  size: 1
  alias: category
permalink: /dictionary/{{ category.slug }}/
eleventyComputed:
  pageTitle: "{{ category.name }} Vocabulary Dictionary — English Vidya"
  metaDescription: "Learn {{ category.name }} vocabulary with Hindi meaning, definition, and examples."
---

{# Breadcrumb #}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a>
  <span class="breadcrumb-sep" aria-hidden="true">›</span>
  <a href="/dictionary/">Dictionary</a>
  <span class="breadcrumb-sep" aria-hidden="true">›</span>
  <span aria-current="page">{{ category.name }}</span>
</nav>

<div class="hero-welcome animate-fade-in" style="padding-bottom: var(--sp-4);">
  <h1 style="font-size: 1.5rem;">{{ category.icon }} {{ category.name }} Vocabulary</h1>
  <p class="hero-subtitle">Learn words, their Hindi meanings, and usage in sentences.</p>
</div>

<div id="dictionary-app" data-category-slug="{{ category.slug }}" style="margin-top: var(--sp-6);">
  <div class="loading-screen" style="min-height:200px;">
    <div class="loader-spinner"></div>
    <p class="loader-text">Loading words...</p>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", async () => {
    const container = document.getElementById('dictionary-app');
    const slug = container.getAttribute('data-category-slug');
    
    try {
      const res = await fetch(`/data/vocabulary/categories/${slug}.json`);
      if (!res.ok) throw new Error("Could not fetch data");
      const data = await res.json();
      
      if (!data || data.length === 0) {
        container.innerHTML = `<div class="card"><p>No words found in this category yet.</p></div>`;
        return;
      }
      
      let html = `
        <div class="category-toolbar" style="display: flex; justify-content: flex-end; gap: 12px; margin-bottom: 16px;">
          <button onclick="setAllDetails(true)" style="padding: 6px 12px; font-size: 0.85rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; color: var(--text-main); cursor: pointer; display: flex; align-items: center; gap: 4px; font-weight: 500;">
            ↔ Expand All
          </button>
          <button onclick="setAllDetails(false)" style="padding: 6px 12px; font-size: 0.85rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; color: var(--text-main); cursor: pointer; display: flex; align-items: center; gap: 4px; font-weight: 500;">
            → Shrink All
          </button>
        </div>
        <div style="display: flex; flex-direction: column; gap: 16px;">
      `;
      data.forEach(item => {
        let word, meaning, pron, def, ex, exampleHi;
        
        // Handle new and old format
        if (item.word) {
          word = item.word;
          meaning = item.meaning;
          def = item.definition;
          pron = item.pron;
          ex = item.example;
          exampleHi = item.exampleHindi;
        } else {
          // Old format (4 pipes)
          let parts = typeof item === 'string' ? item.split('|') : [];
          if (parts.length >= 4) {
            word = parts[0].trim();
            pron = parts[1].trim();
            meaning = parts[2].trim();
            def = parts[3].trim();
          }
        }
        
        let itemSlug = word.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        
        html += `
          <div class="card" style="border-left: 4px solid var(--accent); display: flex; gap: 16px; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 16px;">
            <div style="flex: 1; min-width: 250px;">
              <h3 style="margin-bottom: 8px; display: flex; align-items: center; gap: 8px; font-size: 1.4rem;">
                ${word} 
                <button onclick="speakWord('${word.replace(/'/g, "\\'")}')" style="background:none; border:none; cursor:pointer; font-size:1.2rem;">🔊</button>
              </h3>
              ${pron ? `<div style="font-size: 0.95rem; color: var(--text-secondary); margin-bottom: 4px;">${pron}</div>` : ''}
              ${meaning ? `<div style="font-size: 1.1rem; font-weight: bold; color: var(--accent); margin-bottom: 4px;">${meaning}</div>` : ''}
              
              <div class="word-additional-details" style="display: none; margin-top: 12px; padding-top: 8px; border-top: 1px dashed var(--border);">
                ${def ? `<div style="font-size: 0.95rem; margin-bottom: 8px; line-height: 1.4;"><strong>Definition:</strong> ${def}</div>` : ''}
                ${ex ? `<div style="font-style: italic; color: var(--text-secondary); border-left: 2px solid var(--border); padding-left: 8px; margin-top: 8px;">"${ex}"</div>` : ''}
              </div>
              
              <button class="details-toggle-btn" onclick="toggleDetails(this)" style="background: none; border: none; color: var(--accent); cursor: pointer; font-size: 0.85rem; padding: 4px 0 0 0; margin-top: 4px; display: flex; align-items: center; gap: 4px; font-weight: 600;">
                Show Details <span class="arrow">▼</span>
              </button>
            </div>
            <div class="card-image-wrapper" style="position: relative; width: 180px; height: 120px; border-radius: 8px; overflow: hidden; flex-shrink: 0; box-shadow: 0 4px 10px rgba(0,0,0,0.15);">
              <img src="/assets/images/flashcards/${itemSlug}.webp" onerror="this.parentNode.style.display='none'" style="width: 100%; height: 100%; object-fit: cover;" alt="${word}">
              <button onclick="openImageModal('/assets/images/flashcards/${itemSlug}.webp')" style="position: absolute; right: 8px; top: 8px; background: rgba(0,0,0,0.6); color: white; border: none; border-radius: 4px; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s;" title="View Fullscreen" onmouseover="this.style.background='rgba(0,0,0,0.8)'" onmouseout="this.style.background='rgba(0,0,0,0.6)'">⛶</button>
            </div>
          </div>
        `;
      });
      html += `</div>`;
      container.innerHTML = html;
      
    } catch (e) {
      container.innerHTML = `<div class="card" style="color: red;">Error loading words: ${e.message}</div>`;
    }
  });

  function speakWord(text) {
    if ('speechSynthesis' in window) {
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'en-US';
      window.speechSynthesis.speak(utterance);
    } else {
      alert("Text-to-speech is not supported in this browser.");
    }
  }

  function toggleDetails(btn) {
    const card = btn.closest('.card');
    const details = card.querySelector('.word-additional-details');
    const isHidden = details.style.display === 'none';
    
    details.style.display = isHidden ? 'block' : 'none';
    btn.innerHTML = isHidden ? 'Hide Details <span class="arrow">▲</span>' : 'Show Details <span class="arrow">▼</span>';
  }

  function setAllDetails(expand) {
    const detailsList = document.querySelectorAll('.word-additional-details');
    const btns = document.querySelectorAll('.details-toggle-btn');
    
    detailsList.forEach(details => {
      details.style.display = expand ? 'block' : 'none';
    });
    
    btns.forEach(btn => {
      btn.innerHTML = expand ? 'Hide Details <span class="arrow">▲</span>' : 'Show Details <span class="arrow">▼</span>';
    });
  }

  function openImageModal(src) {
    let modal = document.getElementById('image-fullscreen-modal');
    if (!modal) {
      modal = document.createElement('div');
      modal.id = 'image-fullscreen-modal';
      modal.style = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.3s ease;
      `;
      modal.innerHTML = `
        <img id="fullscreen-modal-img" style="max-width: 90%; max-height: 90%; object-fit: contain; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.5);" />
        <button style="position: absolute; top: 20px; right: 20px; background: none; border: none; color: white; font-size: 2rem; cursor: pointer;">&times;</button>
      `;
      modal.onclick = () => {
        modal.style.opacity = '0';
        setTimeout(() => { modal.style.display = 'none'; }, 300);
      };
      document.body.appendChild(modal);
    }
    const img = document.getElementById('fullscreen-modal-img');
    img.src = src;
    modal.style.display = 'flex';
    // Force reflow
    modal.offsetHeight;
    modal.style.opacity = '1';
  }
</script>
