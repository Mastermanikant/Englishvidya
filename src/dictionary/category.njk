---
layout: layouts/base.njk
pagination:
  data: categoriesIndex
  size: 1
  alias: category
permalink: /dictionary/{{ category.slug }}/
eleventyComputed:
  pageTitle: "{{ category.name }} — English Words with Hindi Meaning | EnglishVidya"
  metaDescription: "{{ category.name }} से जुड़े सभी अंग्रेज़ी शब्दों के हिंदी अर्थ, उच्चारण और उदाहरण सीखें।"
---

{# Breadcrumb #}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a>
  <span class="breadcrumb-sep" aria-hidden="true">›</span>
  <a href="/dictionary/">Dictionary</a>
  <span class="breadcrumb-sep" aria-hidden="true">›</span>
  <span aria-current="page">{{ category.name }}</span>
</nav>

<div class="hero-welcome animate-fade-in" style="padding-bottom: var(--sp-4);">
  <h1 style="font-size: 1.5rem;">{{ category.icon }} {{ category.name }} Vocabulary</h1>
  <p class="hero-subtitle">Learn words, their Hindi meanings, and usage in sentences.</p>
</div>

<div id="dictionary-app" data-category-slug="{{ category.slug }}" style="margin-top: var(--sp-6);">
  <div class="loading-screen" style="min-height:200px;">
    <div class="loader-spinner"></div>
    <p class="loader-text">Loading words...</p>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", async () => {
    const container = document.getElementById('dictionary-app');
    const slug = container.getAttribute('data-category-slug');
    
    try {
      const res = await fetch(`/data/vocabulary/categories/${slug}.json`);
      if (!res.ok) throw new Error("Could not fetch data");
      const data = await res.json();
      
      if (!data || data.length === 0) {
        container.innerHTML = `<div class="card"><p>No words found in this category yet.</p></div>`;
        return;
      }
      
      let html = `
        <div class="category-toolbar" style="display: flex; justify-content: flex-end; margin-bottom: 16px;">
          <button id="toggle-all-details-btn" onclick="toggleAllDetails()" style="padding: 8px 16px; font-size: 0.85rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; color: var(--text-main); cursor: pointer; display: flex; align-items: center; gap: 6px; font-weight: 500; min-width: 130px; justify-content: center;">
            ↔ Expand All
          </button>
        </div>
        <div style="display: flex; flex-direction: column; gap: 16px;">
      `;
      data.forEach(item => {
        let word, meaning, pron, def, ex, exampleHi;
        
        // Handle new and old format
        if (item.word) {
          word = item.word;
          meaning = item.meaning;
          def = item.definition;
          pron = item.pron;
          ex = item.example;
          exampleHi = item.exampleHindi;
        } else {
          // Old format (4 pipes)
          let parts = typeof item === 'string' ? item.split('|') : [];
          if (parts.length >= 4) {
            word = parts[0].trim();
            pron = parts[1].trim();
            meaning = parts[2].trim();
            def = parts[3].trim();
          }
        }
        
        let itemSlug = word.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        
        let usagesHtml = '';
        if (item.usages && item.usages.length > 0) {
            usagesHtml = item.usages.map(u => `
                <div style="margin-bottom: 12px;">
                    <div style="font-size: 0.95rem; line-height: 1.4;">
                        <span style="display:inline-block; padding:2px 6px; background:var(--bg-footer); color:var(--text-secondary); border-radius:4px; font-size:0.75rem; font-weight:bold; margin-right:6px; text-transform:uppercase;">${u.partOfSpeech}</span>
                        ${u.definition}
                    </div>
                    ${u.examples ? `<div style="margin-top: 6px;">` + u.examples.map(ex => `
                        <div style="font-style: italic; color: var(--text-secondary); border-left: 2px solid var(--border); padding-left: 8px; margin-bottom: 6px; font-size:0.9rem;">
                            "${ex.en}" <br> <span style="font-style:normal; color:var(--text-main); font-size:0.85rem;">${ex.hi}</span>
                        </div>
                    `).join('') + `</div>` : ''}
                </div>
            `).join('');
        } else {
            usagesHtml = `
                ${def ? `<div style="font-size: 0.95rem; margin-bottom: 8px; line-height: 1.4;"><strong>Definition:</strong> ${def}</div>` : ''}
                ${ex ? `<div style="font-style: italic; color: var(--text-secondary); border-left: 2px solid var(--border); padding-left: 8px; margin-top: 8px;">"${ex}"</div>` : ''}
            `;
        }

        let extraMetaHtml = '';
        if (item.synonyms && item.synonyms.length > 0) {
            extraMetaHtml += `<div style="font-size:0.85rem; margin-top:8px;"><strong>Synonyms:</strong> ${item.synonyms.join(', ')}</div>`;
        }
        if (item.antonyms && item.antonyms.length > 0) {
            extraMetaHtml += `<div style="font-size:0.85rem; margin-top:4px;"><strong>Antonyms:</strong> ${item.antonyms.join(', ')}</div>`;
        }
        if (item.collocations && item.collocations.length > 0) {
            extraMetaHtml += `<div style="font-size:0.85rem; margin-top:4px;"><strong>Collocations:</strong> ${item.collocations.join(', ')}</div>`;
        }
        
        html += `
          <div class="card" onclick="handleCardClick(event, this)" style="border-left: 4px solid var(--accent); display: flex; gap: 24px; align-items: flex-start; justify-content: flex-start; flex-wrap: wrap; padding: 16px; cursor: pointer; user-select: none;">
            <div style="flex: 1; min-width: 250px; max-width: 600px;">
              <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 8px;">
                <h3 style="margin: 0; font-size: 1.4rem; display: flex; align-items: center; gap: 6px;">
                  ${word}
                  <button onclick="event.stopPropagation(); speakWord('${word.replace(/'/g, "\\'")}')" style="background:none; border:none; cursor:pointer; font-size:1.1rem; padding:0; display: inline-flex; align-items: center; justify-content: center;" title="Listen">🔊</button>
                </h3>
                ${pron ? `<span style="font-size: 0.95rem; color: var(--text-secondary);">( ${pron} )</span>` : ''}
                ${meaning ? `<span style="font-size: 1.15rem; font-weight: bold; color: var(--accent); margin-left: 4px;">${meaning}</span>` : ''}
              </div>
              
              <div class="word-additional-details" style="display: none; margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--border);">
                ${usagesHtml}
                ${extraMetaHtml}
              </div>
              
              <div style="display: flex; align-items: center; gap: 16px; margin-top: 8px;">
                <button class="details-toggle-btn" onclick="toggleDetails(this)" style="background: none; border: none; color: var(--accent); cursor: pointer; font-size: 0.85rem; padding: 4px 0 0 0; display: flex; align-items: center; gap: 4px; font-weight: 600;">
                  Show Details <span class="arrow">▼</span>
                </button>
                <a href="/dictionary/${itemSlug}/" onclick="event.stopPropagation()" style="color: var(--text-secondary); text-decoration: none; font-size: 0.85rem; font-weight: 600; padding-top: 4px; display: inline-flex; align-items: center; gap: 4px; transition: color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-secondary)'">
                  Open Page ↗
                </a>
              </div>
            </div>
            <div class="card-image-wrapper" style="display: none; position: relative; width: 140px; height: 100px; border-radius: 8px; overflow: hidden; flex-shrink: 0; box-shadow: 0 4px 10px rgba(0,0,0,0.15); margin-top: 4px;">
              <img src="/assets/images/flashcards/${itemSlug}.webp" onerror="this.parentNode.setAttribute('data-img-error', 'true'); this.parentNode.style.display='none';" style="width: 100%; height: 100%; object-fit: cover;" alt="${word}">
              <button onclick="event.stopPropagation(); openImageModal('/assets/images/flashcards/${itemSlug}.webp')" style="position: absolute; right: 4px; top: 4px; background: rgba(0,0,0,0.6); color: white; border: none; border-radius: 4px; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s; font-size: 0.8rem;" title="View Fullscreen" onmouseover="this.style.background='rgba(0,0,0,0.8)'" onmouseout="this.style.background='rgba(0,0,0,0.6)'">⛶</button>
            </div>
          </div>
        `;
      });
      html += `</div>`;
      container.innerHTML = html;
      
    } catch (e) {
      container.innerHTML = `<div class="card" style="color: red;">Error loading words: ${e.message}</div>`;
    }
  });

  function speakWord(text) {
    if ('speechSynthesis' in window) {
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'en-US';
      window.speechSynthesis.speak(utterance);
    } else {
      alert("Text-to-speech is not supported in this browser.");
    }
  }

  function handleCardClick(event, card) {
    if (event.target.closest('button') || event.target.closest('a')) {
      return;
    }
    const btn = card.querySelector('.details-toggle-btn');
    if (btn) {
      toggleDetails(btn);
    }
  }

  function toggleDetails(btn) {
    const card = btn.closest('.card');
    const details = card.querySelector('.word-additional-details');
    const imgWrapper = card.querySelector('.card-image-wrapper');
    const isHidden = details.style.display === 'none';
    
    details.style.display = isHidden ? 'block' : 'none';
    
    if (imgWrapper && imgWrapper.getAttribute('data-img-error') !== 'true') {
      imgWrapper.style.display = isHidden ? 'block' : 'none';
    }
    
    btn.innerHTML = isHidden ? 'Hide Details <span class="arrow">▲</span>' : 'Show Details <span class="arrow">▼</span>';
  }

  let allExpanded = false;

  function toggleAllDetails() {
    allExpanded = !allExpanded;
    const btn = document.getElementById('toggle-all-details-btn');
    if (btn) {
      btn.innerHTML = allExpanded ? '→ Shrink All' : '↔ Expand All';
    }
    
    const detailsList = document.querySelectorAll('.word-additional-details');
    const toggleBtns = document.querySelectorAll('.details-toggle-btn');
    const imgWrappers = document.querySelectorAll('.card-image-wrapper');
    
    detailsList.forEach(details => {
      details.style.display = allExpanded ? 'block' : 'none';
    });
    
    imgWrappers.forEach(wrapper => {
      if (wrapper.getAttribute('data-img-error') !== 'true') {
        wrapper.style.display = allExpanded ? 'block' : 'none';
      }
    });
    
    toggleBtns.forEach(tBtn => {
      tBtn.innerHTML = allExpanded ? 'Hide Details <span class="arrow">▲</span>' : 'Show Details <span class="arrow">▼</span>';
    });
  }


  function openImageModal(src) {
    let modal = document.getElementById('image-fullscreen-modal');
    if (!modal) {
      modal = document.createElement('div');
      modal.id = 'image-fullscreen-modal';
      modal.style = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.3s ease;
      `;
      modal.innerHTML = `
        <img id="fullscreen-modal-img" style="max-width: 90%; max-height: 90%; object-fit: contain; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.5);" />
        <button style="position: absolute; top: 20px; right: 20px; background: none; border: none; color: white; font-size: 2rem; cursor: pointer;">&times;</button>
      `;
      modal.onclick = () => {
        modal.style.opacity = '0';
        setTimeout(() => { modal.style.display = 'none'; }, 300);
      };
      document.body.appendChild(modal);
    }
    const img = document.getElementById('fullscreen-modal-img');
    img.src = src;
    modal.style.display = 'flex';
    // Force reflow
    modal.offsetHeight;
    modal.style.opacity = '1';
  }
</script>
