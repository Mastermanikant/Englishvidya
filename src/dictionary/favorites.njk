{# Breadcrumb #}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a>
  <span class="breadcrumb-sep" aria-hidden="true">›</span>
  <a href="/dictionary/">Dictionary</a>
  <span class="breadcrumb-sep" aria-hidden="true">›</span>
  <span aria-current="page">Favorites</span>
</nav>

<div class="hero-welcome animate-fade-in" style="padding-bottom: var(--sp-4);">
  <h1 style="font-size: 1.8rem; display: flex; align-items: center; gap: 10px;">❤️ My Saved Words</h1>
  <p class="hero-subtitle">All your bookmarked words for quick revision. (Saved on this device)</p>
</div>

<div id="favorites-container" class="animate-fade-in" style="margin-top: var(--sp-4); min-height: 50vh;">
  <p id="favorites-empty-msg" style="text-align: center; color: var(--text-secondary); margin-top: 40px; display: none;">
    You haven't saved any words yet.<br><br>
    <a href="/dictionary/" class="panel-btn" style="text-decoration: none; padding: 10px 20px; background: var(--accent); color: white; border-radius: 8px;">Explore Dictionary</a>
  </p>
  
  <div id="favorites-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
    <!-- Items will be injected here via JS -->
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', renderFavorites);
window.addEventListener('bookmarksUpdated', renderFavorites);

function renderFavorites() {
    const listEl = document.getElementById('favorites-list');
    const emptyMsg = document.getElementById('favorites-empty-msg');
    
    // getBookmarks is available from bookmarks.js
    let bookmarks = [];
    if (typeof getBookmarks === 'function') {
        bookmarks = getBookmarks();
    }
    
    if (bookmarks.length === 0) {
        listEl.style.display = 'none';
        emptyMsg.style.display = 'block';
        return;
    }
    
    listEl.style.display = 'grid';
    emptyMsg.style.display = 'none';
    
    let html = '';
    bookmarks.forEach(b => {
        html += `
            <div class="card" id="fav-card-${b.slug}" style="margin-bottom: 0; padding: var(--sp-4); position: relative; border-left: 4px solid var(--accent);">
                <button onclick="removeFavorite('${b.slug}')" style="position: absolute; top: 12px; right: 12px; background: none; border: none; font-size: 1.2rem; cursor: pointer;" title="Remove from favorites">❌</button>
                <a href="/dictionary/${b.slug}/" style="text-decoration: none; color: inherit; display: block; margin-right: 24px;">
                    <div style="font-size: 1.4rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
                        ${b.word}
                        <span style="font-size: 1rem; color: var(--text-secondary); font-weight: normal;">(${b.pron})</span>
                    </div>
                    <div style="font-size: 1.1rem; color: var(--accent); font-weight: 600; margin-top: 4px;">${b.meaning}</div>
                    <div style="font-size: 0.8rem; color: var(--text-tertiary); margin-top: 8px; text-transform: uppercase;">📁 ${b.category}</div>
                </a>
            </div>
        `;
    });
    
    listEl.innerHTML = html;
}

function removeFavorite(slug) {
    if (typeof toggleBookmark === 'function') {
        // Since we don't have the full word info here, we pass empty strings. 
        // toggleBookmark only checks the slug to remove it.
        toggleBookmark(slug, '', '', '', ''); 
        renderFavorites();
    }
}
</script>
