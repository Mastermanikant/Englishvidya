# Cloudflare _headers file — EnglishVidya.com
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# ══ RULE 1: Global Security & No-Cache Defaults for Dynamic Routes ══
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://cdn.jsdelivr.net; script-src-elem 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self';
  Cache-Control: public, max-age=0, must-revalidate

# ══ RULE 2: Dynamic User Routes (Never Cache) ══
/profile/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/profile
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/login/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/login
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/my-diary/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/my-diary
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/api/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# ══ RULE 3: Static CSS & JS Assets ══
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/*
  Cache-Control: public, max-age=86400

# ══ RULE 4: Data & Sitemap ══
/data/*
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
